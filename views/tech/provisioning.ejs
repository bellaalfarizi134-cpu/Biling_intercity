<%- include('partials/header') %>

<style>
  /* Pencarian pelanggan: latar putih, teks gelap, tombol biru besar */
  .provision-job[hidden] { display:none!important; }
  .provision-profile-form { background:#f8fafc; border:1px solid #dbe5f2; border-radius:12px; padding:12px; }
  .provision-profile-form label { color:#475569; font-size:12px; }
  .provision-profile-form input, .provision-profile-form textarea { background:#fff!important; color:#111827!important; }
  .provision-action-row { display:flex; gap:8px; }
  .provision-action-row > * { flex:1; }
  .btn-cancel-job { color:#b91c1c!important; border-color:#fecaca!important; background:#fff!important; }
  .provision-detect-panel { background:#fff!important; color:#111827!important; border-color:#dbe5f2!important; }
  .provision-detect-panel .text-dark, .provision-detect-panel .fw-semibold { color:#111827!important; }
  .provision-detect-panel .text-secondary { color:#52637a!important; }
  .provision-detect-panel input { background:#fff!important; color:#111827!important; border-color:#cbd5e1!important; }
  .provision-detect-panel .js-discover-result { color:#1f2937; }
  .provision-detect-panel .js-discover-result button.active { background:#dbeafe!important; color:#174da0!important; border-color:#93baf3!important; }
  .provision-detect-panel .js-discover-onu, .js-provision-submit { background:#064db7!important; border-color:#064db7!important; color:#fff!important; font-weight:700; }
  .provision-detect-panel .js-discover-onu:hover, .js-provision-submit:hover { background:#043f98!important; border-color:#043f98!important; }
  .provision-detect-panel .js-discover-onu:disabled, .js-provision-submit:disabled { background:#94a3b8!important; border-color:#94a3b8!important; color:#fff!important; opacity:1; }

  .provision-live-modal[hidden]{display:none!important}
  .provision-live-modal.is-blocking{touch-action:none;user-select:none}
  .provision-live-modal.is-blocking .provision-live-card{pointer-events:auto}
  .provision-live-modal.is-blocking .js-close-provision-modal{display:none!important}
  .provision-live-modal{position:fixed;inset:0;z-index:2050;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(8,18,38,.72);backdrop-filter:blur(5px)}
  .provision-live-card{width:min(100%,390px);background:#fff;border-radius:24px;padding:26px 22px;text-align:center;box-shadow:0 24px 80px rgba(0,0,0,.3);color:#0f172a}
  .provision-orbit{width:104px;height:104px;border-radius:50%;margin:2px auto 18px;display:grid;place-items:center;position:relative;background:conic-gradient(from 0deg,#0d6efd 0 70%,#dbeafe 70% 100%);animation:provision-spin 1.25s linear infinite}
  .provision-orbit:before{content:"";position:absolute;inset:7px;border-radius:50%;background:#fff}
  .provision-orbit-core{position:relative;z-index:1;font-size:29px;color:#0755c9;animation:provision-spin 1.25s linear infinite reverse}
  .provision-live-label{display:inline-flex;align-items:center;gap:7px;border-radius:999px;background:#dbeafe;color:#174da0;padding:7px 13px;font-size:12px;font-weight:800;letter-spacing:1.3px;margin-bottom:10px}
  .provision-live-dot{width:7px;height:7px;border-radius:50%;background:#2563eb;animation:provision-pulse 1s ease-in-out infinite}
  .provision-live-card .js-progress-message{min-height:42px;line-height:1.45;color:#475569!important;overflow-wrap:anywhere}
  .provision-live-card .progress{height:9px;border-radius:99px;background:#e8eef7;overflow:hidden}
  .provision-live-card .progress-bar{border-radius:99px}
  @keyframes provision-spin{to{transform:rotate(360deg)}}
  @keyframes provision-pulse{50%{opacity:.25;transform:scale(.75)}}
  @media(prefers-reduced-motion:reduce){.provision-orbit,.provision-orbit-core,.provision-live-dot{animation-duration:3s}}
  @media(max-width:380px){.provision-search{gap:6px;padding:7px}.provision-search input{font-size:14px}.provision-search button{min-width:70px;padding:0 12px}}
</style>
<div class="d-flex flex-column flex-sm-row justify-content-end align-items-stretch align-items-sm-center gap-3 mb-3">
  <div class="d-grid d-sm-flex gap-2 flex-shrink-0">
    <a href="/tech/provisioning/import" class="btn btn-outline-success btn-sm rounded-3 text-nowrap"><i class="bi bi-person-lines-fill me-1"></i>Migrasi Pelanggan</a>
    <a href="/tech/customers/new" class="btn btn-outline-primary btn-sm rounded-3 text-nowrap"><i class="bi bi-person-plus me-1"></i>Tambah Pelanggan</a>
    <a href="/tech/provisioning/delete-sn" class="btn btn-outline-danger btn-sm rounded-3 text-nowrap"><i class="bi bi-trash3 me-1"></i>Hapus SN ONT</a>
  </div>
</div>

<% if (msg) { %>
  <div class="alert alert-<%= msg.type === 'error' ? 'danger' : 'success' %> rounded-4"><%= msg.text %></div>
<% } %>

<% if (!jobs || jobs.length === 0) { %>
  <div class="t-card text-center py-4">
    <i class="bi bi-inbox text-primary fs-2"></i>
    <div class="fw-bold mt-2">Tidak ada tugas aktivasi yang menunggu</div>
    <div class="text-secondary small mt-1">Tambahkan pelanggan baru atau pilih data pelanggan lama untuk memulai proses aktivasi.</div>
  </div>
<% } %>

<% (jobs || []).forEach(j => { %>
  <div class="t-card mb-3 provision-job" data-customer-id="<%= j.id %>" data-job-status="<%= j.job_status || '' %>" data-search="<%= [j.id,j.name,j.phone,j.pppoe_username,j.package_name,j.olt_name,j.odp_name,j.onu_sn].filter(Boolean).join(' ').toLowerCase() %>">
    <div class="d-flex justify-content-between gap-2 align-items-start">
      <div>
        <div class="fw-bold"><%= j.name %></div>
        <div class="text-secondary small"><i class="bi bi-telephone me-1"></i><%= j.phone || 'Nomor telepon belum diisi' %></div>
      </div>
      <span class="badge text-bg-<%= j.job_status === 'failed' ? 'danger' : (j.job_status === 'working' ? 'warning' : (j.job_status === 'bound_manual' ? 'warning' : (j.job_status === 'done' ? 'success' : 'secondary'))) %>"><%= j.job_status === 'failed' ? 'Gagal — perlu cek' : (j.job_status === 'working' ? 'Sedang diproses' : (j.job_status === 'bound_manual' ? 'Binding berhasil · PPPoE manual' : (j.job_status === 'done' ? 'Aktif' : 'Menunggu'))) %></span>
    </div>
    <div class="row g-2 small mt-2">
      <div class="col-6"><span class="text-secondary">ODP</span><div class="fw-semibold"><%= j.odp_name || '-' %></div></div>
      <div class="col-6"><span class="text-secondary">Paket</span><div class="fw-semibold"><%= j.package_name || '-' %></div></div>
      <div class="col-6"><span class="text-secondary">PPPoE</span><div class="fw-semibold"><%= j.pppoe_username || 'Belum diatur' %></div></div>
      <div class="col-6"><span class="text-secondary">OLT</span><div class="fw-semibold"><%= j.olt_name || 'Belum dipilih' %></div></div>
    </div>
    <% if (j.last_message) { %><div class="small mt-2 text-secondary js-provision-job-message" data-job-status="<%= j.job_status || '' %>"><%= j.last_message %></div><% } %>
    <button type="button" class="btn btn-outline-info btn-sm w-100 mt-2 js-diagnose-wan" data-customer-id="<%= j.id %>"><i class="bi bi-activity me-1"></i>Periksa Akun PPPoE</button>
    <div class="small mt-2 js-wan-diagnosis" role="status" aria-live="polite" hidden></div>
    <details class="mt-3">
      <summary class="btn btn-outline-primary btn-sm rounded-3"><i class="bi bi-geo-alt-fill me-1"></i>Edit ODP &amp; Titik Pelanggan</summary>
      <form method="POST" action="/tech/provisioning/<%= j.id %>/odp" class="provision-profile-form mt-2">
        <label class="form-label">OLT <span class="text-danger">*</span></label>
        <select name="olt_id" class="form-select form-select-sm mb-2 js-customer-olt" required>
          <option value="">Pilih OLT</option>
          <% (olts || []).forEach(o => { %><option value="<%= o.id %>" <%= Number(j.olt_id) === Number(o.id) ? 'selected' : '' %>><%= o.name %></option><% }) %>
        </select>
        <label class="form-label">ODP <span class="text-danger">*</span></label>
        <select name="odp_id" class="form-select form-select-sm mb-2 js-customer-odp" required>
          <option value="">Pilih ODP</option>
          <% (odps || []).forEach(o => { %><option value="<%= o.id %>" data-olt-id="<%= o.olt_id || '' %>" data-lat="<%= o.lat == null ? '' : o.lat %>" data-lng="<%= o.lng == null ? '' : o.lng %>" data-base-label="<%= o.name %>" <%= Number(j.odp_id) === Number(o.id) ? 'selected' : '' %>><%= o.name %></option><% }) %>
        </select>
        <div class="form-text js-customer-odp-distance mb-2" role="status" aria-live="polite">Jarak pelanggan ke ODP maksimal 200 meter. Jika lebih jauh, pilih ODP lain yang lebih dekat.</div>
        <label class="form-label">Port pelanggan pada ODP <span class="text-danger">*</span></label>
        <input name="pon_port" type="number" inputmode="numeric" min="1" max="128" class="form-control form-control-sm mb-2" required value="<%= j.pon_port || '' %>" placeholder="Nomor port 1–128">
        <label class="form-label">Latitude titik pelanggan</label>
        <input name="lat" type="number" step="any" min="-90" max="90" class="form-control form-control-sm mb-2" value="<%= j.lat || '' %>" placeholder="Contoh: -8.0885">
        <label class="form-label">Longitude titik pelanggan</label>
        <input name="lng" type="number" step="any" min="-180" max="180" class="form-control form-control-sm mb-2" value="<%= j.lng || '' %>" placeholder="Contoh: 112.2893">
        <button type="button" class="btn btn-outline-primary btn-sm w-100 mb-2 js-get-customer-point"><i class="bi bi-crosshair me-1"></i>Ambil Lokasi GPS</button>
        <button type="submit" class="btn btn-primary btn-sm w-100" onclick="return confirm('Simpan OLT, ODP, port, dan titik pelanggan?')">Simpan Data Jaringan</button>
      </form>
    </details>
    <hr>
    <form method="POST" action="/tech/provisioning/<%= j.id %>" class="js-auto-activation-form">
      <input type="hidden" name="pon" value="<%= j.pon_id || '' %>">
      <input type="hidden" name="onu_id" value="<%= j.onu_id || '' %>">
      <input type="hidden" name="line_profile" value="1">
      <input type="hidden" name="srv_profile" value="0">
      <div class="rounded-4 border p-3 bg-white text-dark provision-detect-panel">
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="bi bi-magic text-success fs-5"></i>
          <div class="fw-semibold text-dark">Aktivasi Otomatis dari SN</div>
        </div>
        <label class="form-label small text-secondary mt-3 mb-1">Pilih OLT untuk pemindaian</label>
        <select name="scan_olt_id" class="form-select rounded-3 mb-2 js-scan-olt" required>
          <option value="">Pilih OLT HSGQ</option>
          <% (olts || []).filter(o => String(o.brand || '').toUpperCase() === 'HSGQ' && Number(o.is_active) === 1).forEach(o => { %>
            <option value="<%= o.id %>" <%= Number(j.olt_id) === Number(o.id) ? 'selected' : '' %>><%= o.name %> — <%= o.host %></option>
          <% }) %>
        </select>
        <label class="form-label small text-secondary mt-3 mb-1" for="provisionVendor-<%= j.id %>">Vendor ONT</label>
        <select id="provisionVendor-<%= j.id %>" name="onu_vendor" class="form-select rounded-3 mb-2 js-provision-vendor" required>
          <option value="">Pilih vendor ONT</option>
          <option value="FIBERHOME">FiberHome</option>
          <option value="ZTE">ZTE</option>
          <option value="HUAWEI">Huawei</option>
          <option value="NOKIA">Nokia / Alcatel</option>
          <option value="CMHI">CMHI</option>
          <option value="ZXIC">ZXIC</option>
          <option value="ZIONCOM">ZIONCOM / TOTOLINK</option>
          <option value="RTEG">RTEG</option>
          <option value="ZICG">ZICG</option>
          <option value="CMDC">CMDC</option>
          <option value="OTHER">Lainnya</option>
        </select>
        <label class="form-label small text-secondary mb-1" for="provisionSn-<%= j.id %>">Nomor seri ONT (SN)</label>
        <input id="provisionSn-<%= j.id %>" name="onu_sn" required maxlength="16" minlength="12" pattern="[A-Za-z0-9-]{12,16}" autocomplete="off" autocapitalize="characters" spellcheck="false" class="form-control rounded-3 text-uppercase fw-semibold" value="" placeholder="Masukkan SN atau pilih hasil pencarian">
        <button type="button" class="btn btn-primary w-100 rounded-3 mt-2 js-discover-onu" <%= j.job_status === 'bound_manual' ? 'disabled' : '' %>><i class="bi bi-search me-2"></i>Baca SN dari OLT</button>
        <select class="form-select rounded-3 mt-2 js-discovered-sn" aria-label="SN ONT yang terdeteksi di OLT" hidden><option value="">Pilih SN yang terdeteksi…</option></select>
        <div class="small text-secondary mt-2 js-sn-help">Pilih vendor dan baca SN dari OLT.</div>
        <div class="small text-secondary mt-1 js-auto-location" role="status" aria-live="polite">SN dan nomor ONU akan diperiksa dari OLT sebelum aktivasi.</div>
        <div class="small mt-2 js-discover-result" role="status" aria-live="polite"></div>
        <div class="mt-3 p-3 rounded-3 border js-provision-progress" role="status" aria-live="polite" hidden>
          <div class="d-flex align-items-center gap-2 fw-semibold js-progress-heading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Proses aktivasi sedang berjalan</div>
          <div class="small text-secondary mt-2 js-progress-message">Menyiapkan proses...</div>
          <div class="progress mt-2" style="height:8px"><div class="progress-bar progress-bar-striped progress-bar-animated js-progress-bar" role="progressbar" style="width:2%" aria-valuenow="2" aria-valuemin="0" aria-valuemax="100"></div></div>
          <div class="d-flex justify-content-between small text-secondary mt-2"><span>Waktu berjalan</span><strong class="js-progress-elapsed">00:00</strong></div>
          <div class="small text-secondary mt-2">Proses binding dapat berlangsung hingga 10 menit. Jika PPPoE otomatis gagal, konfigurasi PPPoE dapat dilanjutkan secara manual tanpa mengulang binding.</div>
        </div>
      </div>
      <% if (j.job_status === 'bound_manual') { %>
        <button type="button" class="btn btn-warning w-100 rounded-3 mt-3" disabled><i class="bi bi-check-circle me-2"></i>Binding selesai</button>
        <div class="small text-secondary mt-2">Binding selesai, tetapi koneksi PPPoE belum aktif. Periksa konfigurasi PPPoE pada ONT. Menutup tugas ini tidak menghapus data pelanggan atau binding OLT.</div>
        <button type="submit" formmethod="POST" formaction="/tech/provisioning/<%= j.id %>/ack-manual" class="btn btn-success w-100 rounded-3 mt-2" onclick="return confirm('Binding ONU sudah selesai, tetapi PPPoE belum aktif. Hapus tugas ini dan lanjutkan konfigurasi PPPoE pada ONT? Data pelanggan dan binding OLT tidak dihapus.');"><i class="bi bi-check-circle me-2"></i>Tutup Tugas</button>
      <% } else { %>
        <button type="submit" class="btn btn-primary w-100 rounded-3 mt-3 js-provision-submit" data-location-ready="<%= (j.olt_id && j.odp_id && j.pon_port) ? '1' : '0' %>" <%= (j.olt_id && j.odp_id && j.pon_port && j.onu_sn) ? '' : 'disabled' %>><i class="bi bi-lightning-charge me-2"></i>Proses Aktivasi</button>
      <% } %>
    </form>
    <form method="POST" action="/tech/provisioning/<%= j.id %>/cancel" class="mt-2" onsubmit="return confirm('Batalkan tugas ini? Data pelanggan tidak akan dihapus.');">
      <button type="submit" class="btn btn-outline-danger btn-cancel-job w-100 rounded-3"><i class="bi bi-x-circle me-1"></i>Tidak Jadi / Batalkan Tugas</button>
    </form>
  </div>
<% }) %>


<div class="provision-live-modal" id="provisionLiveModal" role="dialog" aria-modal="true" aria-labelledby="provisionLiveTitle" aria-describedby="provisionLiveMessage" hidden>
  <div class="provision-live-card">
    <div class="provision-orbit" aria-hidden="true"><div class="provision-orbit-core"><i class="bi bi-link-45deg"></i></div></div>
    <div class="provision-live-label"><span class="provision-live-dot"></span><span class="js-progress-heading" id="provisionLiveTitle">PROSES AKTIVASI</span></div>
    <h5 class="fw-bold mb-2">Mohon tunggu hingga proses selesai.</h5>
    <div class="js-progress-message small mb-3" id="provisionLiveMessage">Menghubungkan SN ONU ke OLT...</div>
    <div class="progress mb-2"><div class="progress-bar progress-bar-striped progress-bar-animated js-progress-bar" role="progressbar" style="width:3%" aria-valuenow="3" aria-valuemin="0" aria-valuemax="100"></div></div>
    <div class="d-flex justify-content-between align-items-center small text-secondary mt-3"><span><i class="bi bi-clock me-1"></i>Waktu berjalan</span><strong class="js-progress-elapsed fs-6">00:00</strong></div>
    <div class="small text-secondary mt-3">Proses dapat berlangsung hingga 10 menit. Jika PPPoE otomatis gagal, lanjutkan konfigurasi secara manual tanpa mengulang binding.</div>
    <button type="button" class="btn btn-outline-secondary btn-sm mt-3 js-close-provision-modal" hidden>Tutup</button>
  </div>
</div>

<script>
(function () {
  function simpleProvisionMessage(raw, status) {
    const message = String(raw || '').trim();
    const state = String(status || '').toLowerCase();
    if (state === 'done' || /^DONE:|ONU BINDING \+ INTERNET AKTIF/i.test(message)) {
      return 'ONT terdaftar dan koneksi internet sudah aktif.';
    }
    if (/pemeriksaan firmware otomatis belum berhasil|firmware.*upgrade berjalan|upgrade gagal|upgrade dibatalkan|upgrade melebihi .*menit|firmware.*dijadwalkan ulang|menunggu upgrade firmware|hasil perintah upgrade belum dapat dipastikan|WAN ditahan karena proses firmware gagal/i.test(message)) {
      return 'ONT sudah terdaftar, tetapi pemeriksaan atau pembaruan firmware belum selesai. Jangan ulangi binding; hubungi admin jaringan.';
    }
    if (state === 'bound_manual' || /WAN_MANUAL|WAN_OLT_MANUAL|PPPoE\/INTERNET GAGAL|WAN belum aktif/i.test(message)) {
      return 'ONT sudah terdaftar, tetapi internet belum aktif. Jangan ulangi binding. Periksa akun PPPoE dan konfigurasi WAN pada ONT/OLT.';
    }
    if (/SN tidak ditemukan|GAGAL BINDING|autofind OLT|ONT belum terdeteksi/i.test(message)) {
      return 'ONT belum terdeteksi di OLT. Pastikan SN sesuai label, ONT menyala, dan kabel fiber terpasang.';
    }
    if (/pra-validasi WAN gagal|WAN_OLT_UNSUPPORTED|aktivasi otomatis.*belum didukung|vendor.*belum didukung/i.test(message)) {
      return 'Aktivasi otomatis untuk ONT ini belum didukung oleh OLT yang dipilih. ONT belum diubah. Hubungi admin jaringan.';
    }
    if (/data WAN belum lengkap|router MikroTik aktif|username PPPoE|password PPPoE|paket billing.*belum dipilih|profile secret|rate-limit profile/i.test(message)) {
      return 'Data layanan belum lengkap. Periksa router MikroTik, paket layanan, username PPPoE, dan password PPPoE pada data pelanggan.';
    }
    if (/serial number ONU tidak valid|SN ONU harus|nomor seri.*tidak valid/i.test(message)) {
      return 'Periksa kembali SN pada label ONT dan pilih atau masukkan nomor seri yang benar.';
    }
    if (/HTTP \d+|respons awal bukan JSON|respons status bukan JSON|gagal membaca status aktivasi|server menolak permintaan/i.test(message)) {
      return 'Koneksi ke server terputus saat memeriksa proses. Muat ulang halaman untuk melihat status terakhir. Jangan ulangi binding jika ONT sudah terdaftar.';
    }
    if (/firmware.{0,100}(gagal|belum selesai|dijadwalkan otomatis|sedang diperbarui|menunggu upgrade|pending|failed)|(gagal|belum selesai|dijadwalkan otomatis|sedang diperbarui|menunggu upgrade|pending|failed).{0,100}firmware/i.test(message)) {
      return 'ONT sudah terdaftar, tetapi pemeriksaan atau pembaruan firmware belum selesai. Jangan ulangi binding; hubungi admin jaringan.';
    }
    if (/TAHAP 1\/2|PROSES BINDING|mencari SN ONU|SN cocok/i.test(message)) {
      return 'Sedang mendaftarkan ONT ke OLT. Pastikan ONT menyala dan kabel fiber terpasang.';
    }
    if (/TAHAP 2\/2|WAN_PENDING|WAN\/PPPoE|PPPoE belum|ACS|internet belum aktif/i.test(message)) {
      return 'ONT sudah terdaftar. Sistem sedang menyiapkan PPPoE dan memeriksa koneksi internet.';
    }
    if (/Sesi teknisi|login kembali|TECH_SESSION_EXPIRED/i.test(message)) {
      return 'Sesi teknisi telah berakhir. Login kembali sebelum melanjutkan.';
    }
    if (/SNMP|Telnet|running-config|OID ONU|timeout|koneksi ke OLT/i.test(message)) {
      return 'Status OLT belum dapat dipastikan. Periksa koneksi OLT atau hubungi admin jaringan.';
    }
    if (state === 'failed') {
      return 'Aktivasi belum berhasil. Periksa SN, daya ONT, konektor fiber, dan koneksi OLT. Jika ONT sudah terdaftar, jangan ulangi binding sebelum status OLT diperiksa.';
    }
    return message.length > 230
      ? 'Proses belum selesai. Periksa status ONT dan koneksi internet, lalu hubungi admin jaringan jika perlu.'
      : message;
  }
  document.querySelectorAll('.js-provision-job-message').forEach(function (element) {
    element.textContent = simpleProvisionMessage(element.textContent, element.dataset.jobStatus);
  });
  // Popup proses hanya boleh ditutup setelah proses selesai/gagal atau pemeriksaan terputus.
  document.querySelectorAll('.js-close-provision-modal').forEach(function (button) { button.addEventListener('click', function () { const modal = document.getElementById('provisionLiveModal'); if (modal && button.hidden === false) { modal.hidden = true; modal.classList.remove('is-blocking'); document.body.style.overflow = ''; } }); });
  document.addEventListener('keydown', function (event) { const modal = document.getElementById('provisionLiveModal'); if (modal && !modal.hidden && modal.classList.contains('is-blocking') && (event.key === 'Escape' || event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); event.stopImmediatePropagation(); } }, true);
  document.addEventListener('click', function (event) { const modal = document.getElementById('provisionLiveModal'); if (modal && !modal.hidden && modal.classList.contains('is-blocking') && !modal.contains(event.target)) { event.preventDefault(); event.stopImmediatePropagation(); } }, true);

  document.querySelectorAll('.js-diagnose-wan').forEach(function (button) {
    button.addEventListener('click', async function () {
      const customerId = button.dataset.customerId;
      const card = button.closest('.provision-job');
      const output = card && card.querySelector('.js-wan-diagnosis');
      if (!output) return;
      button.disabled = true;
      output.hidden = false;
      output.textContent = 'Memeriksa data Billing dan membaca status PPPoE langsung dari MikroTik...';
      try {
