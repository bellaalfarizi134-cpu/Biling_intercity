                        <span class="cp-chip cp-chip-active"><i class="bi bi-check-circle-fill"></i> Aktif</span>
                      <% } else { %>
                        <span class="cp-chip cp-chip-suspended"><i class="bi bi-x-circle-fill"></i> Nonaktif</span>
                      <% } %>
                    </td>
                    <td><span style="font-size:11.5px;font-family:monospace;color:#334155;font-weight:700;"><%= o.virtual_position ? 'Otomatis / belum diset' : (Number(o.lat).toFixed(6) + ', ' + Number(o.lng).toFixed(6)) %></span></td>
                    <td>
                      <div style="display:flex;gap:4px;justify-content:flex-end;">
                        <button type="button" class="btn btn-sm btn-p" data-olt-id="<%= Number(o.id) %>" onclick="editOltLocationFromBtn(this)" title="Edit Titik Lokasi"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="btn btn-sm btn-g" data-olt-id="<%= Number(o.id) %>" onclick="focusOltFromBtn(this)" title="Fokus Peta"><i class="bi bi-geo-alt"></i></button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6" style="padding:16px;text-align:center;color:#64748b;">Belum ada data OLT.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

