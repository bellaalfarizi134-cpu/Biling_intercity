  body.tech-dashboard .isp-ai-float:active { transform:scale(.96); }
  body.tech-dashboard .isp-tech-identity { width:100%; text-align:left; appearance:none; border:0; cursor:pointer; display:flex; align-items:center; gap:11px; padding:7px 3px 15px; background:transparent; color:inherit; }
  body.tech-dashboard .isp-tech-identity:focus-visible { outline:2px solid #2563eb; outline-offset:3px; border-radius:12px; }
  body.tech-dashboard .tech-profile-modal { color:#1e293b; border:0; border-radius:18px; overflow:hidden; }
  body.tech-dashboard .tech-profile-modal .modal-header { background:#f4f8ff; border-bottom:1px solid #e2eaf5; }
  body.tech-dashboard .tech-profile-modal .modal-title { font-size:17px; font-weight:800; color:#17488f; }
  body.tech-dashboard .tech-profile-hero { display:flex; flex-direction:column; align-items:center; gap:7px; padding:10px 0 18px; }
  body.tech-dashboard .tech-profile-hero .isp-tech-avatar { width:64px; height:64px; flex-basis:64px; font-size:27px; }
  body.tech-dashboard .tech-profile-hero strong { font-size:18px; color:#1b2f4e; }
  body.tech-dashboard .tech-profile-hero small { color:#718096; }
  body.tech-dashboard .tech-profile-row { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:11px 0; border-top:1px solid #edf1f7; font-size:13px; }
