                  <% if (p.description) { %>
                    <li style="border:none;"><i class="bi bi-info-circle-fill text-info"></i> <%= p.description %></li>
                  <% } %>
                </ul>

                <% const packageIsFull = /kuota\s*(?:pemasangan\s*)?(?:habis|penuh)|\bfull\b/i.test(String(p.name||'')+' '+String(p.description||'')); %>
                <% if (!packageIsFull) { %>
                <button type="button" class="btn-pkg-action pkg-select-btn"
                  data-bs-toggle="modal" data-bs-target="#packageDetailModal"
                  data-name="<%= p.name %>"
                  data-speed="<%= Number(p.speed_down||0) > 0 ? ((Math.round(Number(p.speed_down||0)/1000) >= 1) ? Math.round(Number(p.speed_down||0)/1000) + ' Mbps' : Number(p.speed_down||0) + ' Kbps') : 'High-Speed' %>"
                  data-price="Rp <%= Number(p.price||0).toLocaleString('id-ID') %>"
                  data-description="<%= String(p.description || '').replace(/&/g,'&amp;').replace(/\"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') %>"
                  data-full="0"
                  data-url="/customer/register?package=<%= encodeURIComponent(p.name) %>">
                  <i class="bi bi-cart-plus me-1"></i> Pilih Paket Ini
                </button>
                <% } else { %>
