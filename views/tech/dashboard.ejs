  body.tech-dashboard .isp-section-heading > span { display:grid; place-items:center; width:36px; height:36px; color:#1654b2; background:#e7f0ff; border-radius:11px; }
  body.tech-dashboard .isp-service-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:11px; }
  body.tech-dashboard .isp-service-card { position:relative; display:flex; flex-direction:column; align-items:flex-start; min-width:0; min-height:135px; padding:14px 12px 13px; gap:7px; border:1px solid #e5ebf4; border-radius:15px; background:#fff; box-shadow:0 5px 15px rgba(25,57,98,.045); text-decoration:none; color:#203754; transition:transform .15s ease,box-shadow .15s ease; }
  body.tech-dashboard .isp-service-card:active { transform:scale(.985); }
  body.tech-dashboard .isp-service-card.featured { background:linear-gradient(145deg,#0752b9,#063d91); border-color:#0752b9; color:#fff; }
  body.tech-dashboard .isp-service-icon { display:grid; place-items:center; width:39px; height:39px; border-radius:12px; background:#eaf2ff; color:#1455b4; font-size:20px; }
  body.tech-dashboard .isp-service-card.featured .isp-service-icon { color:#fff; background:rgba(255,255,255,.16); }
  body.tech-dashboard .isp-service-card strong { font-size:13px; font-weight:800; line-height:1.25; padding-right:12px; }
  body.tech-dashboard .isp-service-card small { font-size:10px; line-height:1.45; color:#7b899d; }
  body.tech-dashboard .isp-service-card.featured small { color:#d6e7ff; }
  body.tech-dashboard .isp-card-arrow { position:absolute; top:15px; right:12px; font-size:13px; color:#9ba9bb; }
  body.tech-dashboard .isp-service-card.featured .isp-card-arrow { color:#d8e8ff; }
  body.tech-dashboard .bottom-nav { display:flex !important; height:calc(70px + env(safe-area-inset-bottom)); background:rgba(255,255,255,.97); border-top:1px solid #e3eaf4; box-shadow:0 -5px 20px rgba(24,54,94,.06); padding:0 5px env(safe-area-inset-bottom); justify-content:space-around; overflow:visible; }
  body.tech-dashboard .nav-item { flex:1 1 0; min-width:0; color:#9aa6b7; font-size:10px; font-weight:650; gap:2px; }
  body.tech-dashboard .nav-item i { font-size:21px; margin:0; }
  body.tech-dashboard .nav-item.active { color:#0b4eae; position:relative; }
  body.tech-dashboard .nav-item.active::before { content:""; position:absolute; top:0; left:20%; right:20%; height:3px; border-radius:0 0 5px 5px; background:#0b4eae; }
