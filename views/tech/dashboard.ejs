  body.tech-dashboard .isp-work-stat { display:flex; align-items:center; gap:11px; padding:10px 2px; min-width:0; }
  body.tech-dashboard .isp-work-stat + .isp-work-stat { border-top:1px solid #edf1f7; }
  body.tech-dashboard .isp-stat-icon { width:39px; height:39px; flex:0 0 39px; display:grid; place-items:center; border-radius:12px; font-size:18px; }
  body.tech-dashboard .isp-stat-icon.new { background:#eaf2ff; color:#1456b7; }
  body.tech-dashboard .isp-stat-icon.progress { background:#fff4d9; color:#a96900; }
  body.tech-dashboard .isp-stat-icon.done { background:#e4f8ee; color:#0b8b5c; }
