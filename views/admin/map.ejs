  // ─── MANUAL BACKBONE CABLE EDITOR ────────────────────────────────────────
  let backboneCableMap = null;
  let backboneCablePolyline = null;
  let backboneCableMarkers = [];
  let backboneCableEditingId = null;

  function backboneSegmentConfig(type) {
    const configs = {
      'odp-odc': { sourceType:'odp', targetType:'odc', sourceLabel:'ODP', targetLabel:'ODC', sourceItems:odps, targetItems:odcs },
      'odc-olt': { sourceType:'odc', targetType:'olt', sourceLabel:'ODC', targetLabel:'OLT', sourceItems:odcs, targetItems:olts },
      'olt-router': { sourceType:'olt', targetType:'router', sourceLabel:'OLT', targetLabel:'MikroTik', sourceItems:olts, targetItems:routers }
    };
    return configs[type] || configs['odp-odc'];
  }

  function backboneEndpointCoord(type, id) {
    if (type === 'odp') return odpMap[id] ? odpMap[id].coord : null;
    if (type === 'odc') return topologyMap.odc[id] ? topologyMap.odc[id].coord : null;
    if (type === 'olt') return topologyMap.olt[id] ? topologyMap.olt[id].coord : null;
    if (type === 'router') return topologyMap.router[id] ? topologyMap.router[id].coord : null;
    return null;
  }

  function refreshBackboneEndpointOptions(preferredSource, preferredTarget) {
    const config = backboneSegmentConfig(document.getElementById('backboneSegmentType').value);
    const source = document.getElementById('backboneSourceId');
    const target = document.getElementById('backboneTargetId');
    const sourceLabel = document.getElementById('backboneSourceLabel');
    const targetLabel = document.getElementById('backboneTargetLabel');
    if (!source || !target) return;
    sourceLabel.textContent = config.sourceLabel;
    targetLabel.textContent = config.targetLabel;
    const renderItem = (item, type) => {
      const name = item.name || (type.toUpperCase() + ' #' + item.id);
      const detail = type === 'router' || type === 'olt' ? (item.host || '') : (item.code || '');
      return '<option value="' + Number(item.id) + '">' + escapeHtml(name) + (detail ? ' — ' + escapeHtml(detail) : '') + '</option>';
    };
    source.innerHTML = config.sourceItems.map(item => renderItem(item, config.sourceType)).join('');
    target.innerHTML = config.targetItems.map(item => renderItem(item, config.targetType)).join('');
    if (preferredSource != null && Array.from(source.options).some(o => Number(o.value) === Number(preferredSource))) source.value = String(preferredSource);
    if (preferredTarget != null && Array.from(target.options).some(o => Number(o.value) === Number(preferredTarget))) target.value = String(preferredTarget);
  }

  function addBackboneMorePoints() {
    if (!backboneCablePolyline || !backboneCableMap) return alert('Jalur belum siap. Pilih pasangan perangkat terlebih dahulu.');
    const latlngs = backboneCablePolyline.getLatLngs();
    const next = [];
    for (let i = 0; i < latlngs.length - 1; i++) {
      next.push(latlngs[i]);
      next.push(L.latLng((latlngs[i].lat + latlngs[i + 1].lat) / 2, (latlngs[i].lng + latlngs[i + 1].lng) / 2));
    }
    next.push(latlngs[latlngs.length - 1]);
    setBackboneCablePoints(next.map(p => [p.lat, p.lng]));
  }

  function refreshBackboneCablePreview() {
    if (!backboneCableMap) return;
    const type = document.getElementById('backboneSegmentType').value;
    const config = backboneSegmentConfig(type);
    const srcType = config.sourceType;
    const dstType = config.targetType;
    const a = backboneEndpointCoord(srcType, Number(document.getElementById('backboneSourceId').value));
    const b = backboneEndpointCoord(dstType, Number(document.getElementById('backboneTargetId').value));
    if (!a || !b) return;
    setBackboneCablePoints([a, b]);
    backboneCableMap.fitBounds(L.latLngBounds([a, b]), { padding:[30,30] });
    setTimeout(() => backboneCableMap.invalidateSize(), 100);
  }

  function clearBackboneCablePoints() {
    backboneCableMarkers.forEach(m => backboneCableMap && backboneCableMap.removeLayer(m));
    backboneCableMarkers = [];
    if (backboneCablePolyline && backboneCableMap) backboneCableMap.removeLayer(backboneCablePolyline);
    backboneCablePolyline = null;
    const config = backboneSegmentConfig(document.getElementById('backboneSegmentType').value);
    const a = backboneEndpointCoord(config.sourceType, Number(document.getElementById('backboneSourceId').value));
    const b = backboneEndpointCoord(config.targetType, Number(document.getElementById('backboneTargetId').value));
    if (a && b) setBackboneCablePoints([a, b]);
  }

  function setBackboneCablePoints(points) {
    if (!backboneCableMap) return;
    backboneCableMarkers.forEach(m => backboneCableMap.removeLayer(m));
    backboneCableMarkers = [];
    if (backboneCablePolyline) backboneCableMap.removeLayer(backboneCablePolyline);
    const normalized = points.map(p => [Number(p[0]), Number(p[1])]);
    backboneCablePolyline = L.polyline(normalized, { color:'#f97316', weight:5, opacity:.9 }).addTo(backboneCableMap);
    normalized.forEach((p, idx) => {
      const marker = L.marker(p, { draggable: true, icon: L.divIcon({ className:'', html:'<div style="width:16px;height:16px;border-radius:50%;background:#f97316;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.35);"></div>', iconSize:[16,16], iconAnchor:[8,8] }) }).addTo(backboneCableMap);
      marker.on('drag', () => updateBackbonePolylineFromMarkers());
      backboneCableMarkers.push(marker);
    });
  }

  function updateBackbonePolylineFromMarkers() {
    if (!backboneCablePolyline) return;
    backboneCablePolyline.setLatLngs(backboneCableMarkers.map(m => m.getLatLng()));
  }

  function openBackboneCableEditor(segmentType, sourceId, targetId) {
    // Buka modal terlebih dahulu supaya error data/perangkat tidak membuat tombol terasa tidak bereaksi.
    const modal = document.getElementById('backboneCableModal');
    if (!modal) { alert('Editor kabel tidak ditemukan. Silakan refresh halaman.'); return; }
    openModal('backboneCableModal');
    const type = segmentType || 'odp-odc';
    try {
      document.getElementById('backboneSegmentType').value = type;
      refreshBackboneEndpointOptions(sourceId, targetId);
    } catch (e) {
      console.error('[MAP] gagal menyiapkan pilihan kabel:', e);
      document.getElementById('backboneCableExisting').textContent = 'Daftar perangkat gagal dimuat: ' + e.message;
      return;
    }
    const src = Number(document.getElementById('backboneSourceId').value);
    const dst = Number(document.getElementById('backboneTargetId').value);
    const existing = manualCablePaths.find(p => p.segment_type === type && Number(p.source_id) === src && Number(p.target_id) === dst);
    backboneCableEditingId = existing ? Number(existing.id) : null;
    document.getElementById('backboneCableStatus').value = existing ? (existing.status || 'unknown') : 'unknown';
    document.getElementById('backboneCableNotes').value = existing ? (existing.notes || '') : '';
    document.getElementById('backboneCableDeleteBtn').style.display = existing ? '' : 'none';
    document.getElementById('backboneCableExisting').innerHTML = existing ? '<i class="bi bi-check-circle-fill" style="color:#16a34a"></i> Jalur manual tersimpan. Anda dapat menggambar ulang jalurnya.' : '<i class="bi bi-info-circle"></i> Belum ada jalur manual. Garis oranye dari titik awal ke titik akhir akan langsung muncul.';
    openModal('backboneCableModal');
    setTimeout(() => {
      const config = backboneSegmentConfig(type);
      const sourceType = config.sourceType;
      const targetType = config.targetType;
      const a = backboneEndpointCoord(sourceType, src);
      const b = backboneEndpointCoord(targetType, dst);
      const existingPath = existing ? (() => { try { return JSON.parse(existing.path_json || '[]'); } catch(e) { return []; } })() : [];
        if (!backboneCableMap) {
        const center = a || b || [officeCoords.lat, officeCoords.lng];
        backboneCableMap = L.map('backbone-cable-map', { zoomControl: true }).setView(center, 17);
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', { maxZoom:20, subdomains:['mt0','mt1','mt2','mt3'] }).addTo(backboneCableMap);
        backboneCableMap.on('click', e => {
          const pts = backboneCableMarkers.map(m => m.getLatLng());
          if (pts.length < 2) pts.push(e.latlng);
          else {
            let bestIndex = 1, bestDistance = Infinity;
            for (let i = 0; i < pts.length - 1; i++) {
              const midLat = (Number(pts[i][0]) + Number(pts[i + 1][0])) / 2;
              const midLng = (Number(pts[i][1]) + Number(pts[i + 1][1])) / 2;
              const d = Math.pow(Number(e.latlng.lat) - midLat, 2) + Math.pow(Number(e.latlng.lng) - midLng, 2);
              if (d < bestDistance) { bestDistance = d; bestIndex = i + 1; }
            }
            pts.splice(bestIndex, 0, e.latlng);
          }
          setBackboneCablePoints(pts);
        });
      }
      const points = existingPath.length >= 2 ? existingPath : (a && b ? [a,b] : []);
      if (points.length >= 2) setBackboneCablePoints(points);
      if (a && b) {
        const bounds = L.latLngBounds([a,b]);
        if (existingPath.length >= 2) existingPath.forEach(p => bounds.extend(p));
        backboneCableMap.fitBounds(bounds, { padding:[30,30] });
      }
      setTimeout(() => backboneCableMap.invalidateSize(), 250);
    }, 120);
  }

  async function saveBackboneCable() {
    const type = document.getElementById('backboneSegmentType').value;
    const sourceId = Number(document.getElementById('backboneSourceId').value);
    const targetId = Number(document.getElementById('backboneTargetId').value);
    const path = backboneCableMarkers.map(m => { const p = m.getLatLng(); return [p.lat, p.lng]; });
    if (!sourceId || !targetId || path.length < 2) return alert('Pilih pasangan perangkat dan buat minimal 2 titik jalur.');
    const res = await fetch('/admin/api/network-cable-paths', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ segment_type:type, source_id:sourceId, target_id:targetId, path, status:document.getElementById('backboneCableStatus').value, notes:document.getElementById('backboneCableNotes').value }) });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) return alert(data.error || 'Gagal menyimpan jalur kabel.');
    location.reload();
  }

  async function deleteBackboneCable() {
    if (!backboneCableEditingId || !confirm('Hapus jalur kabel manual ini? Garis otomatis akan digunakan kembali.')) return;
    const res = await fetch('/admin/api/network-cable-paths/' + backboneCableEditingId, { method:'DELETE' });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) return alert(data.error || 'Gagal menghapus jalur kabel.');
    location.reload();
  }

  // ─── CABLE DRAWING & MODALS ────────────────────────────────────────────────
  let drawingMap, drawingPolyline, drawingMarkers = [];
  
  function interpolatePoints(p1, p2, count) {
    const points = [p1];
    for (let i = 1; i <= count; i++) {
      const lat = p1[0] + (p2[0] - p1[0]) * (i / (count + 1));
      const lng = p1[1] + (p2[1] - p1[1]) * (i / (count + 1));
      points.push([lat, lng]);
    }
    points.push(p2);
    return points;
  }

  function renderEditorMarkers() {
    drawingMarkers.forEach(m => drawingMap.removeLayer(m));
    drawingMarkers = [];

    const latlngs = drawingPolyline.getLatLngs();
    latlngs.forEach((ll, index) => {
      const isEdge = index === 0 || index === latlngs.length - 1;
      const marker = L.marker(ll, {
        draggable: true,
        zIndexOffset: 2000,
        icon: L.divIcon({
          html: `<div style="background: ${isEdge ? '#3b82f6' : '#ef4444'}; width: 16px; height: 16px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 5px rgba(0,0,0,0.5);"></div>`,
          className: 'custom-div-icon',
          iconSize: [16, 16],
          iconAnchor: [8, 8]
        })
      }).addTo(drawingMap);

      marker.on('drag', (e) => {
        const newLatLngs = drawingPolyline.getLatLngs();
        newLatLngs[index] = e.latlng;
        drawingPolyline.setLatLngs(newLatLngs);
      });

      drawingMarkers.push(marker);
    });
  }

  function startCableDrawing(customerId, lat, lng, odpId) {
    const odp = odpMap[odpId];
    if (!odp) return alert('Data ODP tidak ditemukan atau belum dipilih');

    currentEditingCustomer = customerId;
    openModal('cablePathModal');

    setTimeout(() => {
      try {
        if (drawingMap) drawingMap.remove();
        
        drawingMap = L.map('cable-drawing-map').setView([lat, lng], 17);
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
        }).addTo(drawingMap);

        const customer = customers.find(c => c.id === customerId);
        let pathCoords = [];
        if (customer && customer.cable_path) {
          try { pathCoords = JSON.parse(customer.cable_path); } catch(e) {}
        }
        
        if (pathCoords.length <= 2) {
          pathCoords = interpolatePoints([parseFloat(lat), parseFloat(lng)], odp.coord, 5);
        }

        drawingPolyline = L.polyline(pathCoords, {
          color: '#f59e0b', weight: 6, dashArray: '5, 5', interactive: false
        }).addTo(drawingMap);

        renderEditorMarkers();

        setTimeout(() => {
          drawingMap.invalidateSize();
          drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [50, 50] });
        }, 200);
      } catch (err) {
        console.error("Drawing map error:", err);
      }
    }, 600);
  }

  function addMorePoints() {
    if (!drawingPolyline || !drawingMap) return;
    const latlngs = drawingPolyline.getLatLngs();
    const newPath = [];
    for (let i = 0; i < latlngs.length - 1; i++) {
      newPath.push(latlngs[i]);
      const midLat = (latlngs[i].lat + latlngs[i+1].lat) / 2;
      const midLng = (latlngs[i].lng + latlngs[i+1].lng) / 2;
      newPath.push(L.latLng(midLat, midLng));
    }
    newPath.push(latlngs[latlngs.length - 1]);
    drawingPolyline.setLatLngs(newPath);
    renderEditorMarkers();
  }

  async function saveCablePath() {
    if (!drawingPolyline || !currentEditingCustomer) return;
    const latlngs = drawingPolyline.getLatLngs().map(ll => [ll.lat, ll.lng]);
    const pathJson = JSON.stringify(latlngs);

    try {
      const res = await fetch(`/admin/api/customers/${currentEditingCustomer}/cable-path`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ path: pathJson })
      });
      
      const contentType = res.headers.get("content-type");
      if (contentType && contentType.indexOf("application/json") !== -1) {
        const data = await res.json();
        if (data.ok) {
          alert('Jalur kabel berhasil disimpan!');
          location.reload();
        } else {
          alert('Gagal menyimpan: ' + data.error);
        }
      } else {
        alert('Gagal menyimpan jalur kabel.');
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  // ODP Modal Pickers
  let pickerMap, pickerMarker;
  let editPickerMap, editPickerMarker;
  let odcPickerMap, odcPickerMarker, editOdcPickerMap, editOdcPickerMarker;

  function initPickerMap(lat, lng) {
    if (!pickerMap) {
      pickerMap = L.map('picker-map').setView([lat, lng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(pickerMap);
      
      const odpIcon = L.divIcon({
        html: '<i class="bi bi-box-seam-fill picker-icon-odp"></i>',
        className: 'custom-div-icon',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      pickerMarker = L.marker([lat, lng], { draggable: true, icon: odpIcon }).addTo(pickerMap);
      
      pickerMarker.on('dragend', function(e) {
        const pos = pickerMarker.getLatLng();
        document.getElementById('new_lat').value = pos.lat.toFixed(6);
        document.getElementById('new_lng').value = pos.lng.toFixed(6);
      });

      pickerMap.on('click', function(e) {
        pickerMarker.setLatLng(e.latlng);
        document.getElementById('new_lat').value = e.latlng.lat.toFixed(6);
        document.getElementById('new_lng').value = e.latlng.lng.toFixed(6);
      });
    } else {
      pickerMap.setView([lat, lng], 16);
      pickerMarker.setLatLng([lat, lng]);
    }
    setTimeout(() => pickerMap.invalidateSize(), 300);
  }

  function initEditPickerMap(lat, lng) {
    if (!editPickerMap) {
      editPickerMap = L.map('edit-picker-map').setView([lat, lng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(editPickerMap);
      
      const odpIcon = L.divIcon({
        html: '<i class="bi bi-box-seam-fill picker-icon-odp"></i>',
        className: 'custom-div-icon',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      editPickerMarker = L.marker([lat, lng], { draggable: true, icon: odpIcon }).addTo(editPickerMap);
      
      editPickerMarker.on('dragend', function(e) {
        const pos = editPickerMarker.getLatLng();
        document.getElementById('e_odp_lat').value = pos.lat.toFixed(6);
        document.getElementById('e_odp_lng').value = pos.lng.toFixed(6);
      });

      editPickerMap.on('click', function(e) {
        editPickerMarker.setLatLng(e.latlng);
        document.getElementById('e_odp_lat').value = e.latlng.lat.toFixed(6);
        document.getElementById('e_odp_lng').value = e.latlng.lng.toFixed(6);
      });
    } else {
      editPickerMap.setView([lat, lng], 16);
      editPickerMarker.setLatLng([lat, lng]);
    }
    setTimeout(() => editPickerMap.invalidateSize(), 300);
  }

  function openModal(id) { 
    document.getElementById(id).style.display = 'flex'; 
    if (id === 'addOdpModal') {
      const lat = document.getElementById('new_lat').value || officeCoords.lat;
      const lng = document.getElementById('new_lng').value || officeCoords.lng;
      initPickerMap(lat, lng);
    } else if (id === 'addOdcModal') {
      const lat = document.getElementById('new_odc_lat').value || officeCoords.lat;
      const lng = document.getElementById('new_odc_lng').value || officeCoords.lng;
      initOdcPickerMap(lat, lng, false);
    }
  }

  function closeModal(id) { document.getElementById(id).style.display = 'none'; }

  function editOdp(odp) {
    document.getElementById('editOdpForm').action = '/admin/odps/' + odp.id + '/update';
    document.getElementById('e_odp_name').value = odp.name;
    document.getElementById('e_odp_odc_id').value = odp.odc_id || '';
    document.getElementById('e_odp_pon_port').value = odp.pon_port || '';
    document.getElementById('e_odp_port_capacity').value = Number(odp.port_capacity || 16);
    document.getElementById('e_odp_splitter_ratio').value = Number(odp.splitter_ratio || (Number(odp.port_capacity || 16) <= 8 ? 8 : 16));
    document.getElementById('e_odp_lat').value = odp.lat;
    document.getElementById('e_odp_lng').value = odp.lng;
    document.getElementById('e_odp_description').value = odp.description || '';
    openModal('editOdpModal');
    initEditPickerMap(odp.lat, odp.lng);
  }

  function deleteOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = btn.dataset.odpId;
    if (confirm('Apakah Anda yakin ingin menghapus ODP ini?')) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/odps/${odpId}/delete`;
      document.body.appendChild(form);
      form.submit();
    }
  }

  function focusOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    focusOdp(btn.dataset.odpId);
  }

  function initOdcPickerMap(lat, lng, isEdit) {
    const edit = Boolean(isEdit);
    const mapId = edit ? 'edit-odc-picker-map' : 'odc-picker-map';
    const latId = edit ? 'e_odc_lat' : 'new_odc_lat';
    const lngId = edit ? 'e_odc_lng' : 'new_odc_lng';
    const safeLat = Number.isFinite(Number(lat)) && Number(lat) !== 0 ? Number(lat) : officeCoords.lat;
    const safeLng = Number.isFinite(Number(lng)) && Number(lng) !== 0 ? Number(lng) : officeCoords.lng;
    let picker = edit ? editOdcPickerMap : odcPickerMap;
    let marker = edit ? editOdcPickerMarker : odcPickerMarker;
    const icon = L.divIcon({ html:'<div style="width:22px;height:22px;border-radius:6px;background:#0891b2;border:2px solid #fff;box-shadow:0 2px 5px rgba(0,0,0,.35)"></div>', className:'custom-div-icon', iconSize:[22,22], iconAnchor:[11,11] });
    if (!picker) {
      picker = L.map(mapId).setView([safeLat, safeLng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', { maxZoom:20, subdomains:['mt0','mt1','mt2','mt3'] }).addTo(picker);
      marker = L.marker([safeLat, safeLng], { draggable:true, icon }).addTo(picker);
      const sync = p => { document.getElementById(latId).value = p.lat.toFixed(6); document.getElementById(lngId).value = p.lng.toFixed(6); };
      marker.on('dragend', () => sync(marker.getLatLng()));
      picker.on('click', e => { marker.setLatLng(e.latlng); sync(e.latlng); });
      if (edit) { editOdcPickerMap = picker; editOdcPickerMarker = marker; } else { odcPickerMap = picker; odcPickerMarker = marker; }
    } else {
      picker.setView([safeLat, safeLng], 16);
      marker.setLatLng([safeLat, safeLng]);
    }
    document.getElementById(latId).value = safeLat.toFixed(6);
    document.getElementById(lngId).value = safeLng.toFixed(6);
    setTimeout(() => picker.invalidateSize(), 250);
  }

  function editOdc(id) {
    const d = odcs.find(x => Number(x.id) === Number(id));
    if (!d) return;
    document.getElementById('editOdcForm').action = '/admin/odcs/' + d.id + '/update';
    document.getElementById('e_odc_name').value = d.name || '';
    document.getElementById('e_odc_code').value = d.code || '';
    document.getElementById('e_odc_olt_id').value = d.olt_id || '';
    document.getElementById('e_odc_splitter_ratio').value = Number(d.splitter_ratio) === 8 ? 8 : 24;
    document.getElementById('e_odc_lat').value = d.lat || '';
    document.getElementById('e_odc_lng').value = d.lng || '';
    document.getElementById('e_odc_description').value = d.description || '';
    openModal('editOdcModal');
    initOdcPickerMap(d.lat, d.lng, true);
  }

  function editOdcFromBtn(btn) { if (btn && btn.dataset) editOdc(btn.dataset.odcId); }
  function focusOdcFromBtn(btn) { if (btn && btn.dataset) focusOdc(btn.dataset.odcId); }
  function deleteOdcFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    if (!confirm('Hapus ODC ini? ODP yang terhubung akan dilepas, data pelanggan tetap disimpan.')) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/odcs/' + btn.dataset.odcId + '/delete';
    document.body.appendChild(form);
    form.submit();
  }

  // Right Click on Map to Add ODP
  map.on('contextmenu', function(e) {
    const lat = e.latlng.lat.toFixed(6);
    const lng = e.latlng.lng.toFixed(6);
    document.getElementById('new_lat').value = lat;
    document.getElementById('new_lng').value = lng;
    openModal('addOdpModal');
  });

  // Fit all initial markers
  setTimeout(() => {
    fitAllMarkers();
    map.invalidateSize();
  }, 500);

  window.onclick = function(e) {
    if (e.target.className === 'mo') {
      e.target.style.display = 'none';
    }
  };

  // ─── REALTIME SPARKLINE CHART ─────────────────────────────────────────────
  const customerTrafficIntervals = {};
  const customerTrafficSeries = {};
  const customerTrafficRefreshInFlight = new Set();

  function drawSparkline(canvas, series, maxMbps, color) {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    const padX = 6;
    const padY = 6;
    const innerW = w - padX * 2;
    const innerH = h - padY * 2;
    const max = Number.isFinite(maxMbps) && maxMbps > 0 ? maxMbps : 10;
    let vals = Array.isArray(series) ? series : [];

    ctx.clearRect(0, 0, w, h);

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.22)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = 0; i <= 3; i++) {
      const y = padY + (innerH * i) / 3;
      ctx.moveTo(padX, y);
      ctx.lineTo(padX + innerW, y);
    }
    ctx.stroke();

    if (vals.length === 1) vals = [vals[0], vals[0]];
    if (vals.length < 2) return;

    const toY = (v) => {
      const n = Math.max(0, Number(v || 0) || 0);
      const r = Math.min(1, n / max);
      return padY + innerH * (1 - r);
    };

    const grad = ctx.createLinearGradient(padX, padY, padX + innerW, padY);
    grad.addColorStop(0, color);
    grad.addColorStop(1, 'rgba(255,255,255,0.0)');

    ctx.beginPath();
    for (let i = 0; i < vals.length; i++) {
      const x = padX + (innerW * i) / (vals.length - 1);
      const y = toY(vals[i]);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();

    ctx.lineTo(padX + innerW, padY + innerH);
    ctx.lineTo(padX, padY + innerH);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.globalAlpha = 0.22;
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  function setOverlay(customerId, kind, text) {
    const el = document.getElementById(`cust_${customerId}_${kind}_state`);
    if (!el) return;
    const t = String(text || '').trim();
    el.textContent = t;
    if (t) el.classList.add('on');
    else el.classList.remove('on');
  }

  function updatePopupTraffic(customerId, dlMbps, ulMbps, labelOverride) {
    const dlCanvas = document.getElementById(`cust_${customerId}_dl_chart`);
    const ulCanvas = document.getElementById(`cust_${customerId}_ul_chart`);
    const dlMax = Number(dlCanvas && dlCanvas.dataset ? dlCanvas.dataset.max : 10) || 10;
    const ulMax = Number(ulCanvas && ulCanvas.dataset ? ulCanvas.dataset.max : 10) || 10;

    if (!customerTrafficSeries[customerId]) customerTrafficSeries[customerId] = { dl: [], ul: [] };
    const st = customerTrafficSeries[customerId];

    if (labelOverride) {
      setOverlay(customerId, 'dl', labelOverride);
      setOverlay(customerId, 'ul', labelOverride);
      st.dl = [];
      st.ul = [];
      drawSparkline(dlCanvas, [0, 0], dlMax, 'rgba(59,130,246,0.6)');
      drawSparkline(ulCanvas, [0, 0], ulMax, 'rgba(34,197,94,0.6)');
      return;
    }

    setOverlay(customerId, 'dl', '');
    setOverlay(customerId, 'ul', '');

    const dl = Math.max(0, Number(dlMbps || 0) || 0);
    const ul = Math.max(0, Number(ulMbps || 0) || 0);
    st.dl.push(dl);
    st.ul.push(ul);
    if (st.dl.length > 22) st.dl = st.dl.slice(-22);
    if (st.ul.length > 22) st.ul = st.ul.slice(-22);

    drawSparkline(dlCanvas, st.dl, dlMax, '#3b82f6');
    drawSparkline(ulCanvas, st.ul, ulMax, '#22c55e');
  }

  async function refreshCustomerTrafficPopup(customerId) {
    const trafficKey = String(customerId);
    if (customerTrafficRefreshInFlight.has(trafficKey)) return;
    customerTrafficRefreshInFlight.add(trafficKey);
    try {
      const r = await fetch(`/admin/api/customers/${customerId}/pppoe-traffic`, { cache: 'no-store' });
      const data = await r.json();
      if (!data || !data.ok) {
        updatePopupTraffic(customerId, 0, 0, '-');
        return;
      }
      if (!data.available) {
        updatePopupTraffic(customerId, 0, 0, 'N/A');
        return;
      }
      if (!data.online) {
        updatePopupTraffic(customerId, 0, 0, 'Offline');
        return;
      }
      if (data.warmup) {
        updatePopupTraffic(customerId, 0, 0, 'Mengukur');
        return;
      }

      const rx = Number(data.rxMbps || 0);
      const tx = Number(data.txMbps || 0);
      updatePopupTraffic(customerId, tx, rx, '');
    } catch {
      updatePopupTraffic(customerId, 0, 0, '-');
    } finally {
      customerTrafficRefreshInFlight.delete(trafficKey);
    }
  }

  function startCustomerTrafficPopup(customerId) {
    stopCustomerTrafficPopup(customerId);
    refreshCustomerTrafficPopup(customerId);
    customerTrafficIntervals[customerId] = setInterval(() => refreshCustomerTrafficPopup(customerId), 10000);
  }

  function stopCustomerTrafficPopup(customerId) {
    const t = customerTrafficIntervals[customerId];
    if (t) clearInterval(t);
    delete customerTrafficIntervals[customerId];
  }

  function normalizePhone(phone) {
    const raw = String(phone || '').trim();
    const digits = raw.replace(/\D/g, '');
    if (!digits) return '';
    if (digits.startsWith('62')) return digits;
    if (digits.startsWith('0')) return `62${digits.slice(1)}`;
    if (digits.length >= 9) return `62${digits}`;
    return digits;
  }

  function buildWaLink(phone, name) {
    const to = normalizePhone(phone);
    const msg = `Halo ${String(name || '').trim()}`;
    if (!to) return 'javascript:void(0)';
    return `https://wa.me/${to}?text=${encodeURIComponent(msg)}`;
  }
</script>
