  body.tech-dashboard .isp-tasks-panel { margin:18px 0 8px; padding:15px; background:#fff; border:1px solid #e3eaf4; border-radius:17px; box-shadow:0 7px 22px rgba(24,54,94,.05); }
  body.tech-dashboard .isp-tasks-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }
  body.tech-dashboard .isp-tasks-heading h3 { margin:0 0 4px; color:#17365f; font-size:17px; font-weight:850; }
  body.tech-dashboard .isp-tasks-heading p { margin:0; color:#7b899d; font-size:12px; }
  body.tech-dashboard .isp-tasks-count { display:grid; place-items:center; min-width:34px; height:34px; padding:0 8px; border-radius:11px; background:#e7f0ff; color:#1455b4; font-weight:850; }
  body.tech-dashboard .isp-tasks-empty { display:flex; flex-direction:column; align-items:center; gap:7px; padding:23px 10px; text-align:center; color:#7b899d; font-size:12px; }
  body.tech-dashboard .isp-tasks-empty > i { font-size:30px; color:#8aa7d2; }
  body.tech-dashboard .isp-tasks-empty strong { color:#314966; font-size:14px; }
  body.tech-dashboard .isp-task-list { display:grid; gap:11px; }
  body.tech-dashboard .isp-task-card { min-width:0; padding:13px; border:1px solid #e5ebf4; border-radius:13px; background:#fbfdff; }
  body.tech-dashboard .isp-task-topline { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:7px; margin-bottom:10px; }
  body.tech-dashboard .isp-task-status { padding:5px 8px; border-radius:20px; font-size:10px; font-weight:800; }
  body.tech-dashboard .isp-task-status.working { background:#fff2d2; color:#9a6200; }
  body.tech-dashboard .isp-task-status.other { background:#eaf2ff; color:#1455b4; }
  body.tech-dashboard .isp-task-time { color:#7b899d; font-size:10px; }
  body.tech-dashboard .isp-task-card h4 { margin:0 0 8px; color:#1c3556; font-size:14px; font-weight:850; overflow-wrap:anywhere; }
  body.tech-dashboard .isp-task-customer, body.tech-dashboard .isp-task-address, body.tech-dashboard .isp-task-message { margin:5px 0; color:#667993; font-size:12px; overflow-wrap:anywhere; }
  body.tech-dashboard .isp-task-message { padding:9px; border-radius:9px; background:#f0f5fc; color:#405571; white-space:pre-wrap; }
  body.tech-dashboard .isp-task-footer { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; padding-top:9px; margin-top:9px; border-top:1px solid #e9eef6; color:#526782; font-size:11px; }
  body.tech-dashboard .isp-task-footer a { color:#1455b4; text-decoration:none; font-weight:800; }
  body.tech-dashboard .isp-task-close-form { margin:0; }
  body.tech-dashboard .isp-task-close-btn { min-height:30px; padding:5px 12px; border:0; border-radius:8px; background:#e8f6ee; color:#167344; font-size:11px; font-weight:800; cursor:pointer; }
  body.tech-dashboard .isp-task-close-btn:active { opacity:.8; }
  body.tech-dashboard .isp-tasks-heading-actions { display:flex; align-items:center; gap:8px; }
  body.tech-dashboard .isp-tasks-dismiss { width:32px; height:32px; display:flex; align-items:center; justify-content:center; border:1px solid #dce5f1; border-radius:50%; background:#f5f8fd; color:#526782; font-size:23px; line-height:1; cursor:pointer; }
  body.tech-dashboard .isp-tasks-panel.is-collapsed #ispTasksBody { display:none; }
  body.tech-dashboard .isp-tasks-panel.is-collapsed { padding-bottom:14px; }
</style>
<script>
(function(){
  var panel = document.querySelector('.isp-tasks-panel');
  var button = document.getElementById('ispTasksDismiss');
  if (!panel || !button) return;
  button.addEventListener('click', function(){
    var collapsed = panel.classList.toggle('is-collapsed');
    button.setAttribute('aria-expanded', String(!collapsed));
    button.setAttribute('title', collapsed ? 'Tampilkan panel tugas' : 'Sembunyikan panel tugas');
    button.textContent = collapsed ? '+' : '×';
  });
})();
</script>

