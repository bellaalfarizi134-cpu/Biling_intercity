 portInput.addEventListener('change',refreshPortAvailability);
 portInput.addEventListener('blur',refreshPortAvailability);
 readSnButton.addEventListener('click',async()=>{
   const customerId=String(customerSelect.value||'');
   if(!customerId){snReadStatus.textContent='Pilih pelanggan terlebih dahulu.';return;}
   resetDetectedSn();
   readSnButton.disabled=true;
   readSnButton.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Membaca SN dari OLT…';
   snReadStatus.textContent='Memindai daftar ONU yang belum terdaftar. Pemindaian ini tidak mengubah konfigurasi OLT.';
   try{
     const customerOption=customerSelect.options[customerSelect.selectedIndex];
     const scanOltId=String(oltSelect.value||(customerOption&&customerOption.dataset.oltId)||'');
     const scanQuery='customer_id='+encodeURIComponent(customerId)+(scanOltId?'&olt_id='+encodeURIComponent(scanOltId):'');
     const response=await fetch('/tech/binding-only/autofind?'+scanQuery,{headers:{Accept:'application/json'}});
     const data=await response.json().catch(()=>({success:false,message:'Respons server tidak dapat dibaca.'}));
     if(!response.ok||!data.success)throw new Error(data.message||'SN gagal dibaca dari OLT.');
     detectedSnItems=Array.isArray(data.items)?data.items:[];
     detectedSnItems.forEach((item,index)=>{
       const option=document.createElement('option');option.value=String(index);
       option.textContent=String(item.sn||'SN tidak diketahui')+' · PON '+String(item.pon);
       detectedSnSelect.appendChild(option);
     });
     detectedSnSelect.hidden=detectedSnItems.length===0;
     const warning=String(data.warning||'');
     snReadStatus.textContent=String(data.message||'Pemindaian selesai.')+(warning?' '+warning:'');
   }catch(error){snReadStatus.textContent=String(error.message||'SN gagal dibaca dari OLT.');}
   finally{
     const option=customerSelect.options[customerSelect.selectedIndex];
     readSnButton.disabled=!option||!option.value;
     readSnButton.innerHTML='<i class="bi bi-search me-1"></i>Baca SN dari OLT';
   }
 });
 detectedSnSelect.addEventListener('change',()=>{
   const item=detectedSnItems[Number(detectedSnSelect.value)];
   if(!item)return;
   snInput.value=String(item.sn||'');
   if(Array.from(vendorSelect.options).some(option=>option.value===item.vendor))vendorSelect.value=item.vendor;
   snReadStatus.textContent='SN '+item.sn+' dari PON '+item.pon+' dipilih untuk proses pendaftaran ONT.';
 });
 customerSelect.addEventListener('change',()=>{preserveDraft=false;resetDetectedSn();loadCustomer(false);const option=customerSelect.options[customerSelect.selectedIndex];setBindingStep(option&&option.value&&option.dataset.complete==='1'?3:(customerSelect.value?2:1));});
 document.getElementById('bindingBackToCustomer').addEventListener('click',()=>setBindingStep(1));
 document.getElementById('bindingBackToNetwork').addEventListener('click',()=>setBindingStep(2));
 oltSelect.addEventListener('change',()=>{filterOdps();refreshPortAvailability();refreshOdpDistance();});
 odpSelect.addEventListener('change',()=>{refreshPortAvailability();refreshOdpDistance();});
 latInput.addEventListener('input',refreshOdpDistance);
 lngInput.addEventListener('input',refreshOdpDistance);
 editButton.addEventListener('click',()=>{forceEdit=true;setBindingStep(2);});
 document.getElementById('bindingUseGps').addEventListener('click',()=>{
   if(!window.isSecureContext){
     gpsStatus.textContent='Browser menolak GPS karena halaman tidak dibuka melalui koneksi aman HTTPS. Buka portal menggunakan alamat https://portal.intercirtynetwrok.web.id lalu coba lagi.';
     return;
   }
   if(!navigator.geolocation){gpsStatus.textContent='Fitur lokasi tidak tersedia di browser ini. Buka halaman lewat Chrome dan izinkan akses Lokasi untuk aplikasi browser.';return;}
   gpsStatus.textContent='Mencari koordinat GPS… pastikan Lokasi HP aktif.';
   const applyPosition=pos=>{
     const latitude=Number(pos.coords.latitude),longitude=Number(pos.coords.longitude);
     if(!Number.isFinite(latitude)||!Number.isFinite(longitude)||Math.abs(latitude)>90||Math.abs(longitude)>180){
       gpsStatus.textContent='Koordinat dari perangkat tidak valid. Coba lagi atau isi koordinat secara manual.';
       return;
     }
     latInput.value=latitude.toFixed(6);
     lngInput.value=longitude.toFixed(6);
     gpsStatus.textContent='Lokasi berhasil dibaca. Pastikan titiknya sesuai lokasi pelanggan sebelum disimpan.';
   };
   const explainGpsError=err=>{
     if(!window.isSecureContext){
       gpsStatus.textContent='GPS diblokir karena koneksi halaman tidak aman. Buka portal memakai HTTPS.';
     }else if(err&&err.code===1){
       gpsStatus.textContent='Akses lokasi ditolak oleh browser atau sistem HP. Cek izin Lokasi untuk Chrome/aplikasi browser di Setelan HP, pilih Izinkan saat menggunakan aplikasi, aktifkan Lokasi presisi, lalu muat ulang halaman.';
     }else if(err&&err.code===2){
       gpsStatus.textContent='Posisi belum tersedia. Aktifkan GPS HP, coba dekat jendela/area terbuka, lalu tekan Ambil GPS lagi.';
     }else if(err&&err.code===3){
       gpsStatus.textContent='GPS terlalu lama merespons. Mencoba lokasi berbasis jaringan…';
     }else{
       gpsStatus.textContent='GPS gagal dibaca. Aktifkan Lokasi HP, pastikan izin browser aktif, lalu coba lagi.';
     }
   };
   navigator.geolocation.getCurrentPosition(applyPosition,err=>{
     if(err&&err.code===2||err&&err.code===3){
       explainGpsError(err);
       navigator.geolocation.getCurrentPosition(applyPosition,explainGpsError,{enableHighAccuracy:false,timeout:25000,maximumAge:60000});
     }else{
       explainGpsError(err);
     }
   },{enableHighAccuracy:true,timeout:12000,maximumAge:0});
 });
 form.addEventListener('submit',e=>{
   const option=customerSelect.options[customerSelect.selectedIndex];
   if(!option||!option.value){e.preventDefault();return;}
   const action=(e.submitter && e.submitter.value) ? e.submitter.value : lastSubmitAction;
   // Always submit the selected action via a hidden field, because the clicked button
   // is disabled in this handler and older WebViews can omit the disabled submitter.
   actionInput.value=action;
   if(action==='save_network'){
     const port=Number(portInput.value),lat=Number(latInput.value),lng=Number(lngInput.value);
     const latText=latInput.value.trim(),lngText=lngInput.value.trim();
     const gpsValid=latText!==''&&lngText!==''&&Number.isFinite(lat)&&Number.isFinite(lng)&&lat>=-90&&lat<=90&&lng>=-180&&lng<=180;
     const odpDistance=getSelectedOdpDistance();
     if(!oltSelect.value||!odpSelect.value||!Number.isInteger(port)||port<1||port>8||!gpsValid||!odpDistance.ok){
       e.preventDefault();refreshOdpDistance();
       alert(!gpsValid?'GPS pelanggan wajib diambil di lokasi pelanggan.':(!odpDistance.ok?odpDistance.message:'Lengkapi OLT HSGQ, ODP, dan port 1–8.'));
       return;
     }
     saveButton.disabled=true;saveButton.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Menyimpan data jaringan…';
     return;
   }
   if(option.dataset.complete!=='1'||forceEdit){e.preventDefault();setup.hidden=false;return;}
   if(!snInput.value.trim()){e.preventDefault();alert('Masukkan SN modem terlebih dahulu.');return;}
   if(!confirm('Daftarkan ONT ke OLT untuk pelanggan ini? Sistem akan melanjutkan pemeriksaan PPPoE dan internet. Jika ONT sudah terdaftar tetapi internet belum aktif, jangan ulangi binding.')){e.preventDefault();return;}
   bindButton.disabled=true;bindButton.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Memproses binding…';
   showBindingProgress('Mengirim perintah binding ke OLT…','Binding OLT');
 });
 resetDetectedSn();
 loadCustomer(preserveDraft);
 const initialCustomer=customerSelect.options[customerSelect.selectedIndex];
 if(initialCustomer&&initialCustomer.value){
   customerSearch.value=customerDisplay(initialCustomer);
   setBindingStep((watchBindingStatus||startBindingStep||initialCustomer.dataset.complete==='1')?3:2);
 }else{
   setBindingStep(1);
 }

 let watchStopped=false;
 if(doneOk){
   doneOk.addEventListener('click',()=>{ window.location.href='/tech/binding-only'; });
 }
 function simpleBindingStatus(job,postcheck){
   const status=String(job&&job.status||'').toLowerCase();
   const stage=String(postcheck&&postcheck.status||'');
   const raw=String((postcheck&&postcheck.last_message)||(job&&job.last_message)||'');
   if(status==='done')return 'Binding berhasil. PPPoE aktif dan koneksi internet terverifikasi.';
   if(/pemeriksaan firmware otomatis belum berhasil|firmware.*upgrade berjalan|upgrade gagal|upgrade dibatalkan|upgrade melebihi .*menit|firmware.*dijadwalkan ulang|menunggu upgrade firmware|hasil perintah upgrade belum dapat dipastikan|WAN ditahan karena proses firmware gagal/i.test(raw))return 'ONT sudah terdaftar, tetapi pemeriksaan atau pembaruan firmware belum selesai. Jangan ulangi binding; hubungi admin jaringan.';
   if(status==='bound_manual')return 'ONT sudah terdaftar, tetapi internet belum aktif. Jangan ulangi binding. Periksa akun PPPoE dan konfigurasi WAN pada ONT/OLT.';
   if(status==='failed')return 'Pendaftaran ONT belum berhasil. Periksa SN, daya ONT, konektor fiber, dan koneksi OLT sebelum mencoba lagi.';
   if(stage==='waiting_session')return 'Menunggu sesi PPPoE aktif di MikroTik.';
   if(stage==='waiting_reboot_down')return 'PPPoE aktif. ONT direstart melalui OLT; menunggu sesi terputus.';
   if(stage==='waiting_reboot_up')return 'ONT sudah direstart. Menunggu PPPoE tersambung kembali.';
   if(stage==='waiting_ping')return 'PPPoE tersambung kembali. Menguji koneksi internet.';
   if(/SN tidak ditemukan|GAGAL BINDING|autofind OLT/i.test(raw))return 'ONT belum terdeteksi di OLT. Pastikan SN sesuai label, ONT menyala, dan kabel fiber terpasang.';

   if(/TAHAP 1\/2|PROSES BINDING/i.test(raw))return 'Sedang mendaftarkan ONT ke OLT. Pastikan ONT menyala dan kabel fiber terpasang.';
   if(/TAHAP 2\/2|WAN_PENDING|WAN\/PPPoE|PPPoE belum|ACS/i.test(raw))return 'ONT sudah terdaftar. Sistem sedang menyiapkan PPPoE dan memeriksa koneksi internet.';
   return 'Memeriksa status pendaftaran ONT dan koneksi internet.';
 }
 async function pollBindingStatus(){
   if(watchStopped||!watchBindingStatus||!watchCustomerId||!asyncStatusPanel)return;
   try{
     const response=await fetch('/tech/binding-only/status?customer_id='+encodeURIComponent(watchCustomerId),{
       headers:{Accept:'application/json'},cache:'no-store'
     });
     const data=await response.json().catch(()=>({success:false,message:'Respons status tidak bisa dibaca.'}));
     if(!response.ok||!data.success)throw new Error(data.message||'Status binding belum tersedia.');
     const job=data.job||{};
     const postcheck=data.postcheck||null;
     const status=String(job.status||'').toLowerCase();
     const message=simpleBindingStatus(job,postcheck);
     asyncStatusPanel.hidden=false;
     asyncStatusPanel.className='alert rounded-4 binding-live-status '+(
       status==='failed'||status==='bound_manual'?'alert-warning':
       status==='done'?'alert-success':'alert-info'
     );
     asyncStatusPanel.textContent=message;
     if(status!=='done'&&status!=='failed'&&status!=='bound_manual'){
       const postStage=String(postcheck&&postcheck.status||'');
       const stageLabel=postStage==='waiting_session'?'Menunggu sesi PPPoE aktif':
         postStage==='waiting_reboot_down'?'Menunggu ONT restart dan sesi PPPoE terputus':
         postStage==='waiting_reboot_up'?'Menunggu PPPoE tersambung kembali':
         postStage==='waiting_ping'?'Menguji koneksi internet':
         status==='pending'?'Menunggu konfigurasi PPPoE dan koneksi internet':'Memeriksa pendaftaran ONT';
       showBindingProgress(message,stageLabel);
     }
     if(status==='done'){
       watchStopped=true;
       hideBindingProgress();
       if(doneText)doneText.textContent=message;
       if(doneOverlay)doneOverlay.classList.add('show');
       return;
     }
     if(status==='failed'||status==='bound_manual'){
       watchStopped=true;
       hideBindingProgress();
       asyncStatusPanel.className='alert alert-warning rounded-4 binding-live-status';
       asyncStatusPanel.textContent=message+(status==='bound_manual'
         ? '\nBinding tidak perlu diulang. Periksa akun PPPoE dan konfigurasi WAN, lalu gunakan menu Perbaiki Layanan atau hubungi admin jaringan.'
         : '\nPeriksa SN, daya ONT, konektor fiber, dan koneksi OLT sebelum mencoba binding kembali.');
       return;
     }
   }catch(error){
     asyncStatusPanel.hidden=false;
     asyncStatusPanel.className='alert alert-info rounded-4 binding-live-status';
     const pollingMessage='Belum berhasil membaca status terbaru. Sistem akan mencoba lagi sambil memeriksa ACS, PPPoE, dan internet.';
     asyncStatusPanel.textContent=pollingMessage;
     showBindingProgress(pollingMessage,'Memeriksa status jaringan');
   }
   // Keep the overlay alive while the server reports a pending job. Stop only on
   // terminal success (Internet UP) or terminal failed/manual status.
   window.setTimeout(pollBindingStatus,5000);
 }
 if(watchBindingStatus&&watchCustomerId){
   if(asyncStatusPanel){
     asyncStatusPanel.hidden=false;
     asyncStatusPanel.textContent='ONT sudah terdaftar. Menunggu koneksi PPPoE aktif, restart ONT bila diperlukan, lalu menguji internet…';
   }
   showBindingProgress('ONT sudah terdaftar. Menunggu PPPoE aktif, restart ONT bila diperlukan, lalu tes internet…','Memeriksa koneksi internet');
   pollBindingStatus();
 }
})();
</script>
