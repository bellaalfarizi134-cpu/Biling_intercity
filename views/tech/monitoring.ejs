<%- include('partials/header') %>
<style>
  .bind-tag{background:#f1f6fd!important;color:#334155!important;border-color:#dbe5f2!important;font-size:12px!important;min-height:38px}
  .bind-tag.active{background:#dbeafe!important;color:#174da0!important;border-color:#93baf3!important}
  .text-white{color:#1e293b}
  .text-light{color:#334155}
  .form-control,.form-select{font-size:14px}
  .small{line-height:1.5}
</style>

<style>
  .bind-tag { display: flex; align-items: center; justify-content: center; gap: 4px; padding: 8px 4px; border: 1px solid #dbe5f2; border-radius: 8px; background: #f1f6fd; font-size: 12px; font-weight: 700; cursor: pointer; text-align: center; transition: all 0.2s; color: #334155; }
  .bind-tag:hover { border-color: #2563eb; background: #eaf2ff; }
  .bind-tag.active { background: #dbeafe !important; color: #174da0 !important; border-color: #93baf3 !important; box-shadow: 0 4px 12px rgba(37,99,235,0.10); }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    
  </div>
  <button class="btn btn-sm btn-outline-primary rounded-circle" onclick="loadDevices()">
    <i class="bi bi-arrow-clockwise"></i>
  </button>
</div>

<!-- Search & Filter Bar -->
<div class="mb-3">
  <div class="row g-2">
    <div class="col-12 col-md-4">
      <div class="input-group">
        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
        <input type="text" id="search-input" class="form-control bg-dark border-secondary text-white shadow-none" placeholder="Cari nama, nomor HP, username PPPoE, SN ONU, atau tag..." oninput="filterDevices()">
      </div>
    </div>
    <div class="col-12 col-md-5">
      <div class="input-group">
        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-server"></i></span>
        <select id="server-filter" class="form-select bg-dark border-secondary text-white shadow-none" onchange="loadDevices()">
          <option value="all">Semua Server ACS</option>
          <% if (typeof acsServers !== 'undefined') { %>
            <% acsServers.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
    </div>
    <div class="col-12 col-md-3">
      <div class="input-group">
        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-funnel"></i></span>
        <select id="health-filter" class="form-select bg-dark border-secondary text-white shadow-none" onchange="filterDevices()" aria-label="Filter kondisi ONU">
          <option value="all">Semua kondisi</option>
          <option value="weak-rx">Redaman tinggi (RX ≤ -25 dBm)</option>
          <option value="offline">ONU offline</option>
          <option value="weak-rx-offline">Redaman tinggi + offline</option>
        </select>
      </div>
    </div>
  </div>
</div>

<div id="device-list">
  <div class="text-center py-5">
    <div class="spinner-border text-primary" role="status"></div>
    <p class="text-secondary mt-2 small">Memuat data perangkat...</p>
  </div>
</div>

<!-- Modal Edit SSID/Password -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered mx-3">
    <div class="modal-content bg-dark border-secondary text-white">
      <div class="modal-header border-secondary">
        <h6 class="modal-title" id="modalTitle">Ubah Pengaturan</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="modal-device-tag">
        <input type="hidden" id="modal-action-type">
        
        <div id="ssid-input-group" class="d-none">
          <div class="p-2 rounded border mb-3" style="border-color:#bfdbfe!important;background:#eff6ff;">
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="ssid-24-enabled" checked>
              <label class="form-check-label fw-semibold" for="ssid-24-enabled">Ubah nama Wi-Fi 2,4 GHz</label>
            </div>
            <input type="text" id="new-ssid-24" class="form-control bg-white text-dark" maxlength="32" placeholder="Nama Wi-Fi 2,4 GHz">
          </div>
          <div id="ssid-5-group" class="p-2 rounded border mb-2" style="border-color:#bbf7d0!important;background:#f0fdf4;">
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="ssid-5-enabled" checked>
              <label class="form-check-label fw-semibold" for="ssid-5-enabled">Ubah nama Wi-Fi 5 GHz</label>
            </div>
            <input type="text" id="new-ssid-5" class="form-control bg-white text-dark" maxlength="32" placeholder="Nama Wi-Fi 5 GHz">
          </div>
          <div id="ssid-settings-note" class="small text-secondary">Memuat nama Wi-Fi dari ACS...</div>
          <div class="small text-secondary mt-2">Centang band yang akan diubah. Band yang tidak dicentang tidak disentuh.</div>
        </div>
        
        <div id="pass-input-group" class="d-none">
          <label class="form-label small text-secondary" for="new-password">Kata sandi Wi-Fi baru</label>
          <div class="input-group">
            <input type="password" id="new-password" class="form-control bg-dark border-secondary text-white" placeholder="Minimal 8 karakter" minlength="8" autocomplete="new-password">
            <button type="button" class="btn btn-outline-secondary" data-password-toggle="new-password" aria-label="Tampilkan kata sandi Wi-Fi" aria-pressed="false"><i class="bi bi-eye"></i></button>
          </div>
          <div id="wifi-band-group" class="d-none mt-3">
            <label class="form-label small text-secondary" for="wifi-band-select">Band Wi-Fi yang diubah</label>
            <select id="wifi-band-select" class="form-select bg-dark border-secondary text-white">
              <option value="both">Keduanya — password sama untuk 2,4 dan 5 GHz</option>
              <option value="2g">2,4 GHz saja</option>
              <option value="5g">5 GHz saja</option>
            </select>
            <div class="form-text text-info">Band yang tidak dipilih tidak akan diubah.</div>
          </div>
        </div>
        
        <div id="reboot-confirm" class="d-none text-center py-2">
          <i class="bi bi-exclamation-triangle-fill text-warning fs-1"></i>
          <p class="mt-2 mb-0">Yakin ingin memulai ulang perangkat ini?</p>
        </div>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
        <button type="button" id="btn-submit-action" class="btn btn-primary btn-sm">Simpan Perubahan</button>
      </div>
    </div>
  </div>
</div>

<!-- Unified Add WAN All-in-One Modal (Technician Dark Style) -->
<div class="modal fade" id="addWanModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg mx-3">
    <div class="modal-content bg-dark border-secondary text-white">
      <div class="modal-header border-secondary">
        <h6 class="modal-title"><i class="bi bi-gear-fill me-1 text-success"></i> Konfigurasi WAN & PPPoE</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
        <form id="addWanForm" onsubmit="submitAddWanForm(event)">
          <input type="hidden" id="wanDeviceId" value="">
          <input type="hidden" id="wanAcsId" value="">
          
          <div class="p-3 bg-secondary bg-opacity-10 border border-secondary rounded mb-3" style="font-size: 13px;">
              <div class="row g-2">
                  <div class="col-6"><strong>SN Perangkat:</strong> <span id="lblWanSn" class="text-primary fw-bold">-</span></div>
                  <div class="col-6"><strong>Vendor:</strong> <span id="lblWanVendor" class="text-info fw-bold" style="text-transform: capitalize;">-</span></div>
                  <div class="col-6"><strong>Tipe Model:</strong> <span id="lblWanModel" class="fw-bold">-</span></div>
              </div>
          </div>

          <div class="row g-3 mb-3">
              <div class="col-6">
                <label class="form-label small text-secondary">Mode Koneksi WAN</label>
                <select id="wanMode" class="form-select bg-dark border-secondary text-white shadow-none" onchange="toggleWanModeFields()">
                  <option value="pppoe">PPPoE (Mode Router)</option>
                  <option value="bridge">Mode Bridge</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label small text-secondary">VLAN ID</label>
                <input type="number" id="wanVlanId" class="form-control bg-dark border-secondary text-white shadow-none" required min="1" max="4094" placeholder="Contoh: 100">
              </div>
          </div>

          <div class="mb-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="wanDhcp" checked>
                <label class="form-check-label small text-white fw-bold" style="cursor: pointer;" for="wanDhcp">
                  <i class="bi bi-server text-success me-1"></i> Aktifkan DHCP di LAN (nonaktifkan untuk mode bridge)
                </label>
              </div>
          </div>

          <!-- PPPoE Credentials Block -->
          <div id="pppoeFields" class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded mb-3">
              <h6 class="mb-2 text-primary"><i class="bi bi-key-fill me-1"></i> Akun PPPoE</h6>
              <div class="row g-3 mb-2">
                  <div class="col-6">
                    <label class="form-label small text-secondary">Username PPPoE</label>
                    <input type="text" id="wanPppoeUser" class="form-control bg-dark border-secondary text-white shadow-none" placeholder="Contoh: pelanggan123">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-secondary" for="wanPppoePass">Kata sandi PPPoE</label>
                    <div class="input-group">
                      <input type="password" id="wanPppoePass" class="form-control bg-dark border-secondary text-white shadow-none" placeholder="Masukkan kata sandi PPPoE" autocomplete="new-password">
                      <button type="button" class="btn btn-outline-secondary" data-password-toggle="wanPppoePass" aria-label="Tampilkan kata sandi PPPoE" aria-pressed="false"><i class="bi bi-eye"></i></button>
                    </div>
                  </div>
              </div>
              <div class="row g-2 align-items-center mt-3 pt-2 border-top border-secondary border-opacity-50">
                  <div class="col-12 col-sm-6">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="wanAutoMikrotik" checked onchange="toggleMikrotikProfileField()">
                        <label class="form-check-label small text-white" style="cursor: pointer;" for="wanAutoMikrotik">Buat akun PPPoE di MikroTik</label>
                      </div>
                  </div>
                  <div class="col-12 col-sm-6" id="pppoeProfileContainer">
                    <label class="form-label small text-secondary">Profil PPPoE MikroTik</label>
                    <select id="wanPppoeProfile" class="form-select bg-dark border-secondary text-white shadow-none">
                      <% if (typeof pppoeProfiles !== 'undefined') { %>
                        <% pppoeProfiles.forEach(p => { %>
                            <option value="<%= p.name %>" <%= p.name === 'default' ? 'selected' : '' %>><%= p.name %></option>
                        <% }); %>
                      <% } %>
                    </select>
                  </div>
              </div>
          </div>

          <!-- Unified Wi-Fi Block -->
          <div class="border border-secondary rounded mb-3 overflow-hidden">
              <div class="p-3 bg-secondary bg-opacity-10 border-bottom border-secondary d-flex justify-content-between align-items-center">
                  <div class="form-check form-switch w-100 mb-0">
                    <input class="form-check-input" type="checkbox" id="wanConfigureWifi" onchange="toggleWifiFields()">
                    <label class="form-check-label small text-white fw-bold" style="cursor: pointer;" for="wanConfigureWifi">
                      <i class="bi bi-wifi text-success me-1"></i> Konfigurasikan Wi-Fi Sekaligus
                    </label>
                  </div>
              </div>
              <div id="wifiFields" style="display: none;" class="p-3 bg-dark">
                  <div id="wifiLoading" class="text-center py-2 text-secondary small">
                      <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div> Mengunduh SSID lama...
                  </div>
                  <div id="wifiBandsContainer" class="d-grid gap-3">
                      <!-- 2.4GHz Band -->
                      <div id="band24Fields">
                          <h6 class="mb-2 text-white" style="font-size: 13px;"><i class="bi bi-broadcast me-1"></i> Wi-Fi 2.4GHz</h6>
                          <div class="row g-3">
                              <div class="col-6">
                                <label class="form-label small text-secondary">Nama Wi-Fi (SSID)</label>
                                <input type="text" id="wifiSsid24" class="form-control bg-dark border-secondary text-white shadow-none" placeholder="Mengunduh...">
                              </div>
                              <div class="col-6">
                                <label class="form-label small text-secondary">Kata sandi Wi-Fi (WPA2)</label>
                                <input type="password" id="wifiPass24" class="form-control bg-dark border-secondary text-white shadow-none" placeholder="Isi jika diganti">
                              </div>
                          </div>
                      </div>
                      <!-- 5GHz Band -->
                      <div id="band5Fields" class="border-top border-secondary border-opacity-50 pt-3" style="display: none;">
                          <h6 class="mb-2 text-white" style="font-size: 13px;"><i class="bi bi-lightning-charge me-1"></i> Wi-Fi 5GHz</h6>
                          <div class="row g-3">
                              <div class="col-6">
                                <label class="form-label small text-secondary">Nama Wi-Fi (SSID)</label>
                                <input type="text" id="wifiSsid5" class="form-control bg-dark border-secondary text-white shadow-none" placeholder="Mengunduh...">
                              </div>
                              <div class="col-6">
                                <label class="form-label small text-secondary">Kata sandi Wi-Fi (WPA2)</label>
                                <input type="password" id="wifiPass5" class="form-control bg-dark border-secondary text-white shadow-none" placeholder="Isi jika diganti">
                              </div>
                          </div>
                      </div>
                  </div>
              </div>
          </div>

          <!-- LAN / WLAN Port Binding -->
          <div class="p-3 bg-secondary bg-opacity-10 border border-secondary rounded mb-2">
              <h6 class="mb-2 text-white fw-bold"><i class="bi bi-bezier2 me-1 text-success"></i> LAN / WLAN Port Binding</h6>
              
              <label class="form-label small text-secondary mb-1">Port LAN:</label>
              <div class="row g-2 mb-3">
                  <div class="col-3">
                      <label class="bind-tag active" id="lblLan1">
                          <input type="checkbox" name="lanPorts" value="LAN1" checked style="display: none;" onchange="syncTagClass(this, 'lblLan1')"> LAN 1
                      </label>
                  </div>
                  <div class="col-3">
                      <label class="bind-tag active" id="lblLan2">
                          <input type="checkbox" name="lanPorts" value="LAN2" checked style="display: none;" onchange="syncTagClass(this, 'lblLan2')"> LAN 2
                      </label>
                  </div>
                  <div class="col-3">
                      <label class="bind-tag active" id="lblLan3">
                          <input type="checkbox" name="lanPorts" value="LAN3" checked style="display: none;" onchange="syncTagClass(this, 'lblLan3')"> LAN 3
                      </label>
                  </div>
                  <div class="col-3">
                      <label class="bind-tag active" id="lblLan4">
                          <input type="checkbox" name="lanPorts" value="LAN4" checked style="display: none;" onchange="syncTagClass(this, 'lblLan4')"> LAN 4
                      </label>
                  </div>
              </div>

              <label class="form-label small text-secondary mb-1">Jaringan Wi-Fi:</label>
              <div class="row g-2">
                  <div class="col-3">
                      <label class="bind-tag active" id="lblWlan1">
                          <input type="checkbox" name="wlanSsids" value="SSID1" checked style="display: none;" onchange="syncTagClass(this, 'lblWlan1')"> SSID 1
                      </label>
                  </div>
                  <div class="col-3">
                      <label class="bind-tag" id="lblWlan2">
                          <input type="checkbox" name="wlanSsids" value="SSID2" style="display: none;" onchange="syncTagClass(this, 'lblWlan2')"> SSID 2
                      </label>
                  </div>
                  <div class="col-3">
                      <label class="bind-tag" id="lblWlan3">
                          <input type="checkbox" name="wlanSsids" value="SSID3" style="display: none;" onchange="syncTagClass(this, 'lblWlan3')"> SSID 3
                      </label>
                  </div>
                  <div class="col-3">
                      <label class="bind-tag" id="lblWlan4">
                          <input type="checkbox" name="wlanSsids" value="SSID4" style="display: none;" onchange="syncTagClass(this, 'lblWlan4')"> SSID 4
                      </label>
                  </div>
              </div>
          </div>

        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
        <button type="submit" form="addWanForm" class="btn btn-success btn-sm" id="btn-save-add-wan">Jalankan Provisioning</button>
      </div>
    </div>
  </div>
</div>

<script>
let allDevices = [];
const actionModal = new bootstrap.Modal(document.getElementById('actionModal'));

// Semua kolom sandi disamarkan secara default dan hanya terlihat saat diminta.
document.querySelectorAll('[data-password-toggle]').forEach(function (toggle) {
  toggle.addEventListener('click', function () {
    const input = document.getElementById(toggle.dataset.passwordToggle);
    if (!input) return;
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    toggle.setAttribute('aria-pressed', String(show));
    toggle.setAttribute('aria-label', (show ? 'Sembunyikan' : 'Tampilkan') + ' password');
    toggle.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
  });
});

async function loadDevices() {
  const container = document.getElementById('device-list');
  container.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="text-secondary mt-2 small">Memuat data perangkat...</p></div>`;
  const acsFilter = document.getElementById('server-filter').value;
  try {
    const res = await fetch(`/tech/api/devices?acs=${encodeURIComponent(acsFilter)}`, { headers: { 'Accept': 'application/json' } });
    const data = await res.json();
    if (!res.ok) throw new Error((data && data.error) || `API HTTP ${res.status}`);
    if (data && data.error) throw new Error(data.error);
    if (!data || !Array.isArray(data.devices)) throw new Error('Format respons daftar perangkat tidak valid');
    allDevices = data.devices;
    filterDevices(); // Apply client search if any
  } catch (e) {
    container.innerHTML = `<div class="alert alert-danger small">Gagal memuat data: ${e.message}</div>`;
  }
}

function escapeDeviceAttribute(value) {
  return String(value ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;')
    .replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&#39;');
}

function renderDevices(devices) {
  const container = document.getElementById('device-list');
  if (devices.length === 0) {
    container.innerHTML = `<div class="text-center py-5 text-secondary small">Tidak ada perangkat ditemukan</div>`;
    return;
  }

  container.innerHTML = devices.map(d => {
    const isOn = d.status === 'online';
    const tags = Array.isArray(d.tags) ? d.tags.filter(t => String(t || '').trim() && String(t).toLowerCase() !== 'bootstrapped') : [];
    // Prefer a real customer tag; otherwise use the unique ACS device ID.
    const deviceToken = tags[0] || String(d.id || '');
    const safeToken = escapeDeviceAttribute(deviceToken);
    const safeSSID = escapeDeviceAttribute(d.ssid || '');
    const safeManufacturer = escapeDeviceAttribute(d.manufacturer || '');
    const safeModel = escapeDeviceAttribute(d.model || '');
    const title = d.customerName ? d.customerName : (tags.join(', ') || 'Tanpa Tag');
    const sub = d.customerName ? `${tags.join(', ') || 'Tanpa Tag'} | SN: ${d.serialNumber}` : `${d.model || 'ONU'} | SN: ${d.serialNumber}`;
    return `
      <div class="t-card mb-3 p-3" style="border-left: 4px solid ${isOn ? '#10b981' : '#ef4444'}">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="fw-bold" style="font-size: 15px;">${title}</div>
            <div class="text-secondary small">${sub}</div>
            ${d.customerPhone ? `<div class="text-secondary small">📞 ${d.customerPhone}</div>` : ``}
          </div>
          <span class="badge-status badge-${isOn ? 'resolved' : 'open'}">
            ${isOn ? 'Online' : 'Offline'}
          </span>
        </div>
        
        <div class="mb-2">
          <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="font-size: 10px; padding: 3px 8px;">
            <i class="bi bi-server me-1"></i>${d.acsServerName || 'Default ACS'}
          </span>
        </div>
        
        <div class="row g-2 mb-3 mt-1" style="font-size: 12px;">
          <div class="col-6">
            <div class="text-secondary"><i class="bi bi-person-badge me-1"></i> Username PPPoE</div>
            <div class="fw-semibold text-truncate">${d.pppoeUsername && d.pppoeUsername !== 'N/A' ? d.pppoeUsername : '-'}</div>
          </div>
          <div class="col-6">
            <div class="text-secondary"><i class="bi bi-activity me-1"></i> Redaman (RX)</div>
            <div class="fw-semibold ${d.rxPower && String(d.rxPower).includes('-') ? (parseFloat(d.rxPower) < -27 ? 'text-danger' : 'text-success') : ''}">${d.rxPower || '-'}</div>
          </div>
          <div class="col-6">
            <div class="text-secondary"><i class="bi bi-wifi me-1"></i> SSID</div>
            <div class="fw-semibold text-truncate">${d.ssid || '-'}</div>
          </div>
          <div class="col-6">
            <div class="text-secondary"><i class="bi bi-globe me-1"></i> Alamat IP</div>
            <div class="fw-semibold small">${d.pppoeIP || '-'}</div>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-primary flex-fill" style="font-size: 11px;" data-device-action="ssid" data-device-token="${safeToken}" data-device-id="${escapeDeviceAttribute(d.id || '')}" data-acs-server-id="${escapeDeviceAttribute(d.acsServerId || '')}" data-device-ssid="${safeSSID}">
            <i class="bi bi-wifi"></i> SSID
          </button>
          <button class="btn btn-sm btn-outline-primary flex-fill" style="font-size: 11px;" data-device-action="pass" data-device-token="${safeToken}" data-device-manufacturer="${safeManufacturer}" data-device-model="${safeModel}">
            <i class="bi bi-key"></i> Sandi Wi-Fi
          </button>
          <button class="btn btn-sm btn-outline-success flex-fill" style="font-size: 11px;" onclick="openAddWanModal('${d.id}', '${d.acsServerId}', '${d.serialNumber}', '${d.manufacturer || ""}', '${d.model || ""}')">
            <i class="bi bi-gear-fill"></i> WAN
          </button>
          <button class="btn btn-sm btn-outline-danger" style="font-size: 11px;" data-device-action="reboot" data-device-token="${safeToken}">
            <i class="bi bi-power"></i>
          </button>
        </div>
        <button class="btn btn-sm btn-outline-info w-100 mt-2" style="font-size: 12px;" data-device-action="details" data-device-token="${safeToken}">
          <i class="bi bi-wifi"></i> Detail Wi-Fi &amp; Perangkat Terhubung
        </button>
        <div class="mt-2 p-2 rounded border d-none" style="border-color:#cbd5e1!important;background:#f8fafc;font-size:12px;" data-device-details-panel="${safeToken}" data-loaded="false">
          <div class="text-secondary small">Pilih detail untuk memuat data terbaru dari ACS.</div>
        </div>
      </div>
    `;
  }).join('');
  container.querySelectorAll('[data-device-action]').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-device-action') || '';
      if (action === 'details') {
        loadDeviceWifiDetails(btn);
        return;
      }
      openActionModal(
        btn.getAttribute('data-device-token') || '',
        action,
        btn.getAttribute('data-device-ssid') || '',
        btn.getAttribute('data-device-manufacturer') || '',
        btn.getAttribute('data-device-model') || '',
        btn.getAttribute('data-device-id') || '',
        btn.getAttribute('data-acs-server-id') || ''
      );
    });
  });
}

function escapeDeviceHtml(value) {
  return String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

async function loadDeviceWifiDetails(button, forceRefresh = false) {
  const token = button.getAttribute('data-device-token') || '';
  const panel = Array.from(document.querySelectorAll('[data-device-details-panel]'))
    .find(node => node.getAttribute('data-device-details-panel') === token);
  if (!panel || !token) return;

  if (!forceRefresh && !panel.classList.contains('d-none') && panel.dataset.loaded === 'true') {
    panel.classList.add('d-none');
    return;
  }
  panel.classList.remove('d-none');
  panel.dataset.loaded = 'false';
  panel.innerHTML = '<div class="text-secondary small py-2"><span class="spinner-border spinner-border-sm me-2"></span>' +
    (forceRefresh ? 'Meminta pembacaan ulang daftar perangkat dari ONT...' : 'Memuat jaringan Wi-Fi dan memeriksa kesegaran data ACS...') + '</div>';
  button.disabled = true;

  const fetchDetails = async (refresh) => {
    const url = '/tech/api/device/' + encodeURIComponent(token) + (refresh ? '?refresh=1' : '');
    const response = await fetch(url, {
      headers: { 'Accept': 'application/json' },
      credentials: 'same-origin'
    });
    const data = await response.json();
    if (!response.ok || !data || data.error) {
      throw new Error(data?.error || 'Data perangkat tidak dapat dimuat.');
    }
    return data;
  };

  try {
    let data = await fetchDetails(forceRefresh);
    // Give the ONT a short window to answer the read-only ACS task. Never show the
    // previous cache as Online while this request is still in progress.
    for (let attempt = 0; attempt < 8 && data.clientsSyncing; attempt++) {
      panel.innerHTML = '<div class="text-primary small py-2"><span class="spinner-border spinner-border-sm me-2"></span>' +
        'ACS sedang membaca ulang data perangkat dari ONT (' + (attempt + 1) + '/8)...</div>';
      await new Promise(resolve => setTimeout(resolve, 1500));
      data = await fetchDetails(false);
    }

    const rawBands = Array.isArray(data.wifiBands) ? data.wifiBands : [];
    const bands = rawBands.filter(band => {
      const ssid = String(band?.ssid || '').trim();
      if (!ssid || ssid === '-') return false;
      if (band.enabled === true) return true;
      if (band.enabled === false) return false;
      return !/^(?:fh[_-]?)?(?:5g[_-]?)?ssid\d*$/i.test(ssid);
    });
    const bandHtml = bands.length ? bands.map((band, index) => {
      const secretId = 'wifi-secret-' + Array.from(document.querySelectorAll('[data-device-details-panel]')).indexOf(panel) + '-' + index;
      const secret = String(band.password || '');
      const secretHtml = band.passwordAvailable && secret
        ? '<div class="d-flex align-items-center gap-2 mt-1"><span class="text-secondary">Kata sandi:</span>' +
          '<input id="' + secretId + '" class="form-control form-control-sm" style="max-width:230px" type="password" readonly autocomplete="off" value="' + escapeDeviceHtml(secret) + '">' +
          '<button type="button" class="btn btn-sm btn-outline-secondary" data-reveal-wifi-secret="' + secretId + '" aria-label="Tampilkan atau sembunyikan kata sandi Wi-Fi"><i class="bi bi-eye"></i></button></div>'
        : '<div class="small text-secondary mt-1">Kata sandi tidak tersedia dari ACS untuk ONT ini, sehingga tidak ditampilkan.</div>';
      return '<div class="p-2 mb-2 rounded border" style="border-color:#dbe2ea!important;background:white">' +
        '<div class="fw-semibold">' + escapeDeviceHtml(band.label || ('Wi-Fi ' + (index + 1))) + '</div>' +
        '<div>Nama Wi-Fi (SSID): <strong>' + escapeDeviceHtml(band.ssid || '-') + '</strong></div>' +
        secretHtml + '</div>';
    }).join('') : '<div class="small text-secondary mb-2">Tidak ada nama jaringan Wi-Fi aktif yang dapat diverifikasi dari ACS.</div>';

    const rawClients = Array.isArray(data.connectedUsers) ? data.connectedUsers : [];
    const clientDataFresh = data.clientDataFresh === true;
    // On a fresh ACS snapshot, the active-device panel shows only confirmed Online rows.
    // Offline/ambiguous cache rows remain in the underlying ACS data for audit.
    const clients = clientDataFresh
      ? rawClients.filter(client => String(client?.status || '').toLowerCase() === 'online')
      : rawClients;
    const activeClientCount = clientDataFresh ? clients.filter(client =>
      client && client.mac && client.mac !== '-' && String(client.status || '').toLowerCase() === 'online'
    ).length : 0;
    const inactiveClientCount = clients.filter(client =>
      client && String(client.status || '').toLowerCase() === 'offline'
    ).length;
    const unknownClientCount = clients.filter(client =>
      client && !['online', 'offline'].includes(String(client.status || '').toLowerCase())
    ).length;
    const deviceOnline = String(data.status || '').toLowerCase() === 'online';
    const clientsHtml = clients.length ? clients.map((client, index) => {
      const name = client.hostname && client.hostname !== '-' && client.hostname !== 'Unknown'
        ? client.hostname : ('Perangkat ' + (index + 1));
      const iface = client.iface || 'WiFi/LAN';
      const status = clientDataFresh ? (client.status || 'Belum diverifikasi') : 'Belum diverifikasi';
      return '<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 p-2 mb-1 rounded" style="background:white;border:1px solid #e2e8f0">' +
        '<div style="min-width:0;flex:1"><div class="fw-semibold">' + escapeDeviceHtml(name) + '</div>' +
        '<div class="text-secondary small">IP: ' + escapeDeviceHtml(client.ip || '-') + '</div>' +
        '<div class="text-secondary small">MAC: ' + escapeDeviceHtml(client.mac || '-') + '</div></div>' +
        '<div class="text-end"><div class="badge bg-light text-dark border">' + escapeDeviceHtml(iface) + '</div>' +
        '<div class="small text-secondary mt-1">' + escapeDeviceHtml(status) + '</div></div></div>';
    }).join('') : (
      data.clientsSyncing
        ? '<div class="small text-primary py-2">ACS sedang mengambil daftar perangkat dari ONT.</div>'
        : (!deviceOnline
          ? '<div class="small text-secondary py-2">ONT sedang offline atau belum mengirim pembaruan ke ACS. Daftar perangkat terkini belum tersedia.</div>'
          : '<div class="small text-secondary py-2">Belum ada perangkat yang dilaporkan ONT pada pembacaan ACS terakhir.</div>')
    );

    const clientFreshnessHtml = clientDataFresh
      ? '<div class="small text-success mb-2">Data perangkat terakhir dibaca ACS: ' + escapeDeviceHtml(data.clientDataUpdatedAt || '-') + '</div>'
      : '<div class="small text-warning mb-2">Data klien belum terverifikasi dalam 1 jam terakhir. Status perangkat lama tidak ditandai Online. ' +
        (data.clientsSyncing ? 'Menunggu respons ONT.' : 'Tekan Perbarui detail untuk meminta pembacaan ulang.') + '</div>';

    panel.innerHTML = '<div class="d-flex justify-content-between align-items-center mb-2"><strong>Jaringan Wi-Fi (' + bands.length + ' SSID)</strong>' +
      '<button type="button" class="btn btn-sm btn-outline-secondary" data-reload-wifi-details>Perbarui detail</button></div>' +
      bandHtml + '<div class="fw-semibold mt-3 mb-2"><i class="bi bi-people me-1"></i>Perangkat terhubung (' + (clientDataFresh ? activeClientCount : clients.length) + (clientDataFresh ? ' online' : ' menunggu verifikasi') + ')</div>' +
      clientFreshnessHtml +
      (inactiveClientCount > 0 ? '<div class="small text-secondary mb-2">' + inactiveClientCount + ' perangkat dilaporkan offline pada pembacaan terbaru.</div>' : '') +
      (unknownClientCount > 0 && clientDataFresh ? '<div class="small text-secondary mb-2">' + unknownClientCount + ' perangkat belum memiliki status aktif yang dapat dipastikan.</div>' : '') +
      clientsHtml + '<div class="text-secondary small mt-2">ACS memeriksa ulang daftar perangkat setiap 1 jam untuk ONT yang dapat dijangkau. Setelah data terbaru diterima, hanya perangkat yang terkonfirmasi Online yang ditampilkan; perangkat Offline atau yang tidak dapat dipastikan tidak masuk daftar aktif. Jika ONT belum merespons, data lama tetap menunggu verifikasi dan tidak dianggap Online.</div>';
    panel.dataset.loaded = 'true';

    panel.querySelectorAll('[data-reveal-wifi-secret]').forEach(toggle => {
      toggle.addEventListener('click', () => {
        const input = document.getElementById(toggle.getAttribute('data-reveal-wifi-secret'));
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
        toggle.innerHTML = input.type === 'text' ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
      });
    });
    const reload = panel.querySelector('[data-reload-wifi-details]');
    if (reload) reload.addEventListener('click', () => loadDeviceWifiDetails(button, true));
  } catch (error) {
    panel.dataset.loaded = 'false';
    panel.innerHTML = '<div class="text-danger small py-2">' + escapeDeviceHtml(error.message || 'Detail Wi-Fi gagal dimuat.') + '</div>' +
      '<button type="button" class="btn btn-sm btn-outline-secondary" data-retry-wifi-details>Coba Lagi</button>';
    panel.querySelector('[data-retry-wifi-details]')?.addEventListener('click', () => loadDeviceWifiDetails(button, true));
  } finally {
    button.disabled = false;
  }
}

function getRxDbm(device) {
  const raw = String(device && device.rxPower != null ? device.rxPower : '').trim();
  if (!raw || raw === '-' || raw.toLowerCase() === 'n/a' || raw.toLowerCase() === 'na') return null;
  const match = raw.replace(',', '.').match(/-?\d+(?:\.\d+)?/);
  if (!match) return null;
  const value = Number(match[0]);
  return Number.isFinite(value) ? value : null;
}

function filterDevices() {
  const q = document.getElementById('search-input').value.toLowerCase();
  const healthFilter = document.getElementById('health-filter')?.value || 'all';
  const filtered = allDevices.filter(d => {
    const tags = Array.isArray(d.tags) ? d.tags : [];
    const matchesSearch = !q || tags.some(t => String(t || '').toLowerCase().includes(q)) ||
      String(d.serialNumber || '').toLowerCase().includes(q) ||
      (d.pppoeUsername && d.pppoeUsername !== 'N/A' && String(d.pppoeUsername).toLowerCase().includes(q)) ||
      (d.customerName && String(d.customerName).toLowerCase().includes(q)) ||
      (d.customerPhone && String(d.customerPhone).toLowerCase().includes(q)) ||
      (d.id && String(d.id).toLowerCase().includes(q));
    if (!matchesSearch) return false;
    const rx = getRxDbm(d);
    const weakRx = rx !== null && rx <= -25;
    const offline = String(d.status || '').toLowerCase() === 'offline';
    if (healthFilter === 'weak-rx') return weakRx;
    if (healthFilter === 'offline') return offline;
    if (healthFilter === 'weak-rx-offline') return weakRx && offline;
    return true;
  });
  // Nilai RX yang makin negatif berarti sinyal optik makin lemah; tampilkan
  // kondisi terparah paling atas hanya pada filter yang berkaitan dengan redaman.
  if (healthFilter === 'weak-rx' || healthFilter === 'weak-rx-offline') {
    filtered.sort((a, b) => getRxDbm(a) - getRxDbm(b));
  }
  renderDevices(filtered);
}

async function openActionModal(tag, type, currentSsid = '', manufacturer = '', model = '', deviceId = '', acsServerId = '') {
  document.getElementById('modal-device-tag').value = tag;
  document.getElementById('modal-action-type').value = type;
  document.getElementById('ssid-input-group').classList.add('d-none');
  document.getElementById('pass-input-group').classList.add('d-none');
  document.getElementById('wifi-band-group').classList.add('d-none');
  document.getElementById('wifi-band-select').value = 'both';
  document.getElementById('reboot-confirm').classList.add('d-none');
  const passwordInput = document.getElementById('new-password');
  passwordInput.type = 'password';
  const passwordToggle = document.querySelector('[data-password-toggle="new-password"]');
  passwordToggle.setAttribute('aria-pressed', 'false');
  passwordToggle.setAttribute('aria-label', 'Tampilkan kata sandi Wi-Fi');
  passwordToggle.innerHTML = '<i class="bi bi-eye"></i>';
  const submitBtn = document.getElementById('btn-submit-action');
  submitBtn.className = 'btn btn-primary btn-sm';

  if (type === 'ssid') {
    document.getElementById('modalTitle').innerText = 'Ubah Nama Wi-Fi';
    document.getElementById('ssid-input-group').classList.remove('d-none');
    document.getElementById('new-ssid-24').value = currentSsid || '';
    document.getElementById('new-ssid-5').value = '';
    document.getElementById('ssid-24-enabled').checked = true;
    document.getElementById('ssid-24-enabled').disabled = false;
    document.getElementById('ssid-5-enabled').checked = false;
    document.getElementById('ssid-5-group').classList.add('d-none');
    document.getElementById('ssid-settings-note').innerText = 'Memuat nama Wi-Fi dari ACS...';
    submitBtn.innerText = 'Simpan Nama Wi-Fi';
    actionModal.show();

    if (!deviceId) {
      document.getElementById('ssid-settings-note').innerText = 'ID perangkat ACS tidak tersedia. Nama 5 GHz tidak dapat dipastikan.';
      return;
    }
    try {
      const query = acsServerId ? '?acsId=' + encodeURIComponent(acsServerId) : '';
      const response = await fetch('/tech/api/wifi-settings/' + encodeURIComponent(deviceId) + query, {
        headers: { 'Accept': 'application/json' }, credentials: 'same-origin'
      });
      const settings = await response.json();
      if (!response.ok || !settings || !settings.success) throw new Error(settings?.message || 'Data SSID tidak tersedia.');
      document.getElementById('new-ssid-24').value = settings.ssid24 || currentSsid || '';
      if (settings.ssid24Disabled) {
        document.getElementById('ssid-24-enabled').checked = false;
        document.getElementById('ssid-24-enabled').disabled = true;
      } else {
        document.getElementById('ssid-24-enabled').disabled = false;
      }
      if (settings.has5g && settings.ssid5) {
        document.getElementById('new-ssid-5').value = settings.ssid5;
        document.getElementById('ssid-5-enabled').checked = true;
        document.getElementById('ssid-5-group').classList.remove('d-none');
        document.getElementById('ssid-settings-note').innerText = 'SSID 2,4 GHz dan 5 GHz tersedia. Pilih band yang akan diubah.';
      } else {
        document.getElementById('ssid-5-enabled').checked = false;
        document.getElementById('ssid-5-group').classList.add('d-none');
        document.getElementById('ssid-settings-note').innerText = settings.ssid5Disabled
          ? 'SSID 5 GHz terdeteksi nonaktif dari ACS. Tidak ditawarkan untuk diubah.'
          : 'SSID 5 GHz belum ditemukan dari ACS. Hanya 2,4 GHz yang tersedia untuk perubahan.';
      }
    } catch (error) {
      document.getElementById('ssid-5-enabled').checked = false;
      document.getElementById('ssid-settings-note').innerText = 'Gagal membaca daftar SSID dari ACS: ' + (error.message || 'tidak diketahui');
    }
    return;
  } else if (type === 'pass') {
    document.getElementById('modalTitle').innerText = 'Kata sandi Wi-Fi';
    document.getElementById('pass-input-group').classList.remove('d-none');
    document.getElementById('new-password').value = '';
    const isFiberHomeHg6145d2 = String(manufacturer).toLowerCase().includes('fiberhome') &&
      String(model).toUpperCase().includes('HG6145D2');
    if (isFiberHomeHg6145d2) document.getElementById('wifi-band-group').classList.remove('d-none');
    submitBtn.innerText = 'Simpan Kata Sandi';
  } else if (type === 'reboot') {
    document.getElementById('modalTitle').innerText = 'Mulai Ulang Perangkat';
    document.getElementById('reboot-confirm').classList.remove('d-none');
    submitBtn.innerText = 'Mulai Ulang';
    submitBtn.className = 'btn btn-danger btn-sm';
  }
  actionModal.show();
}

async function pollTechWifiSsidTask(tag, taskId, verifyTaskId, attempt) {
  const maxAttempts = 72;
  if (attempt >= maxAttempts) {
    alert('ONT belum menyelesaikan verifikasi nama Wi-Fi dari ACS. Jangan kirim ulang dulu; periksa status perangkat.');
    return;
  }
  try {
    const url = '/tech/api/device/' + encodeURIComponent(tag) + '/ssid/status/' + encodeURIComponent(taskId) + '?verifyTaskId=' + encodeURIComponent(verifyTaskId);
    const response = await fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' });
    const state = await response.json();
    if (state && state.done) {
      alert(state.message || (state.success ? 'Nama Wi-Fi berhasil diverifikasi.' : 'Perubahan nama Wi-Fi belum terverifikasi.'));
      setTimeout(loadDevices, 1000);
      return;
    }
  } catch (_) { /* transient polling errors do not alter ACS task state */ }
  setTimeout(() => pollTechWifiSsidTask(tag, taskId, verifyTaskId, attempt + 1), 5000);
}

async function pollTechWifiPasswordTask(tag, taskId, attempt) {
  const maxAttempts = 72;
  if (attempt >= maxAttempts) {
    alert('ONT belum memberi jawaban ke ACS. Perubahan masih menunggu dan belum dinyatakan berhasil. Periksa status perangkat sebelum mencoba lagi.');
    return;
  }
  try {
    const response = await fetch(
      '/tech/api/device/' + encodeURIComponent(tag) + '/password/status/' + encodeURIComponent(taskId),
      { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' }
    );
    const state = await response.json();
    if (state && state.done) {
      alert(state.message || (state.success ? 'Password WiFi diterima ONT.' : 'Perubahan password WiFi gagal.'));
      setTimeout(loadDevices, 1000);
      return;
    }
  } catch (_) {
    // A temporary polling failure does not change the ACS task result.
  }
  setTimeout(() => pollTechWifiPasswordTask(tag, taskId, attempt + 1), 5000);
}

document.getElementById('btn-submit-action').addEventListener('click', async function() {
  const tag = document.getElementById('modal-device-tag').value;
  const type = document.getElementById('modal-action-type').value;
  const btn = this;
  
  let url = '';
  let body = {};
  
  if (type === 'ssid') {
    const change24 = document.getElementById('ssid-24-enabled').checked;
    const change5 = document.getElementById('ssid-5-enabled').checked;
    const ssid24 = change24 ? document.getElementById('new-ssid-24').value.trim() : '';
    const ssid5 = change5 ? document.getElementById('new-ssid-5').value.trim() : '';
    if (!change24 && !change5) return alert('Pilih minimal satu band Wi-Fi yang akan diubah.');
    if ((change24 && !ssid24) || (change5 && !ssid5)) return alert('Nama Wi-Fi pada band yang dipilih tidak boleh kosong.');
    url = `/tech/api/device/${encodeURIComponent(tag)}/ssid`;
    body = { ssid24, ssid5 };
  } else if (type === 'pass') {
    const password = document.getElementById('new-password').value.trim();
    if (password.length < 8) return alert('Kata sandi minimal 8 karakter.');
    url = `/tech/api/device/${encodeURIComponent(tag)}/password`;
    const bandGroup = document.getElementById('wifi-band-group');
    const band = bandGroup && !bandGroup.classList.contains('d-none')
      ? document.getElementById('wifi-band-select').value
      : null;
    body = band ? { password, band } : { password };
  } else if (type === 'reboot') {
    url = `/tech/api/device/${encodeURIComponent(tag)}/reboot`;
    body = {};
  }
  
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Proses...';
  
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const result = await res.json();
    
    if (result.pending && result.taskId) {
      actionModal.hide();
      alert(result.message || 'Perintah masuk antrean ACS. Menunggu ONT menerima perintah.');
      if (type === 'ssid' && result.verifyTaskId) {
        pollTechWifiSsidTask(tag, result.taskId, result.verifyTaskId, 0);
      } else {
        pollTechWifiPasswordTask(tag, result.taskId, 0);
      }
    } else if (result.success || result.ok) {
      alert(result.message || 'Perintah berhasil dikirim.');
      actionModal.hide();
      setTimeout(loadDevices, 2000);
    } else {
      alert(result.message || 'Tindakan gagal. Periksa koneksi dan coba lagi.');
    }
  } catch (e) {
    alert('Permintaan gagal. Coba lagi atau hubungi administrator.');
  } finally {
    btn.disabled = false;
    btn.innerText = 'Simpan Perubahan';
  }
});

