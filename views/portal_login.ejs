<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Pelanggan - <%= settings?.app_name || 'Intercity Network' %></title>
  <link rel="icon" href="/img/logo.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:#f5f7fa;color:#101827;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;display:flex;align-items:center;justify-content:center;padding:24px}
    .login-page{width:100%;max-width:440px}.brand{text-align:center;margin-bottom:26px}.brand img{width:68px;height:68px;object-fit:contain;margin-bottom:14px}.brand h1{font-size:24px;font-weight:800;margin:0 0 6px}.brand p{margin:0;color:#6b7280;font-size:14px}
    .login-card{background:#fff;border:1px solid #e5e7eb;border-radius:22px;padding:30px;box-shadow:0 18px 50px rgba(16,24,39,.08)}.login-icon{width:72px;height:72px;border-radius:20px;background:linear-gradient(135deg,#0052cc,#00a3e0);color:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;font-size:30px;box-shadow:0 12px 25px rgba(0,82,204,.18)}
    .login-card h2{text-align:center;font-size:21px;font-weight:800;margin:0 0 7px}.login-card .desc{text-align:center;color:#6b7280;font-size:13px;margin-bottom:24px}.form-label{font-weight:700;font-size:13px}.form-control{height:52px;border-radius:12px;border:1px solid #dfe3e8;padding:0 15px}.form-control:focus{border-color:#0052cc;box-shadow:0 0 0 4px rgba(0,82,204,.10)}.btn-login{height:52px;border:0;border-radius:12px;background:linear-gradient(135deg,#0052cc,#00a3e0);color:#fff;font-weight:800;width:100%;box-shadow:0 10px 20px rgba(0,82,204,.18)}.btn-login:hover{color:#fff;filter:brightness(.97)}.alert{border-radius:12px;font-size:13px}.back{text-align:center;margin-top:20px}.back a{color:#0052cc;text-decoration:none;font-weight:700;font-size:13px}.back a:hover{text-decoration:underline}.help{text-align:center;color:#9ca3af;font-size:12px;margin-top:18px}
  </style>
</head>
<body>
  <main class="login-page">
    <span style="display:none!important" aria-hidden="true"></span>
    <section class="login-card">
      <div class="login-icon"><i class="bi bi-person-lock"></i></div>
      <h2>Masuk ke Akun Anda</h2>
      <p class="desc">Masukkan ID/Tag pelanggan atau nomor WhatsApp yang terdaftar.</p>
      <% if (error) { %><div class="alert alert-danger mb-3"><i class="bi bi-exclamation-circle me-1"></i><%= error %></div><% } %>
      <form method="POST" action="/customer/login">
        <div class="mb-3">
          <label class="form-label" for="phone">ID / Tag Pelanggan</label>
          <input type="text" class="form-control" id="phone" name="phone" placeholder="Masukkan ID/Tag Pelanggan" required autofocus autocomplete="username">
        </div>
        <button type="submit" class="btn-login"><i class="bi bi-box-arrow-in-right me-2"></i>Masuk Portal Pelanggan</button>
      </form>
      <div class="back"><a href="/"><i class="bi bi-arrow-left me-1"></i>Kembali ke halaman utama</a></div>
      <div class="help">Akun bermasalah? Silakan hubungi Admin/Customer Service.</div>
    </section>
  </main>
</body>
</html>

<style id="hide-customer-logos">
.logo,.logo-container,.brand-logo,.navbar-brand img,.brand img,.site-logo,.app-logo,.header-logo,[class*="logo"],[id*="logo"]{display:none!important}
</style>

<style id="customer-readable-finish">
/* Global readability pass: darker text, comfortable sizes, clear controls */
body{color:#172033!important}
p,li,td,th,label,span,div{line-height:1.5}
.text-muted,.muted,.small,.form-text,.help-text,.hint,.subtitle,.description,.p-sub,.footer,.footer-text{color:#5b6472!important;opacity:1!important}
input::placeholder,textarea::placeholder{color:#7b8492!important;opacity:1!important}
input,select,textarea{color:#172033!important}
button,.btn{font-weight:700}
table th{color:#374151!important}
a{font-weight:600}
@media(max-width:576px){
 body{font-size:15px}
 p,li,td,th,label{font-size:14px}
 .small,.form-text,.help-text,.hint,.description,.p-sub{font-size:12.5px!important}
 input,select,textarea{font-size:15px!important}
 button,.btn{font-size:14px!important}
}
</style>
