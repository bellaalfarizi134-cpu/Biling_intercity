<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body, html { width: 100%; height: 100%; overflow: hidden; background: #0F172A; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #F8FAFC; }
    
    #map { width: 100%; height: 100%; z-index: 1; background: #0b1120; }
    
    /* Floating Header Card */
    .top-controls {
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 10px 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    
    .stats-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 8px;
    }
    .stat-chip {
      flex: 1;
      background: #1E293B;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 6px 8px;
      text-align: center;
    }
    .stat-chip .val { display: block; font-size: 15px; font-weight: 800; line-height: 1.2; }
    .stat-chip .lbl { display: block; font-size: 9.5px; color: #94A3B8; font-weight: 700; text-transform: uppercase; }
    .sc-odp .val { color: #F59E0B; }
    .sc-active .val { color: #38BDF8; }
    .sc-iso .val { color: #EF4444; }
    .sc-total .val { color: #4ADE80; }

    .search-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .search-wrap {
      flex: 1;
      position: relative;
    }
    .search-wrap i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748B;
      font-size: 13px;
    }
    .search-input {
      width: 100%;
      background: #1E293B;
      border: 1px solid #334155;
      color: #F8FAFC;
      border-radius: 10px;
      padding: 8px 12px 8px 32px;
      font-size: 13px;
      outline: none;
    }
    .search-input:focus {
      border-color: #38BDF8;
    }

    .filter-pills {
      display: flex;
      gap: 6px;
      margin-top: 8px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }
    .filter-pills::-webkit-scrollbar { display: none; }
    .pill-btn {
      padding: 4px 10px;
      background: #1E293B;
      border: 1px solid #334155;
      border-radius: 20px;
      color: #94A3B8;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
    }
    .pill-btn.active {
      background: #2563EB;
      border-color: #3B82F6;
      color: #FFFFFF;
    }

    /* GPS Locate Button */
    .btn-gps {
      position: absolute;
      bottom: 24px;
      right: 14px;
      z-index: 1000;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: #2563EB;
      color: #FFFFFF;
      border: none;
      box-shadow: 0 4px 15px rgba(37,99,235,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      cursor: pointer;
    }
    .btn-gps:active {
      background: #1D4ED8;
      transform: scale(0.95);
    }

    /* Map Custom Marker Icons */
    .odp-marker {
      background: #F59E0B;
      color: #000;
      border-radius: 8px;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.6);
      border: 2px solid #FFFFFF;
    }
    .onu-marker-active {
      background: #2563EB;
      color: #FFF;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      box-shadow: 0 2px 8px rgba(37,99,235,0.7);
      border: 2px solid #FFFFFF;
    }
    .onu-marker-olt-online { background:#059669 !important; box-shadow:0 0 0 3px rgba(34,197,94,.35),0 2px 8px rgba(0,0,0,.45) !important; }
    .onu-marker-olt-offline { background:#dc2626 !important; box-shadow:0 0 0 3px rgba(248,113,113,.35),0 2px 8px rgba(0,0,0,.45) !important; }
    .onu-marker-olt-unknown { background:#64748b !important; box-shadow:0 0 0 2px rgba(148,163,184,.35),0 2px 8px rgba(0,0,0,.45) !important; }
    .onu-marker-iso {
      background: #DC2626;
      color: #FFF;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      box-shadow: 0 2px 8px rgba(220,38,38,0.7);
      border: 2px solid #FFFFFF;
    }
    .marker-label-text {
      pointer-events: none;
      background: rgba(15,23,42,0.85);
      color: #F8FAFC;
      font-size: 10px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 4px;
      white-space: nowrap;
      border: 1px solid #334155;
      margin-top: 2px;
      display: inline-block;
      text-shadow: 0 1px 2px #000;
    }
    .marker-sub-label {
      pointer-events:none;
      display:block;
      width:max-content;
      max-width:190px;
      margin:1px auto 0;
      padding:0 3px;
      background:rgba(15,23,42,.88);
      color:#e2e8f0;
      font-size:8px;
      font-weight:700;
      line-height:1.2;
      border-radius:3px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      text-shadow:0 1px 2px #000;
    }

    /* Cable Line Flowing Animation */
    @keyframes cableFlow {
      from { stroke-dashoffset: 30; }
      to { stroke-dashoffset: 0; }
    }
    .flowing-cable {
      stroke-dasharray: 8, 8;
      animation: cableFlow 1.2s linear infinite;
    }

    /* Popups */
    .leaflet-popup-content-wrapper {
      background: #1E293B !important;
      color: #F8FAFC !important;
      border-radius: 16px !important;
      border: 1px solid #334155 !important;
      box-shadow: 0 10px 30px rgba(0,0,0,0.6) !important;
      padding: 0 !important;
    }
    .leaflet-popup-content {
      margin: 14px !important;
      line-height: 1.4 !important;
      font-size: 12.5px !important;
      min-width: 220px;
      max-width: 280px;
    }
    .leaflet-popup-tip {
      background: #1E293B !important;
    }
    .pop-title {
      font-size: 14px;
      font-weight: 800;
      color: #38BDF8;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pop-badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .pop-badge.active { background: #15803D; color: #DCFCE7; }
    .pop-badge.iso { background: #991B1B; color: #FEE2E2; }
    .pop-badge.olt-online { background: #15803D; color: #DCFCE7; }
    .pop-badge.olt-offline { background: #B91C1C; color: #FEE2E2; }
    .pop-badge.olt-unknown { background: #475569; color: #F1F5F9; }
    .pop-row {
      display: flex;
      justify-content: space-between;
      padding: 3px 0;
      border-bottom: 1px solid #334155;
      font-size: 11.5px;
    }
    .pop-row .lbl { color: #94A3B8; }
    .pop-row .val { color: #F8FAFC; font-weight: 600; }
    .pop-actions {
      display: flex;
      gap: 6px;
      margin-top: 10px;
    }
    .pop-btn {
      flex: 1;
      padding: 7px 10px;
      border-radius: 8px;
      font-size: 11.5px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      border: none;
      cursor: pointer;
    }
    .btn-wa { background: #16A34A; color: #FFF; }
    .btn-dir { background: #2563EB; color: #FFF; }
  </style>
</head>
<body>

  <div class="top-controls">
    <div class="stats-bar">
      <div class="stat-chip sc-odp">
        <span class="val" id="cntOdp"><%= odps.length %></span>
        <span class="lbl">ODP</span>
      </div>
      <div class="stat-chip sc-total">
        <span class="val" id="cntTotal"><%= customers.length %></span>
        <span class="lbl">Total ONU</span>
      </div>
      <div class="stat-chip sc-active">
        <span class="val" id="cntActive"><%= customers.filter(c => c.status === 'active').length %></span>
        <span class="lbl">Aktif</span>
      </div>
      <div class="stat-chip sc-iso">
        <span class="val" id="cntIso"><%= customers.filter(c => c.status !== 'active').length %></span>
        <span class="lbl">Isolir</span>
      </div>
    </div>

    <div class="search-row">
      <div class="search-wrap">
        <i class="bi bi-search"></i>
        <input type="text" id="searchInput" class="search-input" placeholder="Cari nama, PPPoE, ODP, atau alamat...">
      </div>
    </div>

    <div class="filter-pills">
      <button class="pill-btn active" data-filter="all">Semua</button>
      <button class="pill-btn" data-filter="active">🟢 Aktif (<%= customers.filter(c => c.status === 'active').length %>)</button>
      <button class="pill-btn" data-filter="isolated">🔴 Isolir (<%= customers.filter(c => c.status !== 'active').length %>)</button>
      <button class="pill-btn" data-filter="odp">🗃️ ODP Saja (<%= odps.length %>)</button>
    </div>
  </div>

  <button class="btn-gps" id="btnGps" title="Lokasi Saya">
    <i class="bi bi-crosshair"></i>
  </button>

  <div id="map"></div>

  <script id="cust-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/g, '<\\/script') %></script>
  <script id="odp-data" type="application/json"><%- JSON.stringify(odps).replace(/<\/script/g, '<\\/script') %></script>
  <script id="settings-data" type="application/json"><%- JSON.stringify(settings).replace(/<\/script/g, '<\\/script') %></script>

  <script>
    const customers = JSON.parse(document.getElementById('cust-data').textContent || '[]');
    const odps = JSON.parse(document.getElementById('odp-data').textContent || '[]');
    const settings = JSON.parse(document.getElementById('settings-data').textContent || '{}');
    const mapApiToken = <%- JSON.stringify(token || '') %>;

    function getMobileOltConnectionPresentation(cust) {
      const state = String(cust && cust.pppoe_state || 'unknown').trim().toLowerCase();
      if (state === 'online') return { label: '🟢 PPPoE ONLINE', className: 'olt-online' };
      if (state === 'offline') return { label: '🔴 PPPoE OFFLINE', className: 'olt-offline' };
      return { label: '⚪ STATUS PPPoE BELUM DIKETAHUI', className: 'olt-unknown' };
    }
    function syncMobileOltStatusPresentation(cust) {
      if (!cust) return;
      const id = Number(cust.id);
      const state = String(cust.onu_olt_status || 'unknown').toLowerCase();
      const markerElement = cust.marker && cust.marker.getElement ? cust.marker.getElement() : null;
      if (markerElement) {
        const pin = markerElement.querySelector('.onu-marker-active,.onu-marker-iso');
        if (pin) {
          pin.classList.remove('onu-marker-olt-online','onu-marker-olt-offline','onu-marker-olt-unknown');
          pin.classList.add(state === 'online' ? 'onu-marker-olt-online' : (state === 'offline' ? 'onu-marker-olt-offline' : 'onu-marker-olt-unknown'));
        }
        const markerLabel = markerElement.querySelector('.marker-label-text');
        if (markerLabel) markerLabel.textContent = String(cust.name || 'Pelanggan');
      }
      const serial = document.getElementById('mobile-map-serial-' + id);
      const status = document.getElementById('mobile-map-olt-status-' + id);
      const connectionBadge = document.getElementById('mobile-map-connection-' + id);
      const reason = document.getElementById('mobile-map-olt-reason-' + id);
      const position = document.getElementById('mobile-map-olt-position-' + id);
      const olt = document.getElementById('mobile-map-olt-name-' + id);
      const rx = document.getElementById('mobile-map-olt-rx-' + id);
      const tx = document.getElementById('mobile-map-olt-tx-' + id);
      const opticalAt = document.getElementById('mobile-map-olt-optical-at-' + id);
      if (serial) serial.textContent = cust.onu_sn || '-';
      if (status) status.textContent = cust.onu_olt_status_label || 'Status OLT belum tersedia';
      if (connectionBadge) {
        const presentation = getMobileOltConnectionPresentation(cust);
        connectionBadge.classList.remove('olt-online','olt-offline','olt-unknown');
        connectionBadge.classList.add(presentation.className);
        connectionBadge.textContent = presentation.label;
      }
      if (reason) {
        reason.textContent = cust.onu_olt_reason || '-';
        const row = reason.closest('.pop-row');
        if (row) row.style.display = cust.onu_olt_reason ? '' : 'none';
      }
      if (position) position.textContent = cust.onu_olt_pon_id != null ? 'PON ' + cust.onu_olt_pon_id + ' / ONU ' + (cust.onu_olt_onu_id ?? '-') : '-';
      if (olt) olt.textContent = cust.onu_olt_name || cust.olt_name || '-';
      if (rx) rx.textContent = formatMapOltOptical(cust.onu_olt_rx);
      if (tx) tx.textContent = formatMapOltOptical(cust.onu_olt_tx);
      if (opticalAt) opticalAt.textContent = formatMapOltOpticalTime(cust.onu_olt_optical_checked_at);
    }
    function formatMapOltOptical(value) {
      const raw = String(value == null ? '' : value).trim();
      if (!raw || /^(?:-|N\/A|N\/A dBm|null|undefined)$/i.test(raw)) return 'Belum tersedia dari OLT';
      if (/dBm/i.test(raw)) return raw;
      const number = Number(raw);
      return Number.isFinite(number) ? number.toFixed(2) + ' dBm' : raw;
    }
    function formatMapOltOpticalTime(value) {
      const date = value ? new Date(value) : null;
      return date && Number.isFinite(date.getTime()) ? 'Data OLT: ' + date.toLocaleString('id-ID') : 'Waktu pembacaan belum tersedia';
    }

    // Default center
    let centerLat = parseFloat(settings.office_lat) || -6.200000;
    let centerLng = parseFloat(settings.office_lng) || 106.816666;
    let defaultZoom = 13;

    // Center to first valid customer or ODP if available
    const firstPoint = customers.find(c => c.lat && c.lng) || odps.find(o => o.lat && o.lng);
    if (firstPoint && firstPoint.lat && firstPoint.lng) {
      centerLat = parseFloat(firstPoint.lat);
      centerLng = parseFloat(firstPoint.lng);
      defaultZoom = 14;
    }

    const map = L.map('map', { zoomControl: false }).setView([centerLat, centerLng], defaultZoom);
    L.control.zoom({ position: 'bottomleft' }).addTo(map);

    // Google Satellite (Hybrid) Layer
    const googleHybrid = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
      attribution: '© Google Satellite'
    });

    // OSM Layer
    const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    });

    googleHybrid.addTo(map);

    L.control.layers({
      "🛰️ Satelit (Google)": googleHybrid,
      "🗺️ Standar (OSM)": osm
    }, null, { position: 'topright' }).addTo(map);

    const odpLayers = L.layerGroup().addTo(map);
    const customerLayers = L.layerGroup().addTo(map);
    const cableLayers = L.layerGroup().addTo(map);

    const odpMap = {};
    odps.forEach(odp => {
      if (odp.lat && odp.lng) {
        const lat = parseFloat(odp.lat);
        const lng = parseFloat(odp.lng);
        odpMap[odp.id] = { coord: [lat, lng], name: odp.name };

        const icon = L.divIcon({
          className: 'custom-div',
          html: `
            <div style="text-align:center;">
              <div class="odp-marker"><i class="bi bi-box-seam-fill"></i></div>
              <span class="marker-label-text">${escapeHtml(odp.name)}</span>
              <span class="marker-sub-label">ODC: ${escapeHtml(odp.odc_name || '-')} · OLT: ${escapeHtml(odp.olt_name || '-')}</span>
            </div>
          `,
          iconSize: [180, 56],
          iconAnchor: [90, 22]
        });

        const marker = L.marker([lat, lng], { icon });
        const dirUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;

        marker.bindPopup(`
          <div class="pop-title"><i class="bi bi-box-seam-fill" style="color:#F59E0B"></i> ${escapeHtml(odp.name)}</div>
          <span class="pop-badge" style="background:#B45309;color:#FEF3C7">ODP DISTRIBUSI</span>
          <div class="pop-row"><span class="lbl">ODC:</span><span class="val">${escapeHtml(odp.odc_name || '-')}</span></div>
          <div class="pop-row"><span class="lbl">OLT:</span><span class="val">${escapeHtml(odp.olt_name || '-')}</span></div>
          <div class="pop-row"><span class="lbl">PON Port:</span><span class="val">${escapeHtml(odp.pon_port || '-')}</span></div>
          <div class="pop-row"><span class="lbl">Kapasitas:</span><span class="val">${odp.port_capacity || 16} Port</span></div>
          <div class="pop-row"><span class="lbl">Deskripsi:</span><span class="val">${escapeHtml(odp.description || '-')}</span></div>
          <div class="pop-actions">
            <a href="${dirUrl}" target="_blank" class="pop-btn btn-dir"><i class="bi bi-signpost-2-fill"></i> Petunjuk Arah</a>
          </div>
        `);

        odp.marker = marker;
        odpLayers.addLayer(marker);
      }
    });

    customers.forEach(cust => {
      if (cust.lat && cust.lng) {
        const lat = parseFloat(cust.lat);
        const lng = parseFloat(cust.lng);
        const isActive = cust.status === 'active';

        // Draw cable to ODP
        if (cust.odp_id && odpMap[cust.odp_id]) {
          let pathCoords = [[lat, lng], odpMap[cust.odp_id].coord];
          if (cust.cable_path) {
            try {
              const parsed = JSON.parse(cust.cable_path);
              if (Array.isArray(parsed) && parsed.length >= 2) pathCoords = parsed;
            } catch (_) {}
          }
          const polyline = L.polyline(pathCoords, {
            color: isActive ? '#38BDF8' : '#EF4444',
            weight: 3,
            opacity: 0.85,
            className: 'flowing-cable'
          });
          cust.cablePolyline = polyline;
          cableLayers.addLayer(polyline);
        }

        const oltState = String(cust.onu_olt_status || 'unknown').toLowerCase();
        const markerClass = (isActive ? 'onu-marker-active' : 'onu-marker-iso') +
          (oltState === 'online' ? ' onu-marker-olt-online' : (oltState === 'offline' ? ' onu-marker-olt-offline' : ' onu-marker-olt-unknown'));
        const iconSymbol = 'bi-router-fill';

        const icon = L.divIcon({
          className: 'custom-div',
          html: `
            <div style="text-align:center;">
              <div class="${markerClass}"><i class="bi ${iconSymbol}"></i></div>
              <span class="marker-label-text">${escapeHtml(cust.name || 'Pelanggan')}</span>
            </div>
          `,
          iconSize: [60, 42],
          iconAnchor: [30, 21]
        });

        const marker = L.marker([lat, lng], { icon });
        const cleanPhone = String(cust.phone || '').replace(/\D/g, '').replace(/^0/, '62');
        const waUrl = cleanPhone ? `https://wa.me/${cleanPhone}?text=${encodeURIComponent('Halo ' + cust.name + ', info dari admin jaringan:')}` : '#';
        const dirUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;

        marker.bindPopup(`
          <div class="pop-title"><i class="bi bi-router-fill"></i> ${escapeHtml(cust.name)}</div>
          <span class="pop-badge ${getMobileOltConnectionPresentation(cust).className}" id="mobile-map-connection-${cust.id}">${getMobileOltConnectionPresentation(cust).label}</span>
          <div class="pop-row"><span class="lbl">PPPoE User:</span><span class="val">${escapeHtml(cust.pppoe_username || '-')}</span></div>
          <div class="pop-row"><span class="lbl">No. WA / HP:</span><span class="val">${escapeHtml(cust.phone || '-')}</span></div>
          <div class="pop-row"><span class="lbl">Paket:</span><span class="val">${escapeHtml(cust.package_name || '-')}</span></div>
          <div class="pop-row"><span class="lbl">SN ONT:</span><span class="val" id="mobile-map-serial-${cust.id}">${escapeHtml(cust.onu_sn || '-')}</span></div>
          <div class="pop-row"><span class="lbl">Detail status OLT:</span><span class="val" id="mobile-map-olt-status-${cust.id}">${escapeHtml(cust.onu_olt_status_label || 'Status OLT belum tersedia')}</span></div>
          <div class="pop-row"><span class="lbl">Redaman RX OLT / TX ONT:</span><span class="val"><span id="mobile-map-olt-rx-${cust.id}">${escapeHtml(cust.onu_olt_rx || 'Belum tersedia dari OLT')}</span> / <span id="mobile-map-olt-tx-${cust.id}">${escapeHtml(cust.onu_olt_tx || 'Belum tersedia dari OLT')}</span><small id="mobile-map-olt-optical-at-${cust.id}" style="display:block;color:#64748b">${cust.onu_olt_optical_checked_at ? 'Data OLT: ' + escapeHtml(new Date(cust.onu_olt_optical_checked_at).toLocaleString('id-ID')) : 'Waktu pembacaan belum tersedia'}</small></span></div>
          <div class="pop-row" style="${cust.onu_olt_reason ? '' : 'display:none'}"><span class="lbl">Keterangan:</span><span class="val" id="mobile-map-olt-reason-${cust.id}">${escapeHtml(cust.onu_olt_reason || '-')}</span></div>
          <div class="pop-row"><span class="lbl">OLT / PON / ONU:</span><span class="val"><span id="mobile-map-olt-name-${cust.id}">${escapeHtml(cust.onu_olt_name || cust.olt_name || '-')}</span> · <span id="mobile-map-olt-position-${cust.id}">${cust.onu_olt_pon_id != null ? 'PON ' + Number(cust.onu_olt_pon_id) + ' / ONU ' + Number(cust.onu_olt_onu_id) : '-'}</span></span></div>
          <div class="pop-row"><span class="lbl">ODP / ODC:</span><span class="val">${escapeHtml(cust.odp_name || '-')} / ${escapeHtml(cust.odc_name || '-')}</span></div>
          <div class="pop-row"><span class="lbl">OLT terpetakan:</span><span class="val">${escapeHtml(cust.olt_name || '-')}</span></div>
          <div class="pop-row"><span class="lbl">Alamat:</span><span class="val">${escapeHtml(cust.address || '-')}</span></div>
          <div class="pop-actions">
            ${cleanPhone ? `<a href="${waUrl}" target="_blank" class="pop-btn btn-wa"><i class="bi bi-whatsapp"></i> Chat WA</a>` : ''}
            <a href="${dirUrl}" target="_blank" class="pop-btn btn-dir"><i class="bi bi-signpost-2-fill"></i> Navigasi</a>
          </div>
        `);

        cust.marker = marker;
        marker.on('popupopen', () => syncMobileOltStatusPresentation(cust));
        customerLayers.addLayer(marker);
      }
    });

    // Fit Bounds to all markers if exist
    const allCoords = [];
    customers.forEach(c => { if (c.lat && c.lng) allCoords.push([parseFloat(c.lat), parseFloat(c.lng)]); });
    odps.forEach(o => { if (o.lat && o.lng) allCoords.push([parseFloat(o.lat), parseFloat(o.lng)]); });
    if (allCoords.length > 0) {
      map.fitBounds(allCoords, { padding: [100, 40] });
    }

    // Search and Filter Logic
    let activeFilter = 'all';
    const searchInput = document.getElementById('searchInput');

    function applyFilterAndSearch() {
      const q = searchInput.value.trim().toLowerCase();

      let visibleCustCount = 0;
      let visibleOdpCount = 0;

      // Filter ODP
      odps.forEach(odp => {
        if (!odp.marker) return;
        const matchesQuery = !q || (odp.name && odp.name.toLowerCase().includes(q)) || (odp.description && odp.description.toLowerCase().includes(q));
        const matchesFilter = activeFilter === 'all' || activeFilter === 'odp';

        if (matchesQuery && matchesFilter) {
          if (!odpLayers.hasLayer(odp.marker)) odpLayers.addLayer(odp.marker);
          visibleOdpCount++;
        } else {
          if (odpLayers.hasLayer(odp.marker)) odpLayers.removeLayer(odp.marker);
        }
      });

      // Filter Customers
      customers.forEach(cust => {
        if (!cust.marker) return;
        const matchesQuery = !q ||
          (cust.name && cust.name.toLowerCase().includes(q)) ||
          (cust.pppoe_username && cust.pppoe_username.toLowerCase().includes(q)) ||
          (cust.phone && cust.phone.includes(q)) ||
          (cust.address && cust.address.toLowerCase().includes(q)) ||
          (cust.onu_sn && cust.onu_sn.toLowerCase().includes(q)) ||
          (cust.onu_olt_status_label && cust.onu_olt_status_label.toLowerCase().includes(q)) ||
          (cust.odp_name && cust.odp_name.toLowerCase().includes(q)) ||
          (cust.odc_name && cust.odc_name.toLowerCase().includes(q)) ||
          (cust.olt_name && cust.olt_name.toLowerCase().includes(q));

        const isActive = cust.status === 'active';
        let matchesFilter = false;
        if (activeFilter === 'all') matchesFilter = true;
        else if (activeFilter === 'active' && isActive) matchesFilter = true;
        else if (activeFilter === 'isolated' && !isActive) matchesFilter = true;
        else if (activeFilter === 'odp') matchesFilter = false;

        if (matchesQuery && matchesFilter) {
          if (!customerLayers.hasLayer(cust.marker)) customerLayers.addLayer(cust.marker);
          if (cust.cablePolyline && !cableLayers.hasLayer(cust.cablePolyline)) cableLayers.addLayer(cust.cablePolyline);
          visibleCustCount++;
        } else {
          if (customerLayers.hasLayer(cust.marker)) customerLayers.removeLayer(cust.marker);
          if (cust.cablePolyline && cableLayers.hasLayer(cust.cablePolyline)) cableLayers.removeLayer(cust.cablePolyline);
        }
      });
    }

    searchInput.addEventListener('input', applyFilterAndSearch);

    document.querySelectorAll('.pill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilter = btn.getAttribute('data-filter');
        applyFilterAndSearch();
      });
    });

    // Status PPPoE berasal dari sesi /ppp/active MikroTik, bukan status billing.
    // Pembaruan hanya mengubah label popup, tanpa memuat ulang peta/GPS/kamera.
    let pppoeStatusRefreshInFlight = false;
    async function refreshMapPppoeStatus() {
      if (!mapApiToken || pppoeStatusRefreshInFlight) return;
      pppoeStatusRefreshInFlight = true;
      try {
        const response = await fetch('/api/customer/app/map/pppoe-status', {
          headers: { Authorization: 'Bearer ' + mapApiToken }, cache: 'no-store'
        });
        const payload = await response.json();
        if (!response.ok || !payload || !payload.success) return;
        customers.forEach(cust => {
          const item = (payload.customers || {})[String(Number(cust.id))];
          cust.pppoe_state = item && ['online','offline','unknown'].includes(item.pppoeState) ? item.pppoeState : 'unknown';
          syncMobileOltStatusPresentation(cust);
        });
        const checkedLabel = document.getElementById('oltStatusChecked');
        if (checkedLabel) checkedLabel.textContent = payload.checkedAt
          ? 'Status PPPoE diperbarui ' + new Date(payload.checkedAt).toLocaleTimeString('id-ID')
          : 'Status PPPoE belum tersedia';
      } catch (_) {
        // Biarkan peta terbuka jika status PPPoE belum bisa dibaca.
      } finally {
        pppoeStatusRefreshInFlight = false;
      }
    }
    refreshMapPppoeStatus();
    setInterval(refreshMapPppoeStatus, 20000);

    // Status ONT hanya dari inventaris OLT; pembaruan tidak memuat ulang peta, marker, GPS, atau kamera.
    let oltStatusRefreshInFlight = false;
    async function refreshMapOltStatus() {
      if (!mapApiToken || oltStatusRefreshInFlight) return;
      oltStatusRefreshInFlight = true;
      try {
        const response = await fetch('/api/customer/app/map/olt-status', {
          headers: { Authorization: 'Bearer ' + mapApiToken }, cache: 'no-store'
        });
        const payload = await response.json();
        if (!response.ok || !payload || !payload.success) return;
        const bySerial = new Map((Array.isArray(payload.olt_statuses) ? payload.olt_statuses : [])
          .map(row => [String(row.serial_key || String(row.serial_number || '').replace(/[^A-Z0-9]/gi, '')).toUpperCase(), row]));
        const checked = Boolean(payload.olt_status_checked_at);
        customers.forEach(cust => {
          const key = String(cust.onu_sn || '').replace(/[^A-Z0-9]/gi, '').toUpperCase();
          const row = key ? bySerial.get(key) : null;
          if (row) {
            cust.onu_olt_status = String(row.status || 'Unknown').toLowerCase();
            cust.onu_olt_status_label = row.status === 'Online' ? 'ONLINE di OLT' : (row.status === 'Offline' ? 'OFFLINE di OLT' : 'Status OLT belum pasti');
            cust.onu_olt_reason = row.status === 'Offline'
              ? (String(row.offline_reason || '').trim() || 'OLT tidak memberikan sebab khusus. Periksa alarm LOS/RX optik dan daya ONT.')
              : '';
            cust.onu_olt_checked_at = row.checked_at || '';
            cust.onu_olt_pon_id = row.pon_id == null ? null : Number(row.pon_id);
            cust.onu_olt_onu_id = row.onu_id == null ? null : Number(row.onu_id);
            cust.onu_olt_name = row.olt_name || '';
            cust.onu_olt_rx = String(row.rx != null ? row.rx : (cust.onu_olt_rx || ''));
            cust.onu_olt_tx = String(row.tx != null ? row.tx : (cust.onu_olt_tx || ''));
            cust.onu_olt_optical_checked_at = String(row.optical_checked_at || cust.onu_olt_optical_checked_at || '');
          } else {
            cust.onu_olt_status = 'unknown';
            cust.onu_olt_status_label = cust.onu_sn_match_status === 'ambiguous' ? 'SN belum pasti' :
              (cust.onu_sn ? (checked ? 'SN tidak ditemukan di inventaris OLT' : 'Menunggu pembacaan status OLT') : 'SN belum tersedia');
            cust.onu_olt_reason = cust.onu_sn_match_status === 'ambiguous'
              ? 'Username PPPoE cocok ke beberapa serial ACS; perlu verifikasi SN.'
              : (cust.onu_sn && checked ? 'SN tidak ditemukan pada inventaris OLT terakhir; ini bukan bukti bahwa ONT mati.' : '');
            cust.onu_olt_pon_id = null;
            cust.onu_olt_onu_id = null;
            cust.onu_olt_name = '';
          }
          syncMobileOltStatusPresentation(cust);
        });
        if (searchInput.value.trim()) applyFilterAndSearch();
        const checkedLabel = document.getElementById('oltStatusChecked');
        if (checkedLabel) checkedLabel.textContent = payload.olt_status_checked_at
          ? 'Status OLT diperbarui ' + new Date(payload.olt_status_checked_at).toLocaleTimeString('id-ID')
          : 'Status OLT menunggu pembacaan inventaris';
      } catch (_) {
        // Jangan mengganggu geser peta jika status jaringan sedang tidak tersedia.
      } finally {
        oltStatusRefreshInFlight = false;
      }
    }
    setInterval(refreshMapOltStatus, 20000);

    // GPS User Location
    let userLocMarker = null;
    document.getElementById('btnGps').addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert("Perangkat tidak mendukung geolokasi.");
        return;
      }
      navigator.geolocation.getCurrentPosition(
        pos => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          if (userLocMarker) map.removeLayer(userLocMarker);
          userLocMarker = L.circleMarker([lat, lng], {
            radius: 9,
            color: '#FFFFFF',
            weight: 3,
            fillColor: '#2563EB',
            fillOpacity: 1
          }).addTo(map);
          userLocMarker.bindPopup("<b>📍 Lokasi Anda Saat Ini</b>").openPopup();
          map.setView([lat, lng], 17);
        },
        err => {
          alert("Gagal membaca sinyal GPS: " + err.message);
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });

    function escapeHtml(text) {
      if (!text) return '';
      return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  </script>
</body>
</html>
