  function inferProvisionVendor(serial) {
    const prefix = String(serial || '').trim().toUpperCase().slice(0, 4);
    const vendors = {
      FHTT: 'FIBERHOME', ZTEG: 'ZTE', HWTC: 'HUAWEI', ALCL: 'NOKIA',
      CMHI: 'CMHI', ZXIC: 'ZXIC', ZION: 'ZIONCOM', ZIONCOM: 'ZIONCOM',
      RTEG: 'RTEG', ZICG: 'ZICG', CMDC: 'CMDC'
    };
    return vendors[prefix] || 'OTHER';
  }

