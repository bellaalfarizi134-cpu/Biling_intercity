              <!-- DEFAULT BANK TRANSFER -->
              <button class="btn btn-outline-light p-3 text-start d-flex align-items-center justify-content-between" onclick="submitPayment('bank_transfer')" style="border-radius:16px; border:1px solid rgba(16,185,129,0.4); background:linear-gradient(135deg, rgba(16,185,129,0.15) 0%, rgba(30,41,59,0.8) 100%);">
