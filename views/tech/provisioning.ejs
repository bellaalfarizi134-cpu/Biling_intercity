          snInput.dispatchEvent(new Event('input', { bubbles: true }));
          locationBox.textContent = 'PON ' + onu.pon + (onu.suggestedOnuId ? ' · ONU ID ' + onu.suggestedOnuId : ' · ONU ID belum dapat ditentukan otomatis');
