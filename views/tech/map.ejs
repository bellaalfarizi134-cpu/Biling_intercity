      });

      topologyLinks.forEach(link => {
        const line = link._leafletLine;
        if (!line) return;
        if (link.segment_type === 'odp-odc') {
          const summary = (payload.odps || {})[String(link.source_id)];
          const hasOnlineCustomer = summary && Number(summary.onlineCount) > 0;
          const allMappedConfirmedOffline = summary && Number(summary.offlineCount) > 0 && Number(summary.onlineCount) === 0 && Number(summary.unknownCount) === 0;
          if (hasOnlineCustomer) {
