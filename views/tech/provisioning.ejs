              repairForm.appendChild(repairButton); resultBox.appendChild(repairForm);
            });
          } else {
            empty.textContent = 'Tidak ditemukan ONU baru pada port PON 1–' + (Number(data.maxPon) || 8) + '. Periksa daya ONT, konektor fiber, dan koneksi OLT, lalu coba pindai kembali.';
