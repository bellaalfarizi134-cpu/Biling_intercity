  body.tech-dashboard .isp-tech-active { display:inline-flex; align-items:center; gap:5px; padding:5px 9px; border-radius:20px; background:#e8f8ef; color:#087b51; font-size:10px; font-weight:800; white-space:nowrap; }
  body.tech-dashboard .isp-tech-active i { width:6px; height:6px; border-radius:50%; background:#19b873; }
  body.tech-dashboard .isp-guide-only { margin-top:18px; }
  body.tech-dashboard .isp-guide-card { display:flex; align-items:center; gap:12px; min-height:82px; padding:15px; border:1px solid #e5ebf4; border-radius:16px; background:#fff; box-shadow:0 5px 15px rgba(25,57,98,.045); text-decoration:none; color:#203754; }
