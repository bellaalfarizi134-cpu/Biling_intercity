          </li>
          <li class="nav-item">
            <a class="nav-link" href="#features"><i class="bi bi-shield-check me-1"></i> Keunggulan</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#services"><i class="bi bi-grid me-1"></i> Layanan Cepat</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#contact-info"><i class="bi bi-headset me-1"></i> Informasi</a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
          <button type="button" id="btn-install-pwa-nav" class="btn btn-sm rounded-3 px-3 py-2 fw-bold d-inline-flex align-items-center shadow-sm apk-download-white" onclick="openPwaInstallPopup()">
            <i class="bi bi-download me-1"></i> Download APK
          </button>
          <a href="/customer/check-billing" class="btn btn-outline-light btn-sm rounded-3 px-3 py-2">
            <i class="bi bi-receipt me-1"></i> Cek Tagihan
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section - exact reference layout -->
  <section class="hero-section reference-hero" id="hero">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-7">
          <div class="hero-badge"><i class="bi bi-lightning-charge-fill"></i><span>Konektivitas Fiber Optic Profesional</span></div>
          <h1 class="hero-title">Koneksi Andal untuk Rumah, Bisnis, dan Aktivitas Digital Anda.</h1>
          <p class="hero-subtitle">Nikmati konektivitas fiber optic yang cepat dan stabil, didukung layanan pelanggan yang responsif serta portal mandiri untuk mengelola kebutuhan internet Anda dengan lebih mudah.</p>
          <div class="hero-actions-ref hero-actions-grid">
            <a href="/customer/register" class="ref-btn ref-btn-primary"><i class="bi bi-person-plus-fill"></i> Daftar</a>
            <a href="/customer/login" class="ref-btn ref-btn-primary"><i class="bi bi-box-arrow-in-right"></i> Portal Pelanggan</a>
            <a href="/customer/check-billing" class="ref-btn ref-btn-outline"><i class="bi bi-receipt"></i> Cek Tagihan</a>
            <a href="#packages" class="ref-btn ref-btn-outline"><i class="bi bi-wifi"></i> Lihat Paket</a>
          </div>
        </div>
        <div class="col-lg-5">
          <% const heroPromos = (typeof promos !== 'undefined' && Array.isArray(promos)) ? promos : []; %>
          <% if (heroPromos.length > 0) { %>
          <div class="hero-promo-wrap">
            <div class="hero-promo-label"><i class="bi bi-megaphone-fill"></i> Promo & Penawaran</div>
            <div id="homePromoCarousel" class="carousel slide hero-promo-carousel" data-bs-ride="carousel" data-bs-interval="5000">
              <% if (heroPromos.length > 1) { %>
              <div class="carousel-indicators">
                <% heroPromos.forEach((promo, index) => { %>
                  <button type="button" data-bs-target="#homePromoCarousel" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-label="Promo <%= index + 1 %>"></button>
                <% }); %>
              </div>
              <% } %>
              <div class="carousel-inner">
                <% heroPromos.forEach((promo, index) => { %>
                  <% const promoUrl = String(promo.url || '').trim(); %>
                  <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                    <% if (promoUrl) { %><a class="hero-promo-card" href="<%= promoUrl %>" <%= Number(promo.open_in_new_tab) ? 'target="_blank" rel="noopener"' : '' %>><% } else { %><div class="hero-promo-card"><% } %>
                      <img src="<%= promo.image_path %>" alt="<%= promo.title || 'Promo Intercity Network' %>" loading="eager">
                      <% if (promo.title || promo.description) { %>
                      <div class="hero-promo-caption">
                        <% if (promo.title) { %><h3><%= promo.title %></h3><% } %>
                        <% if (promo.description) { %><p><%= promo.description %></p><% } %>
                      </div>
                      <% } %>
                    <% if (promoUrl) { %></a><% } else { %></div><% } %>
                  </div>
                <% }); %>
              </div>
              <% if (heroPromos.length > 1) { %>
              <button class="carousel-control-prev" type="button" data-bs-target="#homePromoCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span><span class="visually-hidden">Sebelumnya</span></button>
              <button class="carousel-control-next" type="button" data-bs-target="#homePromoCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span><span class="visually-hidden">Berikutnya</span></button>
              <% } %>
            </div>
          </div>
          <% } else { %>
          <div class="reference-visual">
            <div class="reference-visual-card">
              <div class="reference-network-icon"><i class="bi bi-wifi"></i></div>
              <h3>Internet Fiber Optic</h3>
              <p>Akses internet cepat, stabil, dan siap untuk kebutuhan rumah serta bisnis Anda.</p>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- Internet Packages Section -->
  <section class="section-padding" id="packages">
    <div class="container">
      <div class="text-center">
        <span class="section-title-badge"><i class="bi bi-wifi me-1"></i> Pilihan Layanan Internet</span>
        <h2 class="section-title">Paket Layanan untuk Kebutuhan Anda</h2>
        <p class="section-subtitle">
          Temukan paket koneksi yang sesuai untuk kebutuhan rumah, keluarga, usaha, hingga aktivitas digital dengan pilihan layanan yang transparan.
        </p>
      </div>

      <% const pkgs = (typeof packages !== 'undefined' && Array.isArray(packages)) ? packages : []; %>
      <% if (pkgs.length === 0) { %>
        <div class="glass-card text-center p-5 max-w-lg mx-auto">
          <i class="bi bi-info-circle fs-1 text-info mb-3 d-block"></i>
          <h5 class="fw-bold text-white">Paket Layanan Belum Tersedia</h5>
          <p class="text-muted mb-0">Hubungi tim layanan pelanggan kami untuk mendapatkan informasi paket dan ketersediaan layanan terbaru.</p>
        </div>
      <% } else { %>
        <% const list = pkgs.slice().sort((a,b) => Number(a.price||0) - Number(b.price||0)); %>
        <div class="row g-4 justify-content-center">
          <% list.forEach((p, index) => { %>
            <div class="col-md-6 col-lg-4">
              <div class="glass-card pkg-card">
                <% if (index === Math.floor(list.length / 2)) { %>
                  <div class="pkg-badge-popular"><i class="bi bi-star-fill me-1"></i> Terpopuler</div>
                <% } %>

                <div class="pkg-speed-tag">
                  <i class="bi bi-speedometer2 me-1"></i>
                  <% if (Number(p.speed_down||0) > 0) { %>
                    <%= (Math.round(Number(p.speed_down||0)/1000) >= 1) ? Math.round(Number(p.speed_down||0)/1000) + ' Mbps' : Number(p.speed_down||0) + ' Kbps' %>
                  <% } else { %>
                    Speed High-Speed
                  <% } %>
                </div>

                <h3 class="pkg-name"><%= p.name %></h3>

                <div class="pkg-price">
                  Rp <%= Number(p.price||0).toLocaleString('id-ID') %>
                </div>
                <div class="pkg-period">per bulan (sudah termasuk PPN)</div>

