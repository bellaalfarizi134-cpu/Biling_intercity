            note.className += ' text-warning-emphasis';
            note.textContent += ' Aktivasi dinonaktifkan sementara agar tidak menggunakan ONU ID yang mungkin sudah terpakai.';
          }
        }
        if (!detectedSnSelect) throw new Error('Kolom pemilihan SN tidak tersedia. Muat ulang halaman.');
        data.found.forEach(function (onu, index) {
          const option = document.createElement('option');
          option.value = String(index);
          const vendor = inferProvisionVendor(onu.sn);
          const model = onu.model && onu.model !== 'Unknown' ? ' · ' + onu.model : '';
          option.textContent = onu.sn + ' · ' + vendor + ' · PON ' + onu.pon + model;
          detectedSnSelect.appendChild(option);
        });
        detectedSnSelect.hidden = false;
        if (manuallyEnteredSn) {
          const matchingIndex = data.found.findIndex(function (onu) {
            return String(onu.sn || '').trim().toUpperCase() === manuallyEnteredSn;
          });
          if (matchingIndex >= 0) {
            detectedSnSelect.value = String(matchingIndex);
            choose(data.found[matchingIndex]);
          } else {
            const manualNotice = document.createElement('div');
            manualNotice.className = 'small text-warning-emphasis mt-2';
            manualNotice.textContent = 'SN yang dimasukkan belum ditemukan sebagai ONT baru pada hasil OLT. Periksa SN, atau pastikan ONT belum terdaftar.';
            resultBox.appendChild(manualNotice);
          }
        }
        detectedSnSelect.onchange = function () {
          const index = Number(detectedSnSelect.value);
          if (Number.isInteger(index) && data.found[index]) choose(data.found[index]);
        };
        if (data.found.length === 1 && (!manuallyEnteredSn || String(data.found[0].sn || '').trim().toUpperCase() === manuallyEnteredSn)) {
          detectedSnSelect.value = '0';
          choose(data.found[0]);
        }
      } catch (error) {
        resultBox.textContent = error.message || 'Pemindaian ONU gagal. Periksa koneksi ke OLT lalu coba lagi.';
        locationBox.textContent = 'Pemindaian belum berhasil. Silakan coba kembali.';
      } finally {
        button.disabled = false;
      }
    });
  });

  document.querySelectorAll('.provision-profile-form').forEach(function (profileForm) {
    const oltSelect = profileForm.querySelector('.js-customer-olt');
    const odpSelect = profileForm.querySelector('.js-customer-odp');
    const latInput = profileForm.querySelector('[name="lat"]');
    const lngInput = profileForm.querySelector('[name="lng"]');
    const gpsButton = profileForm.querySelector('.js-get-customer-point');
    const distanceStatus = profileForm.querySelector('.js-customer-odp-distance');
    function distanceMetersBetween(lat1, lng1, lat2, lng2) {
      const rad = value => value * Math.PI / 180;
      const dLat = rad(lat2 - lat1), dLng = rad(lng2 - lng1);
      const a = Math.sin(dLat / 2) ** 2 + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(dLng / 2) ** 2;
      return 6371000 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(Math.max(0, 1 - a)));
    }
    function filterOdpOptions() {
      const oltId = String(oltSelect.value || '');
      const latText = String(latInput.value || '').trim(), lngText = String(lngInput.value || '').trim();
      const lat = Number(latText), lng = Number(lngText);
      const customerCoordsValid = latText !== '' && lngText !== '' && Number.isFinite(lat) && Number.isFinite(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
      let selectedStillValid = false;
      Array.from(odpSelect.options).forEach(function (option, index) {
        if (index === 0) return;
        const linkedOlt = String(option.dataset.oltId || '');
        const sameOlt = !oltId || !linkedOlt || linkedOlt === oltId;
        const baseLabel = String(option.dataset.baseLabel || option.textContent || '');
        option.textContent = baseLabel;
        option.title = '';
        option.hidden = !sameOlt;
        option.disabled = !sameOlt;
        if (!sameOlt) return;

        const odpLatText = String(option.dataset.lat || '').trim(), odpLngText = String(option.dataset.lng || '').trim();
        const odpLat = Number(odpLatText), odpLng = Number(odpLngText);
        const odpCoordsValid = odpLatText !== '' && odpLngText !== '' && Number.isFinite(odpLat) && Number.isFinite(odpLng) && odpLat >= -90 && odpLat <= 90 && odpLng >= -180 && odpLng <= 180;
        if (!odpCoordsValid) {
          option.disabled = true;
          option.textContent = baseLabel + ' · GPS ODP belum tersedia';
          option.title = 'ODP tidak bisa dipilih sebelum koordinat GPS-nya dilengkapi.';
          return;
        }
        if (customerCoordsValid) {
          const distance = distanceMetersBetween(lat, lng, odpLat, odpLng);
          const tooFar = !Number.isFinite(distance) || distance > 200 + 1e-6;
          option.textContent = baseLabel + ' · ' + Math.round(distance) + ' m' + (tooFar ? ' (di luar 200 m — pilih ODP lain)' : '');
          option.title = tooFar ? 'Jarak lebih dari 200 meter. Pilih ODP lain yang lebih dekat.' : 'Jarak ' + Math.round(distance) + ' meter; memenuhi batas 200 meter.';
          option.disabled = tooFar;
        } else {
          option.disabled = false;
        }
        if (option.selected && !option.disabled) selectedStillValid = true;
      });
      if (!selectedStillValid && odpSelect.value) odpSelect.value = '';

      if (!distanceStatus) return;
      if (!customerCoordsValid) {
        distanceStatus.textContent = 'Ambil GPS di lokasi pelanggan sebelum menyimpan. Batas pelanggan ke ODP maksimal 200 meter.';
        distanceStatus.className = 'form-text js-customer-odp-distance mb-2 text-warning';
        return;
      }
      const selected = odpSelect.options[odpSelect.selectedIndex];
      if (!selected || !selected.value) {
        distanceStatus.textContent = 'Pilih ODP dengan koordinat GPS dalam jarak maksimal 200 meter dari pelanggan.';
        distanceStatus.className = 'form-text js-customer-odp-distance mb-2 text-danger';
        return;
      }
      const odpLatText = String(selected.dataset.lat || '').trim(), odpLngText = String(selected.dataset.lng || '').trim();
      const odpLat = Number(odpLatText), odpLng = Number(odpLngText);
      if (!odpLatText || !odpLngText || !Number.isFinite(odpLat) || !Number.isFinite(odpLng)) {
        distanceStatus.textContent = 'GPS ODP belum tersedia. Pilih ODP lain yang koordinatnya sudah lengkap.';
        distanceStatus.className = 'form-text js-customer-odp-distance mb-2 text-danger';
        return;
      }
      const distance = distanceMetersBetween(lat, lng, odpLat, odpLng);
      if (!Number.isFinite(distance) || distance > 200 + 1e-6) {
        distanceStatus.textContent = 'Jarak sekitar ' + Math.round(distance) + ' meter. Maksimal 200 meter; cari dan pilih ODP lain yang lebih dekat.';
        distanceStatus.className = 'form-text js-customer-odp-distance mb-2 text-danger';
        return;
      }
      distanceStatus.textContent = 'Jarak pelanggan ke ODP ' + Math.round(distance) + ' m — memenuhi batas 200 m.';
      distanceStatus.className = 'form-text js-customer-odp-distance mb-2 text-success';
    }
    oltSelect.addEventListener('change', filterOdpOptions);
    odpSelect.addEventListener('change', filterOdpOptions);
    latInput.addEventListener('input', filterOdpOptions);
    lngInput.addEventListener('input', filterOdpOptions);
    latInput.addEventListener('change', filterOdpOptions);
    lngInput.addEventListener('change', filterOdpOptions);
    profileForm.addEventListener('submit', function (event) {
      filterOdpOptions();
      const latText = String(latInput.value || '').trim(), lngText = String(lngInput.value || '').trim();
      const selected = odpSelect.options[odpSelect.selectedIndex];
      const odpLatText = String(selected && selected.dataset.lat || '').trim(), odpLngText = String(selected && selected.dataset.lng || '').trim();
      const lat = Number(latText), lng = Number(lngText), odpLat = Number(odpLatText), odpLng = Number(odpLngText);
      const coordsValid = latText !== '' && lngText !== '' && Number.isFinite(lat) && Number.isFinite(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
      const odpCoordsValid = odpLatText !== '' && odpLngText !== '' && Number.isFinite(odpLat) && Number.isFinite(odpLng) && odpLat >= -90 && odpLat <= 90 && odpLng >= -180 && odpLng <= 180;
      const distance = coordsValid && odpCoordsValid ? distanceMetersBetween(lat, lng, odpLat, odpLng) : Infinity;
      if (!selected || !selected.value || selected.disabled || !coordsValid || !odpCoordsValid || !Number.isFinite(distance) || distance > 200 + 1e-6) {
        event.preventDefault();
        event.stopImmediatePropagation();
        alert('Simpan gagal: GPS pelanggan dan ODP harus tersedia, dan jarak maksimal 200 meter. Cari ODP lain yang lebih dekat.');
      }
    });
    filterOdpOptions();
    gpsButton.addEventListener('click', function () {
      if (!navigator.geolocation) { alert('GPS tidak didukung perangkat ini. Isi koordinat secara manual.'); return; }
      gpsButton.disabled = true;
      gpsButton.textContent = 'Mengambil lokasi GPS...';
      navigator.geolocation.getCurrentPosition(function (position) {
        latInput.value = position.coords.latitude.toFixed(7);
        lngInput.value = position.coords.longitude.toFixed(7);
        latInput.dispatchEvent(new Event('input', { bubbles: true }));
        lngInput.dispatchEvent(new Event('input', { bubbles: true }));
        filterOdpOptions();
        gpsButton.disabled = false;
        gpsButton.innerHTML = '<i class="bi bi-check-circle me-1"></i>Titik GPS berhasil diambil';
      }, function (error) {
        gpsButton.disabled = false;
        gpsButton.innerHTML = '<i class="bi bi-crosshair me-1"></i>Ambil Lokasi GPS';
        alert('Lokasi tidak berhasil diambil: ' + (error.message || 'Periksa izin lokasi dan coba lagi.'));
      }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
    });
  });

  // Also close already-persisted manual-binding tasks when the queue is reopened.
  // This covers the case where the technician cannot use the card's manual close button.
  let autoClosingManualTasks = false;
  async function autoCloseExistingManualTasks() {
    if (autoClosingManualTasks) return;
    autoClosingManualTasks = true;
    const cards = Array.from(document.querySelectorAll('.provision-job[data-job-status="bound_manual"]'));
    let closedAny = false;
    for (const card of cards) {
      const customerId = String(card.dataset.customerId || '').trim();
      if (!customerId) continue;
      try {
        const response = await fetch('/tech/provisioning/' + encodeURIComponent(customerId) + '/ack-manual', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          credentials: 'same-origin',
          cache: 'no-store'
        });
        let result = {};
        try { result = await response.json(); } catch (_) {}
        if (response.ok && result.success) closedAny = true;
        else console.warn('[TECH PROVISIONING] auto-close manual task gagal:', customerId, result.message || response.status);
      } catch (error) {
        console.warn('[TECH PROVISIONING] auto-close manual task gagal:', customerId, error);
      }
    }
    autoClosingManualTasks = false;
    if (closedAny) window.location.reload();
  }
  autoCloseExistingManualTasks();

})();
</script>

