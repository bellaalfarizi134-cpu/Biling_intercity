  <%- include('partials/customer_bottom_nav', { activeNav: 'home' }) %>

  <!-- JAVASCRIPT HANDLERS -->
  <script>
    let currentInvId = null;
    let pModal = null;

    function openSpeedtest() {
      // Speedtest lokal Intercity: pelanggan -> MikroTik -> server portal.
      window.location.href = '/speedtest/';
    }

    function upgradeSpeed() {
      const el = document.getElementById('upgradeSpeedModal');
      if (!el) return;
      new bootstrap.Modal(el).show();
      setTimeout(initUpgradePackagePicker, 50);
    }

    function initUpgradePackagePicker() {
      const modal = document.getElementById('upgradeSpeedModal');
      if (!modal || modal.dataset.pickerReady === '1') return;
      modal.dataset.pickerReady = '1';
      const selected = document.getElementById('upgradeSelectedPackage');
      const message = document.getElementById('upgradeMessage');
      const radios = modal.querySelectorAll('input[name="upgrade_package_id"]');
      const update = (radio) => {
        if (!radio) return;
        const name = radio.dataset.packageName || 'Paket Internet';
        const price = Number(radio.dataset.price || 0).toLocaleString('id-ID');
        const down = radio.dataset.down || '-';
        const up = radio.dataset.up || '-';
        if (selected) selected.value = name + ' — ' + down + ' Mbps download / ' + up + ' Mbps upload — Rp ' + price + '/bulan';
        if (message && !message.value.trim()) {
          message.value = 'Saya ingin upgrade ke paket ' + name + ' (' + down + ' Mbps download / ' + up + ' Mbps upload), harga Rp ' + price + '/bulan.';
        }
        radios.forEach(r => {
          const box = r.nextElementSibling;
          if (box) {
            box.style.borderColor = r.checked ? '#0d6efd' : '#dbe7f3';
            box.style.background = r.checked ? '#eef6ff' : '#fff';
          }
        });
      };
      radios.forEach(r => r.addEventListener('change', () => update(r)));
      const checked = modal.querySelector('input[name="upgrade_package_id"]:checked');
      if (checked) update(checked);
    }

    function openPaymentModal(invId, amount) {
      currentInvId = invId;
      let num = 0;
      if (typeof amount === 'number') {
        num = isNaN(amount) ? 0 : amount;
      } else if (amount) {
        const clean = String(amount).replace(/[^0-9.]/g, '');
        num = parseFloat(clean) || 0;
      }
      document.getElementById('pay_amount_text').innerText = 'Rp ' + Math.round(num).toLocaleString('id-ID');
      if (!pModal) pModal = new bootstrap.Modal(document.getElementById('paymentModal'));
      pModal.show();
    }

    function submitPayment(method) {
      if (!currentInvId) return;
      window.location.href = `/customer/payment/create/${currentInvId}?method=${method}`;
    }

    function togglePassVisibility() {
      const input = document.getElementById('wifiPassInput');
      const icon = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
      } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
      }
    }

    function openNotifDrawer() {
      const modal = new bootstrap.Modal(document.getElementById('notifDrawerModal'));
      modal.show();
    }

    function editSsid(deviceId, currentSsid) {
      document.getElementById('modalSsidInput').value = currentSsid || '';
      const m = new bootstrap.Modal(document.getElementById('editSsidModal'));
      m.show();
    }

    function editPassword(deviceId) {
      document.getElementById('modalPassInput').value = '';
      const m = new bootstrap.Modal(document.getElementById('editPasswordModal'));
      m.show();
    }

    function rebootDevice(deviceId) {
      const m = new bootstrap.Modal(document.getElementById('rebootModal'));
      m.show();
    }

    // LIVE TRAFFIC GAUGES CANVAS
    function drawGauge(canvasId, valueMbps, maxMbps, strokeColor) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h - 20;
      const radius = 75;

      ctx.clearRect(0, 0, w, h);

      // Track Arc (180 deg)
      ctx.beginPath();
      ctx.arc(cx, cy, radius, Math.PI, 2 * Math.PI, false);
      ctx.lineWidth = 14;
      ctx.strokeStyle = 'rgba(30, 41, 59, 0.8)';
      ctx.lineCap = 'round';
      ctx.stroke();

      // Progress Arc
      const val = Math.min(Math.max(0, valueMbps), maxMbps);
      const ratio = maxMbps > 0 ? val / maxMbps : 0;
      const endAngle = Math.PI + ratio * Math.PI;

      if (ratio > 0) {
        ctx.beginPath();
        ctx.arc(cx, cy, radius, Math.PI, endAngle, false);
        ctx.lineWidth = 14;
        ctx.strokeStyle = strokeColor;
        ctx.lineCap = 'round';
        ctx.stroke();
      }
    }

    let customerTrafficFetchInFlight = false;
    async function fetchTrafficData() {
      if (customerTrafficFetchInFlight) return;
      customerTrafficFetchInFlight = true;
      try {
        const res = await fetch('/customer/api/pppoe-traffic', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();

        const rxGauge = document.getElementById('pppoe_rx_gauge');
        const txGauge = document.getElementById('pppoe_tx_gauge');

        const maxDown = parseFloat(rxGauge?.dataset?.max) || 10;
        const maxUp = parseFloat(txGauge?.dataset?.max) || 10;

        const rx = parseFloat(data.rxMbps || data.rx_rate || 0) || 0;
        const tx = parseFloat(data.txMbps || data.tx_rate || 0) || 0;

        const rxValEl = document.getElementById('pppoe_rx_value');
        const rxUnitEl = document.getElementById('pppoe_rx_unit');
        if (rxValEl) rxValEl.innerText = rx < 0.1 ? (rx * 1000).toFixed(0) : rx.toFixed(2);
        if (rxUnitEl) rxUnitEl.innerText = rx < 0.1 ? 'Kbps' : 'Mbps';

        const txValEl = document.getElementById('pppoe_tx_value');
        const txUnitEl = document.getElementById('pppoe_tx_unit');
        if (txValEl) txValEl.innerText = tx < 0.1 ? (tx * 1000).toFixed(0) : tx.toFixed(2);
        if (txUnitEl) txUnitEl.innerText = tx < 0.1 ? 'Kbps' : 'Mbps';

        drawGauge('pppoe_rx_gauge', rx, maxDown, '#06b6d4');
        drawGauge('pppoe_tx_gauge', tx, maxUp, '#10b981');
      } catch (e) {
        console.error('[Traffic] Fetch error:', e);
      } finally {
        customerTrafficFetchInFlight = false;
      }
    }

    function formatUsageBytes(bytes) {
      const n = Number(bytes || 0);
      if (!Number.isFinite(n) || n <= 0) return '0 B';
      const units = ['B','KB','MB','GB','TB'];
      const i = Math.min(Math.floor(Math.log(n) / Math.log(1024)), units.length - 1);
      const value = n / Math.pow(1024, i);
      return `${value >= 100 ? value.toFixed(0) : value >= 10 ? value.toFixed(1) : value.toFixed(2)} ${units[i]}`;
    }

    async function fetchDataUsage() {
      try {
        const res = await fetch('/customer/api/data-usage', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
        const d = document.getElementById('usageDownload');
        const u = document.getElementById('usageUpload');
        const t = document.getElementById('usageTotal');
        const updated = document.getElementById('usageUpdated');
        if (!data.available) {
          if (d) d.textContent = '-'; if (u) u.textContent = '-'; if (t) t.textContent = '-';
          if (updated) updated.textContent = 'Data pemakaian belum tersedia';
          return;
        }
        if (d) d.textContent = formatUsageBytes(data.bytesIn);
        if (u) u.textContent = formatUsageBytes(data.bytesOut);
        if (t) t.textContent = formatUsageBytes(data.totalBytes);
        if (updated) {
          const when = data.updatedAt ? new Date(data.updatedAt).toLocaleString('id-ID', { dateStyle:'short', timeStyle:'short' }) : '-';
          updated.textContent = `Periode ${String(data.periodMonth).padStart(2,'0')}/${data.periodYear} • Terakhir diperbarui ${when}`;
        }
      } catch (e) {
        console.error('[Data Usage] Fetch error:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadCustomerWebNotifs();
      fetchDataUsage();
      setInterval(fetchDataUsage, 30000);
      fetchTrafficData();
      setInterval(fetchTrafficData, 15000);

      const btnRefresh = document.getElementById('btnDeviceRefresh');
      if (btnRefresh) {
        btnRefresh.addEventListener('click', async () => {
          btnRefresh.disabled = true;
          btnRefresh.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Memeriksa ONU...';
          try {
            const res = await fetch('/customer/api/device/refresh', {
              method: 'POST',
              headers: { 'Accept': 'application/json' }
            });
            const result = await res.json().catch(() => ({}));
            if (!res.ok || result.ok === false) {
              throw new Error(result.message || 'Gagal memulai Poll ONU');
            }
            const notice = document.getElementById('deviceSyncNotice');
            const lastInformEl = document.getElementById('customerLastInform');
            const beforeInform = String(lastInformEl?.dataset?.lastInform || '');
            if (notice) notice.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Poll ONU dimulai, menunggu ONU merespons...';

            // Tunggu GenieACS menerima Inform terbaru sebelum reload.
            let checks = 0;
            const waitForInform = async () => {
              checks++;
              try {
                const sr = await fetch('/customer/api/device/sync-status', { cache: 'no-store' });
                const sd = await sr.json().catch(() => ({}));
                const currentInform = String(sd.lastInform || '');
                if (sd.ok && currentInform && currentInform !== beforeInform) {
                  if (notice) notice.innerHTML = '<i class="bi bi-check-circle-fill me-1 text-success"></i> Data ONU berhasil diperbarui.';
                  setTimeout(() => location.reload(), 500);
                  return;
                }
              } catch (pollErr) {}
              if (checks < 12) {
                setTimeout(waitForInform, 2500);
              } else {
                if (notice) notice.innerHTML = '<i class="bi bi-info-circle me-1"></i> Poll sudah dikirim. ONU belum mengirim data terbaru, cek kembali beberapa saat lagi.';
                btnRefresh.disabled = false;
                btnRefresh.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Poll ONU Sekarang';
              }
            };
            setTimeout(waitForInform, 2500);
          } catch (e) {
            location.reload();
          }
        });
      }
    });

    function loadCustomerWebNotifs() {
      const container = document.getElementById('notifListContainer');
      if (!container) return;

      const notifs = [];
      <% if (paidInvoices && paidInvoices.length > 0) { %>
        <% paidInvoices.slice(0, 3).forEach(inv => { %>
          <% const pAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
          notifs.push({
            id: 'paid-<%= inv.id %>',
            type: 'payment',
            title: 'Pelunasan Tagihan Berhasil',
            message: 'Tagihan bulan <%= inv.period_month %>/<%= inv.period_year %> sebesar Rp <%= parseInt(pAmt || 0).toLocaleString("id-ID") %> telah LUNAS.',
            time: 'Terkonfirmasi Sistem'
          });
        <% }) %>
      <% } %>

      <% if (hasUnpaid) { %>
        <% const uAmt = latestUnpaid.amount != null ? latestUnpaid.amount : (latestUnpaid.package_price != null ? latestUnpaid.package_price : 0); %>
        notifs.push({
          id: 'unpaid-latest',
          type: 'warning',
          title: 'Pengingat Tagihan Bulanan',
          message: 'Tagihan bulan <%= latestUnpaid.period_month %>/<%= latestUnpaid.period_year %> sebesar Rp <%= parseInt(uAmt || 0).toLocaleString("id-ID") %> menunggu pembayaran.',
          time: 'Jatuh Tempo Tgl 20'
        });
      <% } %>

      const badge = document.getElementById('notifCountBadge');
      if (badge && notifs.length > 0) {
        badge.innerText = notifs.length;
        badge.style.display = 'flex';
      }

      if (notifs.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-bell-slash fs-1 d-block mb-2"></i>Belum ada notifikasi baru</div>';
      } else {
        container.innerHTML = notifs.map(n => `
          <div class="notif-item ${n.type === 'payment' ? 'unread' : ''}">
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="bi bi-${n.type === 'payment' ? 'check-circle-fill text-success' : 'exclamation-circle-fill text-warning'}"></i>
              <span class="fw-bold small text-white">${n.title}</span>
            </div>
            <div class="small text-slate-300 mb-1" style="font-size:12px;">${n.message}</div>
            <div class="text-muted" style="font-size:10px;">${n.time}</div>
          </div>
        `).join('');
      }
    }
  </script>
  <style>
    #customerAiLauncher{position:fixed;right:18px;bottom:24px;z-index:1060;border:0;border-radius:999px;padding:13px 18px;background:linear-gradient(135deg,#2563eb,#1747a6);color:#fff;box-shadow:0 8px 26px #0d47a133;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;max-width:calc(100vw - 28px);touch-action:manipulation}
