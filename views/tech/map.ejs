          } else if (link._manualInactive) {
            line.setStyle({ color: '#ef4444', dashArray: '8,8' });
            if (line.getTooltip()) line.setTooltipContent(link._baseTooltip + ' • belum ada pelanggan online pada ODP ini');
          } else if (allMappedConfirmedOffline) {
            line.setStyle({ color: '#ef4444', dashArray: '8,6', opacity: 1 });
            if (line.getTooltip()) line.setTooltipContent('Distribusi FO • ALARM: seluruh pelanggan non-isolir yang terpetakan terkonfirmasi PPPoE DOWN. Ini indikasi gangguan layanan, bukan bukti pasti kabel FO putus • panjang rute estimasi ' + formatCableDistance(line._cableMeters));
          } else {
            line.setStyle({ color: link._baseColor, dashArray: '10,8', opacity: 0.9 });
            let note = 'data status sesi PPPoE belum lengkap';
            if (summary && Number(summary.totalCount) > 0 && Number(summary.unknownCount) === 0 && Number(summary.offlineCount) === 0) note = 'tidak ada pelanggan non-isolir yang terkonfirmasi offline; kabel fisik belum dipantau';
            if (line.getTooltip()) line.setTooltipContent('Distribusi FO • ' + note + ' • panjang rute estimasi ' + formatCableDistance(line._cableMeters));
          }
        } else if (link._manualInactive) {
          line.setStyle({ color: '#ef4444', dashArray: '8,8' });
          if (line.getTooltip()) line.setTooltipContent(link._baseTooltip);
        } else {
          line.setStyle({ color: link._baseColor, dashArray: '10,8' });
          if (line.getTooltip()) line.setTooltipContent(link._baseTooltip);
        }
      });
      if (statusLabel) statusLabel.textContent = payload.stale
        ? 'Status terakhir ' + (payload.checkedAt ? new Date(payload.checkedAt).toLocaleTimeString('id-ID') : 'waktu tidak tersedia') + ' • login MikroTik dibatasi; warna memakai data terakhir'
        : 'Status PPPoE diperiksa pukul ' + new Date(payload.checkedAt || Date.now()).toLocaleTimeString('id-ID') + ' • diperbarui otomatis tiap 1 menit';
    } catch (_) {
      if (statusLabel) statusLabel.textContent = 'Status PPPoE belum berhasil diperbarui. Peta mempertahankan status terakhir; periksa koneksi MikroTik.';
      const metaNode = document.getElementById('techPppoeStatusMeta');
      if (metaNode) metaNode.textContent = 'Gagal memperbarui sesi. Status pada peta adalah hasil pemeriksaan terakhir yang berhasil.';
    } finally {
      topologyStatusRefreshInFlight = false;
    }
  }
  refreshTechTopologyLiveStatus();
  setInterval(refreshTechTopologyLiveStatus, 60 * 1000);

  // Geolocation for Tech
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(position => {
      const myLat = position.coords.latitude;
      const myLng = position.coords.longitude;
      
      L.marker([myLat, myLng], {
        icon: L.divIcon({
          html: '<i class="bi bi-person-circle text-white" style="font-size:24px; text-shadow: 0 0 10px #3b82f6"></i>',
          className: 'custom-div-icon',
          iconSize: [24, 24],
          iconAnchor: [12, 12]
        })
      }).addTo(map).bindPopup("<div class='popup-dark text-center'><b>Posisi Anda</b></div>");
    });
  }

  // Auto zoom
  const visibleMapMarkers = Object.values(map._layers || {}).filter(l => l instanceof L.Marker || l instanceof L.CircleMarker);
  const group = L.featureGroup(visibleMapMarkers);
  if (group.getLayers().length > 0) {
    map.fitBounds(group.getBounds().pad(0.1));
  }

  // Fix for blank map on load
  setTimeout(() => {
    map.invalidateSize();
    queueVisibleRoadRoutes();
    updateCableLengthSummary();
  }, 500);
  }
</script>

