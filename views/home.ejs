<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= company || 'Intercity Network' %> | Internet Fiber Optic</title>
  <meta name="description" content="Internet fiber optic cepat, stabil dan profesional dari <%= company || 'Intercity Network' %>.">
  <link rel="icon" href="/img/logo.png">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root{--navy:#06172f;--navy2:#092445;--blue:#087cff;--cyan:#20c9ff;--ink:#10243f;--muted:#60728a;--soft:#f3f7fb;--line:#dce7f2}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}
    a{text-decoration:none;color:inherit}.wrap{max-width:1180px;margin:auto;padding:0 28px}
    .nav{height:82px;background:rgba(4,20,42,.97);color:#fff;display:flex;align-items:center;position:sticky;top:0;z-index:50;border-bottom:1px solid rgba(255,255,255,.09)}
    .navin{display:flex;align-items:center;justify-content:space-between;width:100%;gap:30px}.brand{display:flex;align-items:center;gap:13px;font-weight:900;letter-spacing:.04em}.brand img{width:62px;height:62px;object-fit:contain}.brand span{font-size:22px;line-height:1.02}.brand small{display:block;font-size:10px;letter-spacing:.34em;color:#79d9ff;margin-top:5px}
    .links{display:flex;align-items:center;gap:27px;font-size:14px;color:#d9e7f6}.links a:hover{color:#50d5ff}
    .login{border:1px solid #1598ff;border-radius:9px;padding:12px 18px;background:rgba(0,112,255,.08);color:#fff;font-weight:700;white-space:nowrap}.login:hover{background:#087cff}
    .hero{min-height:560px;background:linear-gradient(90deg,rgba(3,20,42,.96) 0%,rgba(4,27,55,.83) 45%,rgba(4,25,48,.35) 100%),url('/img/hero.png') center/cover no-repeat;color:#fff;display:flex;align-items:center}
    .hero .wrap{width:100%}.eyebrow{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(61,201,255,.6);border-radius:30px;padding:7px 13px;font-size:11px;font-weight:800;letter-spacing:.08em;color:#77ddff;background:rgba(0,122,255,.12);text-transform:uppercase}
    h1{font-size:clamp(42px,5.5vw,72px);line-height:1.02;max-width:650px;margin:20px 0 18px;letter-spacing:-.045em}.accent{color:#19bfff}.hero p{font-size:18px;line-height:1.7;max-width:570px;color:#d9e7f5;margin:0 0 30px}
    .btns{display:flex;gap:13px;flex-wrap:wrap}.btn{padding:14px 22px;border-radius:9px;font-weight:800;font-size:14px}.primary{background:#0784ff;color:#fff;box-shadow:0 10px 28px rgba(0,132,255,.25)}.outline{border:1px solid rgba(255,255,255,.45);color:#fff;background:rgba(255,255,255,.04)}
    .strip{background:#071c38;color:#fff}.stripin{display:grid;grid-template-columns:repeat(4,1fr)}.stat{padding:25px 22px;border-right:1px solid rgba(255,255,255,.13);display:flex;gap:14px;align-items:center}.stat:last-child{border:0}.stat i{font-size:30px;color:#36caff}.stat strong{display:block;font-size:15px}.stat span{display:block;font-size:12px;color:#a9bfd5;margin-top:4px}
    section{padding:78px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:32px}.kicker{font-size:11px;color:#0784ff;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.section-head h2{margin:7px 0 0;font-size:36px;letter-spacing:-.035em}.section-head p{margin:0;color:var(--muted);max-width:520px;line-height:1.6}
    .packages{background:#f5f8fc}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:25px;box-shadow:0 8px 28px rgba(16,36,63,.05);position:relative}.card.featured{border:2px solid #087cff;transform:translateY(-5px)}.badge{position:absolute;right:16px;top:15px;background:#087cff;color:#fff;border-radius:20px;padding:5px 9px;font-size:10px;font-weight:900}.card i{font-size:27px;color:#087cff}.card h3{font-size:18px;margin:15px 0 5px}.speed{font-size:32px;font-weight:900;color:#12427c}.speed small{font-size:13px;color:#63768c}.price{font-size:22px;font-weight:900;margin:20px 0}.price small{font-size:12px;color:#71839a;font-weight:600}.card .choose{display:block;text-align:center;border:1px solid #087cff;color:#087cff;border-radius:8px;padding:10px;font-size:13px;font-weight:800}.featured .choose{background:#087cff;color:#fff}
    .dark{background:linear-gradient(110deg,#06172f,#0a2a50);color:#fff}.dark .section-head p{color:#b5c9de}.benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.benefit{padding:22px;border:1px solid rgba(255,255,255,.13);border-radius:12px;background:rgba(255,255,255,.035)}.benefit i{font-size:29px;color:#39ccff}.benefit h3{font-size:16px;margin:15px 0 7px}.benefit p{color:#b7c9db;font-size:13px;line-height:1.6;margin:0}
    .coverage{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}.network{min-height:300px;border-radius:18px;background:radial-gradient(circle at 50% 50%,rgba(19,145,255,.32),transparent 22%),radial-gradient(circle at 20% 30%,rgba(0,203,255,.17),transparent 20%),#071c38;position:relative;overflow:hidden}.network:after{content:"";position:absolute;inset:18% 12%;background-image:radial-gradient(#5bdcff 1.5px,transparent 1.5px);background-size:35px 35px;opacity:.5}.network .pin{position:absolute;left:48%;top:42%;z-index:2;width:64px;height:64px;border-radius:50%;background:#0784ff;display:grid;place-items:center;box-shadow:0 0 45px #0784ff;color:#fff;font-size:26px}.coverage h2{font-size:38px;line-height:1.1;margin:8px 0 18px}.coverage p{color:var(--muted);line-height:1.8}.check{display:inline-block;margin-top:12px;border:1px solid #087cff;color:#087cff;padding:12px 18px;border-radius:8px;font-weight:800;font-size:13px}
    .support{background:#eef6fd}.supportin{display:flex;align-items:center;justify-content:space-between;gap:25px}.support h2{margin:0 0 7px;font-size:25px}.support p{margin:0;color:var(--muted)}.wa{background:#13b86b;color:#fff;padding:13px 20px;border-radius:9px;font-weight:800;white-space:nowrap}
    footer{background:#06172f;color:#9eb5ce;padding:38px 0 25px}.footin{display:flex;justify-content:space-between;align-items:center;gap:25px}.footbrand{color:#fff;font-weight:900;font-size:18px}.footlinks{display:flex;gap:20px;font-size:12px}.copy{text-align:right;font-size:11px}
    @media(max-width:900px){.links{display:none}.cards{grid-template-columns:repeat(2,1fr)}.benefits{grid-template-columns:repeat(2,1fr)}.stripin{grid-template-columns:repeat(2,1fr)}.coverage{grid-template-columns:1fr}.hero{min-height:520px}.nav{height:72px}.brand img{width:52px;height:52px}}
    @media(max-width:560px){.wrap{padding:0 17px}.brand span{font-size:17px}.brand small{font-size:8px}.login{padding:10px 12px;font-size:12px}.hero{min-height:560px;background-position:65% center}.hero p{font-size:15px}.cards,.benefits{grid-template-columns:1fr}.card.featured{transform:none}.section-head{display:block}.section-head h2,.coverage h2{font-size:29px}.stripin{grid-template-columns:1fr 1fr}.stat{padding:18px 12px}.stat i{font-size:24px}.stat strong{font-size:12px}.stat span{font-size:10px}.supportin,.footin{display:block}.wa{display:inline-block;margin-top:18px}.footlinks{margin:20px 0}.copy{text-align:left}}
  </style>
</head>
<body>
<nav class="nav">
  <div class="wrap navin">
    <span style="display:none!important" aria-hidden="true"></span>
    </a>
    <div class="links">
      <a href="/">Beranda</a><a href="#internet">Internet</a><a href="#paket">Paket</a><a href="#coverage">Coverage</a><a href="/customer/about">Tentang Kami</a><a href="/customer/contact">Kontak</a>
    </div>
    <form class="top-login" method="POST" action="/customer/login" style="display:flex;align-items:center;gap:7px;margin-left:auto">
      <input name="phone" type="text" autocomplete="username" placeholder="No / ID / PPPoE" aria-label="No ID PPPoE" required>
      <button type="submit"><i class="bi bi-box-arrow-in-right"></i> Login</button>
    </form>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <span class="eyebrow"><i class="bi bi-broadcast-pin"></i> ISP Fiber Optic</span>
    <h1>Internet Fiber Optic<br><span class="accent">Untuk Masa Depan</span></h1>
    <p>Nikmati koneksi internet yang cepat, stabil dan aman untuk rumah, bisnis dan kebutuhan digital Anda.</p>
    <div class="btns"><a class="btn primary" href="#paket"><i class="bi bi-box-seam"></i> Lihat Paket</a><a class="btn outline" href="#coverage"><i class="bi bi-geo-alt"></i> Cek Coverage</a></div>
  </div>
</header>

<div class="strip"><div class="wrap stripin">
  <div class="stat"><i class="bi bi-speedometer2"></i><div><strong>Kecepatan Tinggi</strong><span>Hingga 1 Gbps</span></div></div>
  <div class="stat"><i class="bi bi-shield-check"></i><div><strong>Jaringan Stabil</strong><span>Support 24/7</span></div></div>
  <div class="stat"><i class="bi bi-bezier2"></i><div><strong>100% Fiber Optic</strong><span>Koneksi modern</span></div></div>
  <div class="stat"><i class="bi bi-headset"></i><div><strong>Customer Support</strong><span>Profesional & responsif</span></div></div>
</div></div>

<section id="paket" class="packages"><div class="wrap">
  <div class="section-head"><div><div class="kicker">Paket Internet</div><h2>Pilih Paket Untuk Anda</h2></div><p>Berbagai pilihan kecepatan untuk kebutuhan rumah, keluarga dan bisnis.</p></div>
  <div class="cards">
    <div class="card"><i class="bi bi-house-door"></i><h3>Internet 20 Mbps</h3><div class="speed">20 <small>Mbps</small></div><div class="price">Rp 250.000 <small>/bulan</small></div><a class="choose" href="/customer/contact">Pilih Paket</a></div>
    <div class="card featured"><span class="badge">POPULER</span><i class="bi bi-stars"></i><h3>Internet 50 Mbps</h3><div class="speed">50 <small>Mbps</small></div><div class="price">Rp 350.000 <small>/bulan</small></div><a class="choose" href="/customer/contact">Pilih Paket</a></div>
    <div class="card"><i class="bi bi-building"></i><h3>Internet 100 Mbps</h3><div class="speed">100 <small>Mbps</small></div><div class="price">Rp 550.000 <small>/bulan</small></div><a class="choose" href="/customer/contact">Pilih Paket</a></div>
    <div class="card"><i class="bi bi-gem"></i><h3>Internet 200 Mbps</h3><div class="speed">200 <small>Mbps</small></div><div class="price">Rp 850.000 <small>/bulan</small></div><a class="choose" href="/customer/contact">Pilih Paket</a></div>
  </div>
</div></section>

<section id="internet" class="dark"><div class="wrap"><div class="section-head"><div><div class="kicker">Intercity Network</div><h2>Koneksi Dibangun Untuk Anda</h2></div><p>Infrastruktur fiber optic dan dukungan teknis untuk menjaga koneksi tetap nyaman digunakan.</p></div>
<div class="benefits"><div class="benefit"><i class="bi bi-lightning-charge"></i><h3>Super Cepat</h3><p>Bandwidth tinggi untuk streaming, gaming dan kebutuhan kerja.</p></div><div class="benefit"><i class="bi bi-shield-lock"></i><h3>Stabil & Aman</h3><p>Jaringan dirancang untuk penggunaan harian yang konsisten.</p></div><div class="benefit"><i class="bi bi-router"></i><h3>Teknologi Fiber</h3><p>Infrastruktur fiber optic untuk koneksi modern dan responsif.</p></div><div class="benefit"><i class="bi bi-people"></i><h3>Support Profesional</h3><p>Tim support siap membantu saat Anda membutuhkan.</p></div></div></div></section>

<section id="coverage"><div class="wrap coverage"><div><div class="kicker">Area Coverage</div><h2>Jangkauan Luas, Koneksi Merata</h2><p>Intercity Network terus mengembangkan jaringan untuk menghadirkan koneksi fiber optic yang dekat dengan pelanggan.</p><a class="check" href="/customer/contact"><i class="bi bi-geo-alt"></i> Cek Coverage</a></div><div class="network"><div class="pin"><i class="bi bi-wifi"></i></div></div></div></section>

<section class="support"><div class="wrap supportin"><div><h2>Butuh Bantuan? Hubungi Kami</h2><p>Tim support siap membantu kebutuhan internet Anda.</p></div><a class="wa" href="<%= settings && settings.company_phone ? 'https://wa.me/' + String(settings.company_phone).replace(/\D/g,'') : '/contact' %>"><i class="bi bi-whatsapp"></i> Chat via WhatsApp</a></div></section>

<footer><div class="wrap footin"><span style="display:none!important" aria-hidden="true"></span><div class="footlinks"><a href="/">Beranda</a><a href="#paket">Paket</a><a href="#coverage">Coverage</a><a href="/customer/about">Tentang Kami</a><a href="/customer/contact">Kontak</a></div><div class="copy">© <%= new Date().getFullYear() %> <%= company || 'Intercity Network' %><br>Connecting You To Tomorrow</div></div></footer>
</body>
</html>
<style id="hide-customer-logos">
.logo,.logo-container,.brand-logo,.navbar-brand img,.brand img,.site-logo,.app-logo,.header-logo,[class*="logo"],[id*="logo"]{display:none!important}
</style>

<style id="customer-readable-finish">
/* Global readability pass: darker text, comfortable sizes, clear controls */
body{color:#172033!important}
p,li,td,th,label,span,div{line-height:1.5}
.text-muted,.muted,.small,.form-text,.help-text,.hint,.subtitle,.description,.p-sub,.footer,.footer-text{color:#5b6472!important;opacity:1!important}
input::placeholder,textarea::placeholder{color:#7b8492!important;opacity:1!important}
input,select,textarea{color:#172033!important}
button,.btn{font-weight:700}
table th{color:#374151!important}
a{font-weight:600}
@media(max-width:576px){
 body{font-size:15px}
 p,li,td,th,label{font-size:14px}
 .small,.form-text,.help-text,.hint,.description,.p-sub{font-size:12.5px!important}
 input,select,textarea{font-size:15px!important}
 button,.btn{font-size:14px!important}
}
</style>
