# Secret for the generic payment-notification webhook. Generate a unique value.
MY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional persistent encryption key. Otherwise a key is generated in data/settings-master.key.
SETTINGS_MASTER_KEY=

# Temporary migration-only key for older encrypted settings. Remove after migration.
SETTINGS_LEGACY_ENCRYPTION_KEY=

# Optional SHA-256 hash for feature-menu activation and support contact.
FEATURE_PASSWORD_HASH=
FEATURE_CONTACT_PHONE=
