<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.company_header || 'Intercity Network' %> | Internet Fiber Optic & Layanan Pelanggan</title>
  <meta name="description" content="Internet fiber optic Intercity Network untuk rumah, bisnis, dan kebutuhan digital. Pilih paket, cek tagihan, daftar layanan, dan akses portal pelanggan.">
  <meta name="robots" content="index,follow">
  <meta property="og:title" content="<%= settings.company_header || 'Intercity Network' %> | Internet Fiber Optic">
  <meta property="og:description" content="Koneksi fiber optic yang cepat dan stabil dengan layanan pelanggan responsif dan portal pelanggan mandiri.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://portal.intercirtynetwrok.web.id/">

  <!-- Preconnect to CDN for faster loading -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0f172a">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --secondary: #3b82f6;
      --accent: #06b6d4;
      --bg-dark: #ffffff;
      --bg-card: rgba(30, 41, 59, 0.88);
      --bg-card-hover: rgba(30, 41, 59, 0.98);
      --border-color: rgba(148, 163, 184, 0.22);
      --text-light: #ffffff;
      --text-muted-custom: #cbd5e1;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: #ffffff;
      background-image: none;
      color: var(--text-light);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }

    /* Force high contrast text muted on dark backgrounds */
    .text-muted {
      color: #cbd5e1 !important;
    }
    
    .text-secondary {
      color: #94a3b8 !important;
    }

    /* Glassmorphism Classes */
    .glass-card {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    }

    .glass-card:hover {
      background: var(--bg-card-hover);
      border-color: rgba(99, 102, 241, 0.45);
    }

    /* Navbar */
    .custom-navbar {
      background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 0;
      transition: all 0.3s ease;
    }

    .navbar-brand img {
      height: 42px;
      width: auto;
      object-fit: contain;
    }

    .nav-link {
      color: #e2e8f0 !important;
      font-weight: 500;
      font-size: 0.95rem;
      padding: 6px 14px !important;
      border-radius: 8px;
      transition: all 0.2s ease;
    }

    .nav-link:hover, .nav-link.active {
      color: #ffffff !important;
      background: rgba(255, 255, 255, 0.12);
    }

    .btn-portal-access {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      padding: 8px 18px;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.3s ease;
    }

    .btn-portal-access:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(99, 102, 241, 0.5);
      color: #fff;
    }

    /* Hero Section */
    .hero-section {
      padding: 50px 0 80px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(99, 102, 241, 0.2);
      border: 1px solid rgba(99, 102, 241, 0.4);
      color: #c7d2fe;
      padding: 6px 16px;
      border-radius: 30px;
      font-size: 0.88rem;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .hero-title {
      font-size: 2.8rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 20px;
      color: #172033;
    }

    .hero-subtitle {
      font-size: 1.1rem;
      color: #64748b !important;
      line-height: 1.7;
      margin-bottom: 30px;
    }

    /* Stats / Highlights */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 15px;
      margin-top: 30px;
    }

    .stat-item {
      background: rgba(30, 41, 59, 0.65);
      border: 1px solid var(--border-color);
      padding: 12px 16px;
      border-radius: 12px;
      text-align: center;
    }

    .stat-number {
      font-size: 1.25rem;
      font-weight: 700;
      color: #c7d2fe;
    }

    .stat-label {
      font-size: 0.8rem;
      color: #e2e8f0;
      font-weight: 500;
      margin-top: 2px;
    }

    /* Login Box Container */
    .login-card-header {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(59, 130, 246, 0.2) 100%);
      padding: 24px;
      border-bottom: 1px solid var(--border-color);
      text-align: center;
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
    }

    .login-card-body {
      padding: 28px 24px;
    }

    .form-floating {
      margin-bottom: 18px;
    }

    .form-control {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid #475569;
      color: #ffffff;
      border-radius: 12px;
      padding: 14px 18px;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    .form-control:focus {
      background: rgba(15, 23, 42, 0.95);
      border-color: var(--primary);
      box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.3);
      color: #ffffff;
    }

    .form-floating > label {
      color: #cbd5e1;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
      color: #c7d2fe;
    }

    .btn-submit-login {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-size: 1rem;
      font-weight: 600;
      color: #ffffff;
      width: 100%;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.35);
    }

    .btn-submit-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(99, 102, 241, 0.5);
      color: #ffffff;
    }

    .quick-tools-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 18px;
    }

    .btn-quick-tool {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(148, 163, 184, 0.25);
      color: #f1f5f9;
      padding: 12px;
      border-radius: 12px;
      font-size: 0.92rem;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-quick-tool:hover {
      background: rgba(99, 102, 241, 0.25);
      border-color: rgba(99, 102, 241, 0.6);
      color: #ffffff;
      transform: translateY(-2px);
    }

    /* Section Styling */
    .section-padding {
      padding: 70px 0;
    }

    .section-title-badge {
      display: inline-block;
      background: rgba(59, 130, 246, 0.2);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #93c5fd;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .section-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 15px;
    }

    .section-subtitle {
      color: #cbd5e1 !important;
      font-size: 1.05rem;
      max-width: 650px;
      margin: 0 auto 45px;
    }

    /* Package Cards */
    .pkg-card {
      padding: 30px 24px;
      height: 100%;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .pkg-badge-popular {
      position: absolute;
      top: -14px;
      right: 20px;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    }

    .pkg-speed-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(99, 102, 241, 0.2);
      color: #c7d2fe;
      padding: 4px 14px;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      margin-bottom: 15px;
      width: fit-content;
    }

    .pkg-name {
      font-size: 1.4rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .pkg-price {
      font-size: 1.9rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .pkg-period {
      font-size: 0.88rem;
      color: #cbd5e1;
      margin-bottom: 20px;
    }

    .pkg-features {
      list-style: none;
      padding: 0;
      margin: 0 0 25px 0;
      flex-grow: 1;
    }

    .pkg-features li {
      padding: 8px 0;
      border-bottom: 1px solid rgba(148, 163, 184, 0.15);
      font-size: 0.95rem;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .pkg-features li i {
      color: #10b981;
      font-size: 1.1rem;
    }

    .btn-pkg-action {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      border-radius: 12px;
      padding: 12px;
      font-weight: 600;
      text-decoration: none;
      text-align: center;
      transition: all 0.3s ease;
    }

    .btn-pkg-action:hover {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      border-color: transparent;
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
    }

    /* Features Highlight Cards */
    .feature-box {
      padding: 28px 22px;
      height: 100%;
      border-radius: 18px;
    }

    .feature-icon-wrapper {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(6, 182, 212, 0.2) 100%);
      border: 1px solid rgba(99, 102, 241, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: #c7d2fe;
      margin-bottom: 20px;
    }

    .feature-title {
      font-size: 1.18rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 10px;
    }

    .feature-desc {
      color: #cbd5e1 !important;
      font-size: 0.94rem;
      line-height: 1.6;
      margin: 0;
    }

    /* Contact & Quick Service Info Cards */
    .info-card {
      padding: 24px;
      border-radius: 16px;
      display: flex;
      align-items: flex-start;
      gap: 16px;
      height: 100%;
      transition: all 0.3s ease;
    }

    .info-card h5 {
      color: #ffffff !important;
      font-weight: 700;
      font-size: 1.1rem;
    }

    .info-card p, .info-card .card-text-desc {
      color: #cbd5e1 !important;
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .info-card-link:hover .info-card {
      transform: translateY(-4px);
      background: rgba(30, 41, 59, 0.98);
      border-color: rgba(99, 102, 241, 0.5);
      box-shadow: 0 12px 30px rgba(99, 102, 241, 0.25);
    }

    .info-icon {
      font-size: 1.8rem;
      color: #c7d2fe;
      background: rgba(99, 102, 241, 0.2);
      border: 1px solid rgba(99, 102, 241, 0.3);
      width: 50px;
      height: 50px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* Footer */
    .site-footer {
      background: #070a12;
      border-top: 1px solid var(--border-color);
      padding: 60px 0 30px;
      margin-top: 60px;
    }

    .footer-brand img {
      height: 40px;
      margin-bottom: 15px;
    }

    .footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-links li {
      margin-bottom: 10px;
    }

    .footer-links a {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 0.94rem;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #c7d2fe;
    }

    .footer-bottom {
      border-top: 1px solid rgba(148, 163, 184, 0.15);
      margin-top: 40px;
      padding-top: 25px;
      font-size: 0.9rem;
      color: #cbd5e1;
    }

    /* Responsive Improvements */
    @media (max-width: 991.98px) {
      .hero-title {
        font-size: 2.2rem;
      }
      .hero-section {
        padding: 30px 0 50px;
      }
      .login-card-container {
        margin-top: 40px;
      }
      .section-title {
        font-size: 1.8rem;
      }
    }

    @media (max-width: 575.98px) {
      .hero-title {
        font-size: 1.8rem;
      }
      .login-card-body {
        padding: 20px 16px;
      }
      .quick-tools-grid {
        grid-template-columns: 1fr;
      }
      .hero-stats {
        grid-template-columns: 1fr 1fr;
      }
    }

/* ===== REFERENCE ISP LIGHT STYLE ===== */
:root{--primary:#0052CC;--primary-hover:#003F9F;--secondary:#00A3E0;--accent:#00A3E0;--bg-dark:#F5F7FA;--bg-card:#FFFFFF;--bg-card-hover:#FFFFFF;--border-color:#E5E7EB;--text-light:#101827;--text-muted-custom:#6B7280}
html{scroll-behavior:smooth}
body{background:#F5F7FA!important;background-image:none!important;color:#101827!important;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif!important;line-height:1.6}
.custom-navbar{background:rgba(255,255,255,.98)!important;backdrop-filter:blur(12px);border-bottom:1px solid #E5E7EB!important;box-shadow:0 2px 8px rgba(16,24,39,.06)!important;min-height:76px;padding:10px 0!important}
.custom-navbar .navbar-brand{color:#0052CC!important}.custom-navbar .navbar-brand span{color:#0052CC!important}.custom-navbar .navbar-brand img{height:44px}
.custom-navbar .nav-link{color:#6B7280!important;font-weight:600;border-radius:12px;padding:10px 16px!important}.custom-navbar .nav-link:hover,.custom-navbar .nav-link.active{color:#0052CC!important;background:rgba(0,82,204,.08)!important}
.btn-portal-access{background:linear-gradient(135deg,#0052CC,#00A3E0)!important;color:#fff!important;border:0!important;border-radius:12px!important;box-shadow:0 10px 24px rgba(0,82,204,.18)!important}
.hero-section{background:linear-gradient(180deg,#fff 0%,#F5F7FA 100%)!important;padding:88px 0 72px!important;min-height:0!important}
.hero-section:before{display:none!important}.hero-title{font-size:clamp(2.5rem,5vw,3.8rem)!important;line-height:1.1!important;letter-spacing:-.05em!important;color:#101827!important;font-weight:800!important}.hero-subtitle{color:#6B7280!important;font-size:1.12rem!important;line-height:1.7!important}
.hero-badge{color:#0052CC!important;background:#EAF2FF!important;border:1px solid rgba(0,82,204,.18)!important;border-radius:999px!important}
.hero-actions .btn-primary,.btn-submit-login{background:linear-gradient(135deg,#0052CC,#00A3E0)!important;border:0!important;color:#fff!important;border-radius:12px!important;box-shadow:0 10px 24px rgba(0,82,204,.18)!important}.hero-actions .btn-outline{color:#0052CC!important;border:1px solid #0052CC!important;background:#fff!important;border-radius:12px!important}
.hero-stats{gap:16px!important}.stat-item{background:#fff!important;border:1px solid #E5E7EB!important;border-radius:16px!important;box-shadow:0 8px 20px rgba(15,20,25,.04)!important;padding:20px 16px!important}.stat-number{color:#0052CC!important}.stat-label{color:#6B7280!important}
.login-card-container{display:flex;justify-content:flex-end}.glass-card{background:#fff!important;color:#101827!important;border:1px solid #E5E7EB!important;box-shadow:0 16px 32px rgba(16,24,39,.08)!important;border-radius:24px!important;overflow:hidden}.login-card-header{background:#EAF2FF!important;color:#101827!important;border-bottom:1px solid #E5E7EB!important;border-radius:0!important;padding:24px!important}.login-card-header h4,.login-card-header p{color:#101827!important}.login-card-body{background:#fff!important;padding:28px 24px!important}.login-card-body .form-control{background:#fff!important;color:#101827!important;border:1px solid #E5E7EB!important}.login-card-body .form-floating>label{color:#6B7280!important}.login-card-body a{color:#0052CC!important}
.section-padding{background:#fff!important;color:#101827!important;padding:80px 0!important}.section-padding[style]{background:#F5F7FA!important;border-color:#E5E7EB!important}.section-title{color:#101827!important}.section-subtitle,.feature-desc,.info-card p{color:#6B7280!important}.section-title-badge{color:#0052CC!important;background:#EAF2FF!important;border-color:rgba(0,82,204,.18)!important}
.package-card,.info-card,.feature-card,.feature-item{background:#fff!important;color:#101827!important;border:1px solid #E5E7EB!important;box-shadow:0 12px 28px rgba(15,20,25,.05)!important;border-radius:20px!important}.pkg-name,.package-name,.feature-title,.info-card h5{color:#101827!important}.pkg-price,.package-price{color:#0052CC!important}.pkg-feature,.package-features li,.info-card p{color:#374151!important}.speed-badge{background:rgba(0,82,204,.09)!important;color:#0052CC!important;border-color:rgba(0,82,204,.2)!important}.feature-icon{background:linear-gradient(135deg,rgba(0,82,204,.12),rgba(0,163,224,.12))!important;color:#0052CC!important;border-color:rgba(0,82,204,.2)!important}
footer,.footer{background:#fff!important;color:#101827!important;border-top:1px solid #e5e7eb!important}
@media(max-width:991.98px){.hero-section{padding:64px 0 56px!important}.login-card-container{justify-content:center}}
@media(max-width:575.98px){.hero-section{padding:48px 0 40px!important}.hero-title{font-size:2.2rem!important}.hero-stats{grid-template-columns:1fr 1fr!important}}
/* ===== END REFERENCE STYLE ===== */


/* ===== EXACT REFERENCE LAYOUT OVERRIDE ===== */
.reference-hero{background:linear-gradient(180deg,#fff 0%,#f5f7fa 100%)!important;padding:88px 0 72px!important}
.reference-hero .hero-title{color:#101827!important;font-size:clamp(2.5rem,5vw,3.8rem)!important;line-height:1.1!important}
.reference-hero .hero-subtitle{color:#6b7280!important;max-width:650px!important}
.hero-actions-ref{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:32px}
.ref-btn{border-radius:12px;padding:12px 20px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;transition:.3s ease}
.ref-btn-primary{background:linear-gradient(135deg,#0052cc,#00a3e0)!important;color:#fff!important;box-shadow:0 10px 24px rgba(0,82,204,.18)}
.ref-btn-outline{background:#fff!important;color:#0052cc!important;border:1px solid #0052cc!important}
.ref-btn:hover{transform:translateY(-2px)}
.reference-stats{grid-template-columns:repeat(4,minmax(120px,1fr))!important}
.reference-visual{background:linear-gradient(135deg,rgba(0,82,204,.06),rgba(0,163,224,.06));border:1px solid rgba(0,82,204,.1);border-radius:28px;padding:32px;min-height:460px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.reference-visual-card{background:rgba(255,255,255,.97);border:1px solid #e5e7eb;border-radius:24px;padding:28px;width:100%;box-shadow:0 16px 32px rgba(16,24,39,.08);text-align:center}
.reference-network-icon,.reference-login-icon{width:110px;height:110px;margin:0 auto 20px;border-radius:24px;background:linear-gradient(135deg,#0052cc,#00a3e0);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 18px 32px rgba(0,82,204,.2)}
