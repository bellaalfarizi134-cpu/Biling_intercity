  body.tech-dashboard .isp-work-stat strong { font-size:19px; line-height:1.1; color:#1b2f4e; }
  body.tech-dashboard .isp-work-stat span:not(.isp-stat-icon) { font-size:12px; color:#77859a; }
  body.tech-dashboard .isp-work-stat > a { color:#9ba8ba; padding:8px; text-decoration:none; }
  body.tech-dashboard .isp-section-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:23px 2px 12px; }
  body.tech-dashboard .isp-section-heading h3 { color:#1a2e4c; font-size:17px; font-weight:800; margin:0 0 3px; }
