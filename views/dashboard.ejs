<style id="isp-light-theme-finish">body{background:linear-gradient(180deg,#fff 0%,#f5f7fa 58%,#eef6ff 100%)!important;color:#101827!important}.glass,.card,.stat-card,.dashboard-card,.panel,.content-card{background:#fff!important;color:#101827!important;border-color:#e5e7eb!important;box-shadow:0 12px 32px rgba(16,24,39,.07)!important}.topbar,.navbar,.header{background:#fff!important;color:#101827!important;border-bottom:1px solid #e5e7eb!important}.modal-content{background:#fff!important;color:#101827!important;border-color:#dbe3ee!important}.modal-content .text-white,.modal-content .text-light{color:#101827!important}.form-control,.form-select,textarea,input,select{background:#fff!important;color:#101827!important;border-color:#d9dee8!important}.form-text,.text-muted{color:#6b7280!important}.btn-primary{background:linear-gradient(135deg,#0052cc,#00a3e0)!important;border:0!important}.btn-outline-light,.btn-outline-secondary{background:#fff!important;color:#0052cc!important;border-color:#cbd5e1!important}.table,.table td,.table th{color:#101827!important}.table td,.table th{border-color:#e5e7eb!important}a{color:#0052cc}.badge{border-radius:999px}</style>

<style id="customer-profile-card">
  .customer-profile-card{
    position:relative;overflow:hidden;margin-bottom:22px;padding:20px;
    background:linear-gradient(145deg,#ffffff 0%,#f7fbff 100%);
    border:1px solid #dbe7f3;border-radius:20px;
    box-shadow:0 12px 32px rgba(16,24,39,.08);
  }
  .customer-profile-head{display:flex;align-items:center;gap:14px;margin-bottom:16px}
  .customer-profile-avatar{
    width:54px;height:54px;flex:0 0 54px;border-radius:16px;
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-size:25px;
    background:linear-gradient(135deg,#0052cc,#00a3e0);
    box-shadow:0 8px 20px rgba(0,82,204,.22);
  }
  .customer-profile-eyebrow{
    color:#0b6ed0;font-size:10px;font-weight:900;
    letter-spacing:.8px;text-transform:uppercase;margin-bottom:2px;
  }
  .customer-profile-name{color:#13243d;font-size:20px;font-weight:900;line-height:1.2}
  .customer-profile-id{color:#718096;font-size:12px;margin-top:4px}
  .customer-profile-status{
    margin-left:auto;display:inline-flex;align-items:center;gap:6px;
    padding:7px 11px;border-radius:999px;font-size:10px;font-weight:900;
    white-space:nowrap;
  }
  .customer-profile-status.is-active{
    color:#087f5b;background:#e8f8f1;border:1px solid #b7ead8;
  }
  .customer-profile-status.is-suspended{
    color:#c92a2a;background:#fff0f0;border:1px solid #ffc9c9;
  }
  .customer-profile-status .bi-circle-fill{font-size:6px}
  .customer-profile-grid{
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;
  }
  .customer-profile-item{
    min-width:0;padding:12px 13px;border-radius:13px;
    background:#fff;border:1px solid #e5edf6;
  }
  .customer-profile-wide{grid-column:1/-1}
  .customer-profile-label{
    color:#718096;font-size:10px;font-weight:700;
    margin-bottom:4px;text-transform:uppercase;letter-spacing:.25px;
  }
  .customer-profile-label i{color:#0b8fd3}
  .customer-profile-value{
    color:#13243d;font-size:13px;font-weight:800;
    line-height:1.35;overflow-wrap:anywhere;
  }
  @media(max-width:575px){
    .customer-profile-card{padding:16px;border-radius:17px;margin-bottom:16px}
    .customer-profile-head{align-items:flex-start;gap:11px}
    .customer-profile-avatar{width:46px;height:46px;flex-basis:46px;border-radius:13px;font-size:21px}
    .customer-profile-name{font-size:17px}
    .customer-profile-status{padding:6px 9px;font-size:9px}
    .customer-profile-grid{grid-template-columns:1fr}
    .customer-profile-wide{grid-column:auto}
    .customer-profile-item{padding:11px 12px}
  }
</style>
</head>

<body>
  <!-- NAVBAR -->
  <nav class="navbar navbar-dark shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
      <span style="display:none!important" aria-hidden="true"></span>

      <div class="d-flex align-items-center gap-2">
        <!-- PWA INSTALL -->
        <button type="button" id="btn-install-pwa-dash" class="btn btn-warning btn-sm fw-bold shadow-sm d-none d-sm-inline-flex align-items-center" onclick="triggerPwaInstall()" style="border-radius:10px; font-size:12px;">
          <i class="bi bi-download me-1"></i> App
        </button>

          <!-- WEB NOTIFICATION BELL -->
        <div class="notif-bell-btn" onclick="openNotifDrawer()" title="Notifikasi Pelanggan">
          <i class="bi bi-bell-fill"></i>
          <span class="notif-badge-count" id="notifCountBadge" style="display:none">0</span>
        </div>

        <!-- STATUS BADGE -->
        <% if (customer.status === 'Online') { %>
          <span class="status-pill online d-none d-md-inline-flex"><span class="pulse-dot green"></span> <%= t('customer.devices.online', 'Online') %></span>
        <% } else { %>
          <span class="status-pill offline d-none d-md-inline-flex"><%= customer.status %></span>
        <% } %>

        <!-- RECONNECT INTERNET INSTAN -->
        <form method="POST" action="/customer/reconnect" class="d-inline" title="Refresh & Re-connect Internet Instan">
          <button type="submit" class="btn btn-success btn-sm fw-bold d-inline-flex align-items-center gap-1 shadow-sm" style="border-radius:10px; padding: 6px 12px; font-size:12px;">
            <i class="bi bi-arrow-repeat"></i> Re-Connect
          </button>
        </form>

        <!-- LOGOUT -->
        <form method="POST" action="/customer/logout" class="d-inline">
          <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius:10px; padding: 7px 11px;">
            <i class="bi bi-box-arrow-right"></i>
          </button>
        </form>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <!-- ALERT NOTIFICATION -->
    <% if (typeof notif !== 'undefined' && notif && notif.text) { %>
      <% var nClass = 'alert-' + (notif.type === 'danger' ? 'danger' : notif.type === 'warning' ? 'warning' : notif.type === 'info' ? 'info' : 'success'); %>
      <div class="alert <%= nClass %> alert-dismissible fade show" role="alert" id="notif-alert">
        <i class="bi bi-info-circle me-2"></i> <%= notif.text %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>setTimeout(() => { var a = document.getElementById('notif-alert'); if (a) a.classList.remove('show'); }, 4000);</script>
    <% } %>

    <!-- PROMO SLIDES CAROUSEL: server-rendered so images do not depend on browser fetch -->
    <div id="promoCarousel" class="carousel slide carousel-fade mb-4 dashboard-promo" data-bs-ride="carousel" data-bs-interval="5000">
      <div class="carousel-inner">
        <% if (typeof promoSlides !== 'undefined' && Array.isArray(promoSlides) && promoSlides.length) { %>
          <% promoSlides.forEach(function(s, i) { %>
            <% var promoHref = String(s.url || '').trim(); %>
            <% if (!( /^https?:\/\//i.test(promoHref) || (promoHref.startsWith('/') && !promoHref.startsWith('//')) )) promoHref = ''; %>
            <% var promoTarget = s.open_in_new_tab ? ' target="_blank" rel="noopener noreferrer"' : ''; %>
            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
              <div class="promo-slide-card">
                <% if (promoHref) { %><a href="<%= promoHref %>"<%- promoTarget %> style="text-decoration:none;display:block;"><% } %>
                  <div class="promo-image-wrap">
                    <img src="<%= s.image_path %>" alt="<%= s.title || 'Promo Intercity Network' %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>">
                  </div>
                <% if (promoHref) { %></a><% } %>
                <div class="promo-caption">
                  <div class="promo-title"><i class="bi bi-megaphone-fill me-1" style="color:#f59e0b;"></i><%= s.title || 'Promo Terbaru' %></div>
                  <div class="promo-desc"><%= s.description || 'Informasi promo terbaru dari Intercity Network.' %></div>
                  <% if (promoHref) { %>
                    <a class="promo-link" href="<%= promoHref %>"<%- promoTarget %>>Lihat Detail Promo <i class="bi bi-arrow-right"></i></a>
                  <% } else { %>
                    <div class="promo-link" style="color:#94a3b8;cursor:default;"><i class="bi bi-info-circle"></i> Informasi promo terbaru</div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="carousel-item active"><div class="dashboard-promo-empty"><i class="bi bi-megaphone-fill me-2"></i><span>Promo & informasi terbaru</span></div></div>
        <% } %>
      </div>
    </div>
    <style>
      .dashboard-promo { border-radius:20px; overflow:hidden; box-shadow:0 12px 34px rgba(15,23,42,.12); border:1px solid #dbe7f3; background:#fff; }
      .dashboard-promo .promo-slide-card { background:#fff; }
      .dashboard-promo .promo-image-wrap { position:relative; overflow:hidden; background:#eef5ff; }
      .dashboard-promo .promo-image-wrap img { width:100%; height:auto; max-height:420px; object-fit:contain; display:block; margin:0 auto; background:#f7faff; }
      .dashboard-promo .promo-caption { padding:14px 16px 16px; background:#fff; }
      .dashboard-promo .promo-title { color:#17304e; font-size:17px; font-weight:900; line-height:1.25; margin-bottom:4px; }
      .dashboard-promo .promo-desc { color:#61748b; font-size:13px; line-height:1.5; }
      .dashboard-promo .promo-link { display:inline-flex; align-items:center; gap:6px; margin-top:10px; font-size:12px; font-weight:800; color:#0d6efd; text-decoration:none; }
      .dashboard-promo .promo-link:hover { text-decoration:underline; }
      .dashboard-promo-empty { min-height:110px; display:flex; align-items:center; justify-content:center; color:#52677f; font-weight:800; background:#f7faff; }
      @media(max-width:575px){ .dashboard-promo .promo-image-wrap img{max-height:300px;} .dashboard-promo .promo-title{font-size:15px;} .dashboard-promo .promo-desc{font-size:12px;} }
    </style>

    <!-- CUSTOMER PROFILE CARD -->
    <% if (profile) { %>
      <div class="customer-profile-card" id="profile-section">
        <div class="customer-profile-head">
          <div class="customer-profile-avatar">
            <i class="bi bi-person-fill"></i>
          </div>
          <div class="flex-grow-1">
            <div class="customer-profile-eyebrow">
              <i class="bi bi-person-vcard me-1"></i> Profil Pelanggan
            </div>
            <div class="customer-profile-name"><%= profile.name || customer.phone || 'Pelanggan' %></div>
            <div class="customer-profile-id">
              ID Pelanggan: <strong><%= profile.genieacs_tag || profile.pppoe_username || profile.id || '-' %></strong>
            </div>
          </div>
          <span class="customer-profile-status <%= profile.status === 'active' ? 'is-active' : 'is-suspended' %>">
            <i class="bi bi-circle-fill"></i>
            <%= profile.status === 'active' ? 'AKTIF' : 'ISOLIR' %>
          </span>
        </div>

        <div class="customer-profile-grid">
          <div class="customer-profile-item">
            <div class="customer-profile-label"><i class="bi bi-phone me-1"></i> Nomor HP</div>
            <div class="customer-profile-value"><%= profile.phone || '-' %></div>
          </div>
          <div class="customer-profile-item">
            <div class="customer-profile-label"><i class="bi bi-wifi me-1"></i> Paket Internet</div>
            <div class="customer-profile-value"><%= profile.package_name || 'Layanan Internet' %></div>
          </div>
          <div class="customer-profile-item">
            <div class="customer-profile-label"><i class="bi bi-speedometer2 me-1"></i> Kecepatan</div>
            <div class="customer-profile-value">
              <%= profile.speed_down ? Math.round(Number(profile.speed_down) / 1000) : '-' %> Mbps
            </div>
          </div>
          <div class="customer-profile-item">
            <div class="customer-profile-label"><i class="bi bi-person-badge me-1"></i> PPPoE</div>
            <div class="customer-profile-value"><%= profile.pppoe_username || customer.pppoeUsername || '-' %></div>
          </div>
          <div class="customer-profile-item customer-profile-wide">
            <div class="customer-profile-label"><i class="bi bi-geo-alt me-1"></i> Alamat Pemasangan</div>
            <div class="customer-profile-value"><%= profile.address || '-' %></div>
          </div>
          <div class="customer-profile-item">
            <div class="customer-profile-label"><i class="bi bi-activity me-1"></i> Redaman / RX Optical</div>
            <div class="customer-profile-value"><%= customer.rxPower || '-' %></div>
          </div>
          <div class="customer-profile-item">
            <div class="customer-profile-label"><i class="bi bi-clock-history me-1"></i> Update ONU</div>
            <div class="customer-profile-value" id="customerLastInform" data-last-inform="<%= customer.lastInform || '' %>"><%= customer.lastInformAgo || customer.lastInform || '-' %></div>
          </div>
        </div>

        <div class="d-flex align-items-center justify-content-between gap-2 mt-3 pt-3" style="border-top:1px solid #e5edf6;">
          <span class="small text-muted" id="deviceSyncNotice" style="font-size:11px;">
            <i class="bi bi-broadcast-pin me-1"></i> Data ONU dapat diperbarui secara langsung
          </span>
          <button type="button" id="btnDeviceRefresh" class="btn btn-primary btn-sm fw-bold px-3 py-2" style="border-radius:11px;">
            <i class="bi bi-arrow-repeat me-1"></i> Poll ONU Sekarang
          </button>
        </div>
      </div>
    <% } %>

    <!-- INVOICE STATUS HERO CARD -->
    <% 
      const paidInvoices = (invoices || []).filter(i => i.status === 'paid');
      const unpaidInvoices = (invoices || []).filter(i => i.status !== 'paid');
      const hasUnpaid = unpaidInvoices.length > 0;
      const latestUnpaid = hasUnpaid ? unpaidInvoices[0] : null;

      const totalUnpaidAmount = unpaidInvoices.reduce((sum, i) => sum + (Number(i.amount != null ? i.amount : (i.package_price != null ? i.package_price : 0)) || 0), 0);
      const unpaidPeriods = unpaidInvoices.map(i => `${i.period_month}/${i.period_year}`).join(', ');
      const unpaidCount = unpaidInvoices.length;
    %>
    <div class="bill-hero-card <%= !hasUnpaid ? 'paid' : '' %>">
      <div class="d-flex align-items-center gap-3">
        <div style="width:52px; height:52px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:24px; background:<%= hasUnpaid ? 'rgba(245,158,11,0.15)' : 'rgba(16,185,129,0.15)' %>; color:<%= hasUnpaid ? '#f59e0b' : '#10b981' %>; border:1px solid <%= hasUnpaid ? 'rgba(245,158,11,0.3)' : 'rgba(16,185,129,0.3)' %>;">
          <i class="bi bi-<%= hasUnpaid ? 'exclamation-triangle-fill' : 'shield-check' %>"></i>
        </div>
        <div>
          <% if (hasUnpaid) { %>
            <div class="badge bg-warning text-dark fw-bold mb-1" style="font-size:10px; letter-spacing:0.5px;">
              TAGIHAN BELUM DIBAYAR <%= unpaidCount > 1 ? `(${unpaidCount} BULAN)` : '' %>
            </div>
            <h5 class="fw-bold mb-0 text-white">Rp <%= parseInt(totalUnpaidAmount || 0).toLocaleString('id-ID') %></h5>
            <div class="small" style="color:#cbd5e1; font-weight:500; margin-top:2px;">
              Periode <%= unpaidPeriods %> <%= unpaidCount > 1 ? '• Total Akumulasi' : '• Jatuh tempo tgl 20' %>
            </div>
          <% } else { %>
            <div class="badge bg-success fw-bold mb-1" style="font-size:10px; letter-spacing:0.5px;">SEMUA TAGIHAN LUNAS</div>
            <h5 class="fw-bold mb-0 text-white">Layanan Internet Aktif</h5>
            <div class="small" style="color:#cbd5e1; font-weight:500; margin-top:2px;">Terima kasih telah membayar tepat waktu!</div>
          <% } %>
        </div>
      </div>

      <% if (hasUnpaid) { %>
        <button type="button" class="btn-pay-hero" onclick="openPaymentModal('<%= latestUnpaid.id %>', '<%= totalUnpaidAmount %>')">
          <i class="bi bi-qr-code-scan"></i> BAYAR SEKARANG (QRIS)
        </button>
      <% } %>
    </div>

    <!-- QUICK ACTION DOCK (6 ICONS) -->
    <div class="action-grid">
      <% const navPayAmt = hasUnpaid ? totalUnpaidAmount : 0; %>
      <div class="action-item" onclick="<%= hasUnpaid ? `openPaymentModal('${latestUnpaid.id}', '${navPayAmt}')` : `location.href='#billing-section'` %>">
        <div class="action-icon ai-pay"><i class="bi bi-credit-card-2-front-fill"></i></div>
        <div class="action-label">Bayar Tagihan</div>
      </div>
      <div class="action-item" onclick="editSsid('<%= (customer.tags && customer.tags[0]) || customer.id %>', '<%= customer.ssid %>')">
        <div class="action-icon ai-ssid"><i class="bi bi-wifi"></i></div>
        <div class="action-label">Nama WiFi</div>
      </div>
      <div class="action-item" onclick="editPassword('<%= (customer.tags && customer.tags[0]) || customer.id %>')">
        <div class="action-icon ai-pass"><i class="bi bi-key-fill"></i></div>
        <div class="action-label">Sandi WiFi</div>
      </div>
      <div class="action-item" onclick="rebootDevice('<%= (customer.tags && customer.tags[0]) || customer.id %>')">
        <div class="action-icon ai-reboot"><i class="bi bi-arrow-clockwise"></i></div>
        <div class="action-label">Restart Modem</div>
      </div>
      <div class="action-item" onclick="openNotifDrawer()">
        <div class="action-icon ai-ppob"><i class="bi bi-bell-fill"></i></div>
        <div class="action-label">Notifikasi</div>
      </div>
      <div class="action-item" onclick="openSpeedtest()">
        <div class="action-icon ai-speedtest"><i class="bi bi-speedometer2"></i></div>
        <div class="action-label">Speedtest</div>
      </div>
      <div class="action-item" onclick="upgradeSpeed()">
        <div class="action-icon" style="background:#fff7ed;color:#ea580c;"><i class="bi bi-graph-up-arrow"></i></div>
        <div class="action-label">Upgrade Kecepatan</div>
      </div>
      <div class="action-item" onclick="const m = new bootstrap.Modal(document.getElementById('ticketModal')); m.show();">
        <div class="action-icon ai-ticket"><i class="bi bi-headset"></i></div>
        <div class="action-label">Bantuan / Tiket</div>
      </div>
    </div>

    <!-- MAIN DEVICE & TRAFFIC MONITORING GRID -->
    <div class="row g-3 g-lg-4 mb-4">
      <!-- SMART HOME ROUTER CARD -->
      <div class="col-lg-6">
        <div class="glass-card h-100 mb-0">
          <div class="glass-header">
            <h5><i class="bi bi-router me-2 text-primary"></i> Kontrol Perangkat Router</h5>
            <span class="badge bg-primary" style="border-radius:8px;"><%= customer.model !== '-' ? customer.model : 'ONT / ONU' %></span>
          </div>
          <div class="p-3 p-md-4">
            <div class="stats-grid mb-3">
              <div class="stat-card">
                <div class="stat-icon <%= customer.status === 'Online' ? 'online' : 'offline' %>">
                  <i class="bi bi-power"></i>
                </div>
                <div class="stat-label">Status Router</div>
                <div class="stat-value"><%= customer.status %></div>
              </div>
              <div class="stat-card">
                <div class="stat-icon activity">
                  <i class="bi bi-reception-4"></i>
                </div>
                <div class="stat-label">Rx Optical</div>
                <div class="stat-value"><%= customer.rxPower %></div>
              </div>
              <div class="stat-card">
                <div class="stat-icon people">
                  <i class="bi bi-laptop"></i>
                </div>
                <div class="stat-label">User Terhubung</div>
                <div class="stat-value"><%= customer.totalAssociations || 0 %> User</div>
              </div>
            </div>

            <!-- WIFI & PASSWORD BOX -->
            <div class="wifi-box mb-3" style="background:rgba(15,23,42,0.7); border:1px solid var(--card-border); border-radius:16px; padding:16px;">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold" style="color:#93c5fd;"><i class="bi bi-wifi text-info me-1"></i> Nama SSID WiFi</span>
                <button class="btn btn-link btn-sm text-info p-0 text-decoration-none fw-bold" onclick="editSsid('<%= (customer.tags && customer.tags[0]) || customer.id %>', '<%= customer.ssid %>')">Ubah <i class="bi bi-pencil"></i></button>
              </div>
              <div class="fw-bold text-white mb-3" style="font-size:16px;"><%= customer.ssid || '-' %></div>

              <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="small fw-bold" style="color:#86efac;"><i class="bi bi-shield-lock text-success me-1"></i> Password WiFi</span>
                <button class="btn btn-link btn-sm text-success p-0 text-decoration-none fw-bold" onclick="editPassword('<%= (customer.tags && customer.tags[0]) || customer.id %>')">Ubah <i class="bi bi-pencil"></i></button>
              </div>
              <div class="d-flex align-items-center gap-2">
                <input type="password" id="wifiPassInput" class="form-control form-control-sm text-white" value="••••••••" readonly style="background:rgba(30,41,59,0.8); border:none;">
                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="togglePassVisibility()" style="border-radius:10px;"><i class="bi bi-eye" id="eyeIcon"></i></button>
              </div>
            </div>

            <!-- CONNECTED USERS LIST -->
            <div class="small mb-2 fw-bold" style="color:#52677f;"><i class="bi bi-people me-1"></i> Perangkat Terhubung</div>
            <% if (connectedUsers && connectedUsers.length > 0) { %>
              <div class="d-flex flex-column gap-2" style="max-height:180px; overflow-y:auto;">
                <% connectedUsers.forEach(u => { %>
                  <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background:rgba(30,41,59,0.6); border:1px solid rgba(255,255,255,0.05); font-size:12px;">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-laptop text-primary"></i>
                      <div>
                        <div class="fw-bold text-white"><%= u.hostname || 'Device' %></div>
                        <div style="font-size:11px; color:#64748b;"><%= u.ip || '-' %> | <%= u.mac || '-' %></div>
                      </div>
                    </div>
                    <span class="badge bg-success" style="font-size:9px;">Active</span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="text-center small py-2" style="background:rgba(30,41,59,0.4); border-radius:10px; color:#94a3b8;">Data daftar perangkat tersambung durung kasedhiya saka ONU. Coba delok maneh sawisé ACS nampa data anyar.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- TRAFFIC GAUGES -->
      <div class="col-lg-6">
        <div class="glass-card h-100 mb-0">
          <div class="glass-header">
            <h5><i class="bi bi-speedometer2 me-2 text-info"></i> Pemantauan Trafik Real-Time</h5>
            <span class="badge bg-info text-dark" style="border-radius:8px;">Live Mbps</span>
          </div>
          <div class="p-3 p-md-4 d-flex flex-column justify-content-center">
            <div class="row g-3 text-center">
              <div class="col-6">
                <div class="stat-label" style="color:#52677f; font-weight:800;">Kecepatan Download</div>
                <div class="traffic-gauge">
                  <canvas id="pppoe_rx_gauge" width="220" height="140" data-max="<%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %>"></canvas>
                  <div class="traffic-gauge-center">
                    <div class="traffic-gauge-value" id="pppoe_rx_value">-</div>
                    <div class="traffic-gauge-unit" id="pppoe_rx_unit">&nbsp;</div>
                  </div>
                  <div class="traffic-gauge-scale" style="color:#52677f;">
                    <span>0</span>
                    <span id="pppoe_rx_max"><%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %> Mbps</span>
                  </div>
                </div>
              </div>
              <div class="col-6">
                <div class="stat-label" style="color:#52677f; font-weight:800;">Kecepatan Upload</div>
                <div class="traffic-gauge">
                  <canvas id="pppoe_tx_gauge" width="220" height="140" data-max="<%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %>"></canvas>
                  <div class="traffic-gauge-center">
                    <div class="traffic-gauge-value" id="pppoe_tx_value">-</div>
                    <div class="traffic-gauge-unit" id="pppoe_tx_unit">&nbsp;</div>
                  </div>
                  <div class="traffic-gauge-scale" style="color:#52677f;">
                    <span>0</span>
                    <span id="pppoe_tx_max"><%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %> Mbps</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="alert alert-info border-0 mt-4 mb-0 py-2 small text-center" style="background:rgba(6,182,212,0.15); color:#a5f3fc; font-weight:500;">
              <i class="bi bi-info-circle me-1"></i> Kecepatan disesuaikan dengan paket berlangganan Anda.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PEMAKAIAN DATA BULANAN -->
    <div class="glass-card mb-4" id="dataUsageCard">
      <div class="glass-header">
        <h5><i class="bi bi-database-fill me-2" style="color:#0b6ed0;"></i> Pemakaian Data Bulan Ini</h5>
        <span class="badge" style="background:#e8f3ff;color:#0868bd;border-radius:8px;">REALTIME</span>
      </div>
      <div class="p-3 p-md-4">
        <div class="row g-3">
          <div class="col-4">
            <div class="stat-card h-100">
              <div class="stat-icon activity"><i class="bi bi-download"></i></div>
              <div class="stat-label">Download</div>
              <div class="stat-value" id="usageDownload">-</div>
            </div>
          </div>
          <div class="col-4">
            <div class="stat-card h-100">
              <div class="stat-icon online"><i class="bi bi-upload"></i></div>
              <div class="stat-label">Upload</div>
              <div class="stat-value" id="usageUpload">-</div>
            </div>
          </div>
          <div class="col-4">
            <div class="stat-card h-100">
              <div class="stat-icon person"><i class="bi bi-pie-chart-fill"></i></div>
              <div class="stat-label">Total</div>
              <div class="stat-value" id="usageTotal">-</div>
            </div>
          </div>
        </div>
        <div class="text-center small mt-3" id="usageUpdated" style="color:#718096;">Memuat pemakaian data...</div>
      </div>
    </div>

    <!-- INVOICE & COMPLAINT TIKET SECTIONS -->
    <div class="accordion customer-accordion mb-4" id="customerAccordion">
      <!-- TAGIHAN ACCORDION -->
      <div class="accordion-item glass-card mb-3" id="billing-section">
        <h2 class="accordion-header">
          <button class="accordion-button bg-transparent text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBilling">
            <i class="bi bi-receipt me-2 text-warning"></i> Status Tagihan & Riwayat Pembayaran
          </button>
        </h2>
        <div id="collapseBilling" class="accordion-collapse collapse show" data-bs-parent="#customerAccordion">
          <div class="accordion-body p-2 p-md-4">
            <!-- DESKTOP TABLE VIEW (md ke atas) -->
            <div class="table-responsive d-none d-md-block">
              <table class="table table-hover align-middle invoice-table" style="margin-bottom:0;">
                <thead>
                  <tr style="border-bottom: 2px solid rgba(99,102,241,0.4); background:rgba(30,41,59,0.8);">
                    <th class="text-white text-start fw-bold" style="padding:12px 14px; font-size:13px;">Aksi</th>
                    <th class="text-white fw-bold" style="padding:12px 14px; font-size:13px;">Periode</th>
                    <th class="text-white fw-bold" style="padding:12px 14px; font-size:13px;">Layanan / Paket</th>
                    <th class="text-white fw-bold" style="padding:12px 14px; font-size:13px;">Jumlah</th>
                    <th class="text-white fw-bold" style="padding:12px 14px; font-size:13px;">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (invoices && invoices.length > 0) { %>
                    <% invoices.forEach(inv => { %>
                      <% const itemAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
                            <td class="text-start" style="white-space:nowrap; padding:12px 14px;">
                          <% if (inv.status !== 'paid') { %>
                            <button class="btn btn-sm text-dark fw-bold shadow-sm" onclick="openPaymentModal('<%= inv.id %>', '<%= itemAmt %>')" style="background: linear-gradient(135deg, #f59e0b, #fbbf24); border:none; border-radius:8px; padding: 7px 14px; font-size:12px; display:inline-flex; align-items:center; gap:6px;">
                              <i class="bi bi-qr-code-scan" style="font-size:15px; color:#0f172a;"></i> <span>Bayar</span>
                            </button>
                            <a href="/customer/invoice/<%= inv.id %>/pdf" class="btn btn-sm text-white fw-bold shadow-sm ms-1" style="background: rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.3); border-radius:8px; padding: 7px 12px; font-size:12px; display:inline-flex; align-items:center; gap:6px; text-decoration:none;" target="_blank" title="Unduh Tagihan PDF">
                              <i class="bi bi-file-earmark-pdf-fill" style="font-size:15px; color:#38bdf8;"></i> <span style="color:#ffffff;">PDF</span>
                            </a>
                          <% } else { %>
                            <a href="/customer/invoice/<%= inv.id %>/print-thermal" class="btn btn-sm text-white fw-bold shadow-sm" style="background: linear-gradient(135deg, #059669, #10b981); border:none; border-radius:8px; padding: 7px 12px; font-size:12px; display:inline-flex; align-items:center; gap:6px; text-decoration:none;" target="_blank" title="Cetak Struk Bluetooth Thermal 58mm">
                              <i class="bi bi-receipt" style="font-size:15px; color:#ffffff;"></i> <span>Struk Thermal</span>
                            </a>
                            <a href="/customer/invoice/<%= inv.id %>/print" class="btn btn-sm text-white fw-bold shadow-sm ms-1" style="background: linear-gradient(135deg, #4f46e5, #6366f1); border:none; border-radius:8px; padding: 7px 12px; font-size:12px; display:inline-flex; align-items:center; gap:6px; text-decoration:none;" target="_blank" title="Cetak Faktur A4 Standar">
                              <i class="bi bi-printer-fill" style="font-size:15px; color:#ffffff;"></i> <span>Faktur A4</span>
                            </a>
                            <a href="/customer/invoice/<%= inv.id %>/pdf" class="btn btn-sm text-white fw-bold shadow-sm ms-1" style="background: linear-gradient(135deg, #0284c7, #06b6d4); border:none; border-radius:8px; padding: 7px 12px; font-size:12px; display:inline-flex; align-items:center; gap:6px; text-decoration:none;" target="_blank" title="Unduh PDF">
                              <i class="bi bi-file-earmark-pdf-fill" style="font-size:15px; color:#ffffff;"></i> <span>PDF</span>
                            </a>
                          <% } %>
                        </td>
                        <td class="col-periode fw-bold" style="white-space:nowrap;"><%= inv.period_month %>/<%= inv.period_year %></td>
                        <td class="col-paket"><%= inv.package_name || 'Paket Internet' %></td>
                        <td class="col-jumlah">Rp <%= parseInt(itemAmt || 0).toLocaleString('id-ID') %></td>
                        <td style="padding:12px 14px;">
                          <% if (inv.status === 'paid') { %>
                            <span class="badge bg-success text-white" style="border-radius:8px; padding:6px 12px; font-size:11px; font-weight:700;">LUNAS</span>
                          <% } else { %>
                            <span class="badge text-white" style="background:#dc2626; border-radius:8px; padding:6px 12px; font-size:11px; font-weight:700;">BELUM BAYAR</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="5" class="text-center text-white py-4" style="font-size:13px;">Belum ada riwayat tagihan</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- MOBILE CARD LIST VIEW (di bawah md / HP) -->
            <div class="d-block d-md-none">
              <% if (invoices && invoices.length > 0) { %>
                <div class="d-flex flex-column gap-3">
                  <% invoices.forEach(inv => { %>
                    <% const itemAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
                    <div class="mobile-invoice-card" style="background:rgba(15,23,42,0.85); border:1px solid rgba(255,255,255,0.12); box-shadow:0 4px 16px rgba(0,0,0,0.25);">
                      <!-- Top Info Bar -->
                      <div class="d-flex align-items-center justify-content-between mb-2">
                        <% if (inv.status === 'paid') { %>
                          <span class="badge bg-success text-white" style="border-radius:6px; padding:5px 10px; font-size:10px; font-weight:700;">LUNAS</span>
                        <% } else { %>
                          <span class="badge text-white" style="background:#dc2626; border-radius:6px; padding:5px 10px; font-size:10px; font-weight:700;">BELUM BAYAR</span>
                        <% } %>
                        <span class="fw-bold" style="color:#cbd5e1; font-size:12px;"><i class="bi bi-calendar-event me-1"></i> Periode <%= inv.period_month %>/<%= inv.period_year %></span>
                      </div>

                      <!-- Service & Amount -->
                      <div class="mb-3">
                        <div class="fw-bold text-white" style="font-size:15px; margin-bottom:2px;"><%= inv.package_name || 'Paket Internet' %></div>
                        <div class="fw-extrabold" style="color:#38bdf8; font-size:18px; font-weight:800;">Rp <%= parseInt(itemAmt || 0).toLocaleString('id-ID') %></div>
                      </div>

                      <!-- Mobile Action Buttons -->
                      <div>
                        <% if (inv.status !== 'paid') { %>
                          <div class="d-flex flex-column gap-2">
                            <button class="btn text-dark fw-bold w-100 shadow" onclick="openPaymentModal('<%= inv.id %>', '<%= itemAmt %>')" style="background: linear-gradient(135deg, #f59e0b, #fbbf24); border:none; border-radius:10px; padding:10px; font-size:13px; display:flex; align-items:center; justify-content:center; gap:8px;">
                              <i class="bi bi-qr-code-scan" style="font-size:17px; color:#0f172a;"></i> <span>BAYAR SEKARANG (QRIS)</span>
                            </button>
                            <a href="/customer/invoice/<%= inv.id %>/pdf" class="btn text-white fw-bold w-100 shadow" style="background: rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.25); border-radius:10px; padding:8px; font-size:12px; display:flex; align-items:center; justify-content:center; gap:6px; text-decoration:none;" target="_blank">
                              <i class="bi bi-file-earmark-pdf-fill" style="font-size:16px; color:#38bdf8;"></i> <span style="color:#ffffff;">Unduh Tagihan PDF</span>
                            </a>
                          </div>
                        <% } else { %>
                          <div class="d-flex gap-2 flex-wrap">
                            <a href="/customer/invoice/<%= inv.id %>/print-thermal" class="btn text-white fw-bold flex-fill shadow" style="background: linear-gradient(135deg, #059669, #10b981); border:none; border-radius:10px; padding:8px; font-size:12px; display:flex; align-items:center; justify-content:center; gap:6px; text-decoration:none;" target="_blank">
                              <i class="bi bi-receipt" style="font-size:15px; color:#ffffff;"></i> <span>Struk Thermal</span>
                            </a>
                            <a href="/customer/invoice/<%= inv.id %>/print" class="btn text-white fw-bold flex-fill shadow" style="background: linear-gradient(135deg, #4f46e5, #6366f1); border:none; border-radius:10px; padding:8px; font-size:12px; display:flex; align-items:center; justify-content:center; gap:6px; text-decoration:none;" target="_blank">
                              <i class="bi bi-printer-fill" style="font-size:15px; color:#ffffff;"></i> <span>Faktur A4</span>
                            </a>
                            <a href="/customer/invoice/<%= inv.id %>/pdf" class="btn text-white fw-bold flex-fill shadow" style="background: linear-gradient(135deg, #0284c7, #06b6d4); border:none; border-radius:10px; padding:8px; font-size:12px; display:flex; align-items:center; justify-content:center; gap:6px; text-decoration:none;" target="_blank">
                              <i class="bi bi-file-earmark-pdf-fill" style="font-size:15px; color:#ffffff;"></i> <span>PDF</span>
                            </a>
                          </div>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-center text-white py-4" style="background:rgba(15,23,42,0.6); border-radius:12px; font-size:13px;">Belum ada riwayat tagihan</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- TIKET KELUHAN ACCORDION -->
      <div class="accordion-item glass-card mb-3" id="ticket-section">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed bg-transparent text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTicket">
            <i class="bi bi-headset me-2 text-purple" style="color:#a855f7;"></i> Tiket Keluhan & Bantuan
          </button>
        </h2>
        <div id="collapseTicket" class="accordion-collapse collapse" data-bs-parent="#customerAccordion">
          <div class="accordion-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="fw-bold text-white mb-0">Daftar Tiket Keluhan Anda</h6>
              <button class="btn btn-primary btn-sm fw-bold" onclick="const m = new bootstrap.Modal(document.getElementById('ticketModal')); m.show();" style="border-radius:10px; background:linear-gradient(135deg,#6366f1,#3b82f6); border:none;">
                <i class="bi bi-plus-lg me-1"></i> Buat Tiket
              </button>
            </div>
            <% if (tickets && tickets.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead>
                    <tr>
                      <th class="text-white">ID Tiket</th>
                      <th class="text-white">Jenis Kendala</th>
                      <th class="text-white">Tanggal</th>
                      <th class="text-white">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% tickets.forEach(t => { %>
                      <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); background:rgba(30,41,59,0.4);">
                        <td class="fw-bold text-info">#TK-<%= t.id %></td>
                        <td class="text-white"><%= t.subject %></td>
                        <td class="text-muted"><%= t.created_at %></td>
                        <td>
                          <span class="badge <%= t.status === 'open' ? 'bg-warning text-dark' : t.status === 'in_progress' ? 'bg-info text-dark' : 'bg-success' %>" style="border-radius:8px;">
                            <%= t.status === 'open' ? 'TERKIRIM' : t.status === 'in_progress' ? 'DIPROSES TEKNISI' : 'SELESAI' %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center text-muted py-4">Belum ada tiket keluhan yang dibuat.</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SPEEDTEST MODAL -->
  <div class="modal fade" id="speedtestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content" style="border-radius:20px;overflow:hidden;border:1px solid #dbe7f3;background:#fff;">
        <div class="modal-header border-0 py-3 px-4" style="background:linear-gradient(135deg,#075dbd,#0ea5e9);color:#fff;">
          <div>
            <h5 class="modal-title fw-bold mb-0"><i class="bi bi-speedometer2 me-2"></i>Speedtest Internet</h5>
            <div style="font-size:12px;opacity:.9;">Uji kecepatan koneksi internet Anda</div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body p-0" style="background:#f5f8fc;">
          <iframe id="speedtestFrame" title="Speedtest" style="display:block;width:100%;height:620px;border:0;background:#fff;" loading="lazy" allow="fullscreen"></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- PAYMENT METHODS MODAL -->
  <div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background:#0f172a; border:1px solid rgba(99,102,241,0.3); border-radius:24px; color:#fff; box-shadow:0 25px 70px rgba(0,0,0,0.6);">
        <div class="modal-header border-0 pb-0" style="padding:24px 24px 10px;">
          <h5 class="modal-title fw-bold text-white fs-5"><i class="bi bi-credit-card-2-front me-2 text-warning fs-4"></i>Pilihan Metode Pembayaran</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <!-- AMOUNT DISPLAY CARD -->
          <div class="text-center mb-4 p-3 rounded-4" style="background:rgba(30,41,59,0.9); border:1px solid rgba(245,158,11,0.4); box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
            <div class="fw-bold small mb-1" style="color:#cbd5e1; font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">Total Tagihan Harus Dibayar</div>
            <h2 class="fw-extrabold text-warning mb-0" style="font-size:28px; color:#fbbf24; text-shadow:0 2px 10px rgba(245,158,11,0.3);" id="pay_amount_text">Rp 0</h2>
          </div>

          <div class="d-grid gap-3">
            <!-- DYNAMIC CHANNELS OR DEFAULTS -->
            <% if (typeof paymentChannels !== 'undefined' && paymentChannels && paymentChannels.length > 0) { %>
              <% paymentChannels.forEach(ch => { %>
                <button class="btn btn-outline-light p-3 text-start d-flex align-items-center justify-content-between" onclick="submitPayment('<%= ch.code %>')" style="border-radius:16px; border:1px solid rgba(99,102,241,0.35); background:rgba(30,41,59,0.75); transition:all 0.2s ease;">
                  <div class="d-flex align-items-center gap-3">
                    <div style="width:44px; height:44px; border-radius:12px; background:rgba(99,102,241,0.2); display:flex; align-items:center; justify-content:center; color:#818cf8; font-size:20px; font-weight:bold;">
