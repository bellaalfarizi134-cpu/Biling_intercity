    <div class="mbody">
      <div id="cable-drawing-map"></div>
      <p class="text-muted mt-2 small"><i class="bi bi-info-circle"></i> Tarik titik oranye untuk mengubah jalur. Klik tombol di bawah untuk menambah titik lekukan.</p>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-sm btn-outline-primary" onclick="addMorePoints()"><i class="bi bi-plus-circle"></i> Tambah Titik Lekukan</button>
      <button type="button" class="btn btn-g" onclick="closeModal('cablePathModal')">Batal</button>
      <button type="button" class="btn btn-p" onclick="saveCablePath()">Simpan Jalur Kabel</button>
    </div>
  </div>
</div>

<script id="settings-data" type="application/json"><%- JSON.stringify(settings) %></script>
<script id="customers-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="odps-data" type="application/json"><%- JSON.stringify(odps).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="odcs-data" type="application/json"><%- JSON.stringify(odcs || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="routers-data" type="application/json"><%- JSON.stringify(routers || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="olts-data" type="application/json"><%- JSON.stringify(olts || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="topology-links-data" type="application/json"><%- JSON.stringify(topologyLinks || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="manual-cable-paths-data" type="application/json"><%- JSON.stringify(manualCablePaths || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>

<script>
  const I18N = {
    layerOsm: "<%= t('admin.map.layers.osm', 'OpenStreetMap') %>",
    layerHybrid: "<%= t('admin.map.layers.hybrid', 'Satelit (Hybrid)') %>",
    popupDescription: "<%= t('admin.map.popup.description', 'Deskripsi') %>",
    popupLocation: "<%= t('admin.map.popup.location', 'Lokasi') %>",
    popupEdit: "<%= t('common.edit', 'Edit') %>",
    popupStatus: "<%= t('admin.map.popup.status', 'Status') %>",
    popupPackage: "<%= t('admin.map.popup.package', 'Paket') %>",
    popupAddress: "<%= t('admin.map.popup.address', 'Alamat') %>",
    viewDetails: "<%= t('admin.map.popup.view_details', 'Lihat Detail') %>",
    statusActive: "<%= t('admin.map.status.active', 'Aktif') %>",
    statusSuspended: "<%= t('admin.map.status.suspended', 'Isolir') %>"
  };

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  const appSettings = JSON.parse(document.getElementById('settings-data').textContent || '{}');
  const officeCoords = {
    lat: parseFloat(appSettings.office_lat) || -6.200000,
    lng: parseFloat(appSettings.office_lng) || 106.816666
  };

  // Initialize Map
  const map = L.map('map', {
    editable: true
  }).setView([officeCoords.lat, officeCoords.lng], 13);

  let currentEditingPolyline = null;
  let currentEditingCustomer = null;
  let showLabels = true;
  let currentFilter = 'all';

  // Tile Layers
  const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '© OpenStreetMap'
  });

  const googleHybrid = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
    maxZoom: 20,
    subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
    attribution: '© Google Satellite'
  });

  osm.addTo(map);
  googleHybrid.addTo(map);

  const baseMaps = {
    [I18N.layerOsm]: osm,
    [I18N.layerHybrid]: googleHybrid
  };

  L.control.layers(baseMaps).addTo(map);

  let customers = [];
  let odps = [];
  let odcs = [];
  let routers = [];
  let olts = [];
  let topologyLinks = [];
  let manualCablePaths = [];
  try {
    customers = JSON.parse(document.getElementById('customers-data').textContent || '[]');
    odps = JSON.parse(document.getElementById('odps-data').textContent || '[]');
    odcs = JSON.parse(document.getElementById('odcs-data').textContent || '[]');
    routers = JSON.parse(document.getElementById('routers-data').textContent || '[]');
    olts = JSON.parse(document.getElementById('olts-data').textContent || '[]');
    topologyLinks = JSON.parse(document.getElementById('topology-links-data').textContent || '[]');
    manualCablePaths = JSON.parse(document.getElementById('manual-cable-paths-data').textContent || '[]');
  } catch (e) {
    console.error("Data mapping error:", e);
    customers = Array.isArray(customers) ? customers : [];
    odps = Array.isArray(odps) ? odps : [];
    odcs = Array.isArray(odcs) ? odcs : [];
    routers = Array.isArray(routers) ? routers : [];
    olts = Array.isArray(olts) ? olts : [];
    topologyLinks = Array.isArray(topologyLinks) ? topologyLinks : [];
    manualCablePaths = Array.isArray(manualCablePaths) ? manualCablePaths : [];
  }

  // Edit perangkat langsung dari popup Map
  window.editTopologyOltLocation = function(id) {
    const o = olts.find(x => Number(x.id) === Number(id));
    if (!o) return;
    openLocationEditor('olt', o);
  };

  window.editTopologyRouterLocation = function(id) {
    const r = routers.find(x => Number(x.id) === Number(id));
    if (!r) return;
    openLocationEditor('router', r);
  };

  let topologyLocationMap = null;
  let topologyLocationMarker = null;

  function initTopologyLocationMap(lat, lng, type) {
    const safeLat = Number.isFinite(Number(lat)) && Number(lat) !== 0 ? Number(lat) : officeCoords.lat;
    const safeLng = Number.isFinite(Number(lng)) && Number(lng) !== 0 ? Number(lng) : officeCoords.lng;
    const iconClass = type === 'olt' ? 'bi-diagram-3-fill' : 'bi-router-fill';
    const iconColor = type === 'olt' ? '#2563eb' : '#7c3aed';
    const icon = L.divIcon({
      html: '<div style="width:30px;height:30px;border-radius:50%;background:' + iconColor + ';border:3px solid #fff;box-shadow:0 3px 10px rgba(15,23,42,.35);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;"><i class="bi ' + iconClass + '"></i></div>',
      className: 'custom-div-icon',
      iconSize: [30, 30],
      iconAnchor: [15, 15]
    });
    if (!topologyLocationMap) {
      topologyLocationMap = L.map('topology-location-map').setView([safeLat, safeLng], 17);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', { maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3'] }).addTo(topologyLocationMap);
      topologyLocationMarker = L.marker([safeLat, safeLng], { draggable: true, icon }).addTo(topologyLocationMap);
      topologyLocationMarker.on('dragend', function() {
        const p = topologyLocationMarker.getLatLng();
        document.getElementById('editTopologyLocationLat').value = p.lat.toFixed(6);
        document.getElementById('editTopologyLocationLng').value = p.lng.toFixed(6);
      });
      topologyLocationMap.on('click', function(e) {
        topologyLocationMarker.setLatLng(e.latlng);
        document.getElementById('editTopologyLocationLat').value = e.latlng.lat.toFixed(6);
        document.getElementById('editTopologyLocationLng').value = e.latlng.lng.toFixed(6);
      });
    } else {
      topologyLocationMap.setView([safeLat, safeLng], 17);
      topologyLocationMarker.setIcon(icon);
      topologyLocationMarker.setLatLng([safeLat, safeLng]);
    }
    document.getElementById('editTopologyLocationLat').value = safeLat.toFixed(6);
    document.getElementById('editTopologyLocationLng').value = safeLng.toFixed(6);
    setTimeout(() => topologyLocationMap.invalidateSize(), 250);
  }

  function openLocationEditor(type, item) {
    const form = document.getElementById('editTopologyLocationForm');
    const title = document.getElementById('editTopologyLocationTitle');
    const name = document.getElementById('editTopologyLocationName');
    const icon = document.getElementById('editTopologyLocationIcon');
    if (!form || !title || !name || !icon) return;
    const isOlt = type === 'olt';
    title.textContent = isOlt ? 'Edit Titik Lokasi OLT' : 'Edit Titik Lokasi MikroTik';
    name.value = item.name || (isOlt ? 'OLT #' + item.id : 'MikroTik #' + item.id);
    icon.className = 'bi ' + (isOlt ? 'bi-diagram-3-fill' : 'bi-router-fill');
    icon.style.color = isOlt ? '#2563eb' : '#7c3aed';
    form.action = (isOlt ? '/admin/olts/' : '/admin/routers/') + item.id + '/location';
    openModal('editTopologyLocationModal');
    initTopologyLocationMap(item.lat, item.lng, type);
  }

  // Registries for quick search, focus, and filtering
  const odpMap = {}; // odpId -> { marker, data, coord }
  const customerMap = {}; // custId -> { marker, data, polyline }
  const isIsolatedCustomer = cust => {
    const status = String(cust.status || '').trim().toLowerCase();
    const profile = String(cust.pppoe_profile || '').trim().toLowerCase();
    const isolirProfile = String(cust.isolir_profile || 'isolir').trim().toLowerCase();
    const user = String(cust.pppoe_username || '').trim();
    return ['suspended','isolir','isolated','inactive','ditangguhkan'].includes(status)
      || profile === 'isolir' || Boolean(profile && isolirProfile && profile === isolirProfile)
      || /^\[isolir\]/i.test(user);
  };
  const ensureCustomerPolyline = cust => {
    const odp = odpMap[cust.odp_id] || odpMap[Number(cust.odp_id)];
    const lat = Number(cust.lat), lng = Number(cust.lng);
    if (!odp || !Number.isFinite(lat) || !Number.isFinite(lng) || lat === 0 || lng === 0) return null;
    let pathCoords = [[lat, lng], odp.coord];
    if (cust.cable_path) {
      try {
        const parsed = JSON.parse(cust.cable_path);
        if (Array.isArray(parsed) && parsed.length >= 2) {
          const cleaned = parsed.filter(p => Array.isArray(p) && p.length >= 2).map(p => [Number(p[0]), Number(p[1])]).filter(p => Number.isFinite(p[0]) && Number.isFinite(p[1]));
          if (cleaned.length >= 2) pathCoords = cleaned;
        }
      } catch (_) {}
    }
    const line = L.polyline(pathCoords, { color:'#2563eb', weight:3, opacity:0.9, dashArray:'10,10', className:'flowing-line' }).addTo(map);
    line.bindTooltip('Pelanggan → ODP • menunggu pemeriksaan PPPoE', { sticky:true });
    line.on('click', e => { if (currentEditingPolyline === line) L.DomEvent.stopPropagation(e); });
    return line;
  };

  // 1. Render ODP Markers (Clean icon & floating text outline)
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      const lat = parseFloat(odp.lat);
      const lng = parseFloat(odp.lng);
      
      const odpIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="odp-marker-node" id="odp-node-${odp.id}">
            <div class="odp-marker-pin" title="${escapeHtml(odp.name)} (ODP)">
              <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="odp-marker-label">
              <span class="odp-marker-name">${escapeHtml(odp.name)}</span>
              <span class="odp-marker-parent">ODC: ${escapeHtml(odp.odc_name || '-')} · OLT: ${escapeHtml(odp.olt_name || '-')}</span>
            </div>
          </div>
        `,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const marker = L.marker([lat, lng], { icon: odpIcon }).addTo(map);
      
      const odpOdcId = odp.odc_id && odcs.some(d => Number(d.id) === Number(odp.odc_id)) ? Number(odp.odc_id) : null;
      marker.bindPopup(`
        <div class="popup-content">
          <h6 style="font-weight: 800; color: #0f172a; margin-bottom: 6px;"><i class="bi bi-box-seam-fill text-warning me-1"></i> ${escapeHtml(odp.name)}</h6>
          <div><strong>OLT induk:</strong> ${escapeHtml(odp.olt_name || 'Belum dipetakan')}</div>
          <div><strong>Port PON OLT:</strong> ${escapeHtml(odp.pon_port || 'Belum diatur')}</div>
          <div><strong>Kapasitas ODP:</strong> ${Number(odp.port_capacity || 16)} port</div>
          <div><strong>ODC induk:</strong> ${escapeHtml(odp.odc_name || 'Belum dipetakan')}</div>
          <div><strong>${I18N.popupDescription}:</strong> ${escapeHtml(odp.description || '-')}</div>
          <div><strong>${I18N.popupLocation}:</strong> ${lat.toFixed(6)}, ${lng.toFixed(6)}</div>
          <div class="popup-actions" style="margin-top: 10px;display:flex;gap:6px;flex-wrap:wrap;">
            <button class="btn btn-sm btn-p" onclick='editOdp(${JSON.stringify(odp)})'><i class="bi bi-pencil me-1"></i>${I18N.popupEdit}</button>
            ${odpOdcId ? `<button class="btn btn-sm btn-outline-primary" onclick="openBackboneCableEditor('odp-odc', ${Number(odp.id)}, ${odpOdcId})"><i class="bi bi-bezier2 me-1"></i>Edit Jalur ke ODC</button>` : ''}
          </div>
        </div>
      `);

      odpMap[odp.id] = {
        marker,
        data: odp,
        coord: [lat, lng]
      };
    }
  });

  function getMapOltConnectionPresentation(cust) {
    const state = String(cust && cust.pppoe_state || 'unknown').trim().toLowerCase();
    if (state === 'online') return { label: '🟢 PPPoE ONLINE', className: 'cp-chip-olt-online' };
    if (state === 'offline') return { label: '🔴 PPPoE OFFLINE', className: 'cp-chip-olt-offline' };
    return { label: '⚪ STATUS PPPoE BELUM DIKETAHUI', className: 'cp-chip-olt-unknown' };
  }
  function syncAdminCustomerOltPresentation(cust) {
    if (!cust) return;
    const id = Number(cust.id);
    const node = document.getElementById('onu-node-' + id);
    const markerLabel = document.getElementById('map-binding-marker-label-' + id);
    const serial = String(cust.onu_sn || '').trim();
    const state = String(cust.onu_olt_status || 'unknown').toLowerCase();
    if (node) {
      node.classList.remove('is-olt-online','is-olt-offline','is-olt-unknown','is-active','is-suspended','is-isolated','is-bound');
      node.classList.add(state === 'online' ? 'is-olt-online' : (state === 'offline' ? 'is-olt-offline' : 'is-olt-unknown'));
    }
    if (markerLabel) markerLabel.textContent = String(cust.name || 'Pelanggan');
    const serialPopup = document.getElementById('map-binding-sn-' + id);
    const statusPopup = document.getElementById('map-olt-status-' + id);
    const connectionBadge = document.getElementById('map-customer-connection-' + id);
    const reasonPopup = document.getElementById('map-olt-reason-' + id);
    const portPopup = document.getElementById('map-binding-port-' + id);
    const oltPopup = document.getElementById('map-olt-name-' + id);
    const rxPopup = document.getElementById('map-olt-rx-' + id);
    const txPopup = document.getElementById('map-olt-tx-' + id);
    const opticalAtPopup = document.getElementById('map-olt-optical-at-' + id);
    if (serialPopup) serialPopup.textContent = serial || '-';
    if (statusPopup) statusPopup.textContent = cust.onu_olt_status_label || 'Status OLT belum tersedia';
    if (connectionBadge) {
      const presentation = getMapOltConnectionPresentation(cust);
      connectionBadge.classList.remove('cp-chip-olt-online','cp-chip-olt-offline','cp-chip-olt-unknown');
      connectionBadge.classList.add(presentation.className);
      connectionBadge.textContent = presentation.label;
    }
    if (reasonPopup) {
      reasonPopup.textContent = cust.onu_olt_reason || '-';
      const reasonRow = reasonPopup.closest('.cp-meta-item');
      if (reasonRow) reasonRow.style.display = cust.onu_olt_reason ? '' : 'none';
    }
    if (portPopup) portPopup.textContent = cust.onu_olt_pon_id != null ? 'PON ' + cust.onu_olt_pon_id + ' / ONU ' + (cust.onu_olt_onu_id ?? '-') : '-';
    if (oltPopup) oltPopup.textContent = cust.onu_olt_name || '-';
    if (rxPopup) rxPopup.textContent = formatMapOltOptical(cust.onu_olt_rx);
    if (txPopup) txPopup.textContent = formatMapOltOptical(cust.onu_olt_tx);
    if (opticalAtPopup) opticalAtPopup.textContent = formatMapOltOpticalTime(cust.onu_olt_optical_checked_at);
  }
  function formatMapOltOptical(value) {
    const raw = String(value == null ? '' : value).trim();
    if (!raw || /^(?:-|N\/A|N\/A dBm|null|undefined)$/i.test(raw)) return 'Belum tersedia dari OLT';
    if (/dBm/i.test(raw)) return raw;
    const number = Number(raw);
    return Number.isFinite(number) ? number.toFixed(2) + ' dBm' : raw;
  }
  function formatMapOltOpticalTime(value) {
    const date = value ? new Date(value) : null;
    return date && Number.isFinite(date.getTime()) ? 'Data OLT: ' + date.toLocaleString('id-ID') : 'Waktu pembacaan belum tersedia';
  }

  // 2. Render Customer ONU Markers (Clean pin & floating text outline without box)
  customers.forEach(cust => {
    if (cust.lat && cust.lng) {
      const lat = parseFloat(cust.lat);
      const lng = parseFloat(cust.lng);
      const is_active = cust.status === 'active';
      const isIsolated = isIsolatedCustomer(cust);
      const downMaxMbps = (cust.speed_down && Number(cust.speed_down) > 0) ? Math.max(1, Math.round(Number(cust.speed_down) / 1000)) : 10;
      const upMaxMbps = (cust.speed_up && Number(cust.speed_up) > 0) ? Math.max(1, Math.round(Number(cust.speed_up) / 1000)) : 10;
      const waLink = buildWaLink(cust.phone, cust.name);
      
      // Draw Cable Line to ODP if connected
      let polyline = null;
      if (!isIsolated && cust.odp_id && odpMap[cust.odp_id]) {
        let pathCoords = [[lat, lng], odpMap[cust.odp_id].coord];
        
        if (cust.cable_path) {
          try {
            pathCoords = JSON.parse(cust.cable_path);
          } catch(e) {}
        }

        polyline = L.polyline(pathCoords, {
          // Blue is the normal segment identity; live PPPoE state may override it to red.
          color: '#2563eb',
          weight: 3,
          opacity: 0.9,
          dashArray: '10, 10',
          className: 'flowing-line'
        }).addTo(map);
        polyline.bindTooltip('Pelanggan → ODP • menunggu pemeriksaan sesi PPPoE', { sticky: true });

        polyline.on('click', (e) => {
          if (currentEditingPolyline === polyline) {
             L.DomEvent.stopPropagation(e);
          }
        });
      }

      // Customer Marker Icon with Clean Floating Name
      const onuIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="onu-marker-node ${String(cust.onu_olt_status || 'unknown').toLowerCase() === 'online' ? 'is-olt-online' : (String(cust.onu_olt_status || 'unknown').toLowerCase() === 'offline' ? 'is-olt-offline' : 'is-olt-unknown')}" id="onu-node-${cust.id}">
            <div class="onu-marker-pin" title="${escapeHtml(cust.name || 'Pelanggan')} — ${escapeHtml(cust.onu_olt_status_label || 'Status OLT belum tersedia')}">
              <i class="bi bi-router-fill"></i>
            </div>
            <div class="onu-marker-label">
              <span class="onu-marker-name" id="map-binding-marker-label-${cust.id}">${escapeHtml(cust.name || 'Pelanggan')}</span>
            </div>
          </div>
        `,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const marker = L.marker([lat, lng], { icon: onuIcon }).addTo(map);

      marker.bindPopup(`
        <div class="cust-popup">
          <div class="cp-head">
            <div class="cp-avatar"><i class="bi bi-router-fill"></i></div>
            <div class="cp-title">
              <div class="cp-name">${escapeHtml(cust.name)}</div>
              <div class="cp-badges">
                <span class="cp-chip ${getMapOltConnectionPresentation(cust).className}" id="map-customer-connection-${cust.id}">${getMapOltConnectionPresentation(cust).label}</span>
                <span class="cp-chip"><i class="bi bi-box-seam"></i>${escapeHtml(cust.package_name || '-')}</span>
              </div>
            </div>
          </div>

          <div class="cp-meta">
            <div class="cp-meta-item"><i class="bi bi-router"></i><span>PPPoE: <strong>${escapeHtml(cust.pppoe_username || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-tag"></i><span>SN ONT: <strong id="map-binding-sn-${cust.id}">${escapeHtml(cust.onu_sn || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-activity"></i><span>Detail status OLT: <strong id="map-olt-status-${cust.id}">${escapeHtml(cust.onu_olt_status_label || 'Status OLT belum tersedia')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-speedometer2"></i><span>Redaman RX dari OLT: <strong id="map-olt-rx-${cust.id}">${escapeHtml(cust.onu_olt_rx || 'Belum tersedia dari OLT')}</strong> · TX ONT: <strong id="map-olt-tx-${cust.id}">${escapeHtml(cust.onu_olt_tx || 'Belum tersedia dari OLT')}</strong><small id="map-olt-optical-at-${cust.id}" style="display:block;color:#64748b">${cust.onu_olt_optical_checked_at ? 'Data OLT: ' + escapeHtml(new Date(cust.onu_olt_optical_checked_at).toLocaleString('id-ID')) : 'Waktu pembacaan belum tersedia'}</small></span></div>
            <div class="cp-meta-item" style="${cust.onu_olt_reason ? '' : 'display:none'}"><i class="bi bi-exclamation-triangle"></i><span>Keterangan: <strong id="map-olt-reason-${cust.id}">${escapeHtml(cust.onu_olt_reason || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-diagram-3"></i><span>OLT / PON / ONU: <strong><span id="map-olt-name-${cust.id}">${escapeHtml(cust.onu_olt_name || '-')}</span> · <span id="map-binding-port-${cust.id}">${cust.onu_olt_pon_id != null ? 'PON ' + Number(cust.onu_olt_pon_id) + ' / ONU ' + Number(cust.onu_olt_onu_id) : '-'}</span></strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-box-seam"></i><span>ODP: <strong>${escapeHtml(cust.odp_name || 'Tanpa ODP')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-boxes"></i><span>ODC: <strong>${escapeHtml(cust.odc_name || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-hdd-rack"></i><span>OLT terpetakan: <strong>${escapeHtml(cust.olt_name || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-telephone"></i><span>${escapeHtml(cust.phone || '-')}</span></div>
            <div class="cp-meta-item"><i class="bi bi-geo-alt"></i><span>${escapeHtml(cust.address || '-')}</span></div>
          </div>

          <div class="cp-traffic">
            <div class="cp-traffic-head"><i class="bi bi-activity"></i><span>Trafik Realtime</span></div>
            <div class="cp-traffic-grid">
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-download"></i><span>Download</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_dl_chart" width="160" height="60" data-max="${downMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_dl_state"></div>
              </div>
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-upload"></i><span>Upload</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_ul_chart" width="160" height="60" data-max="${upMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_ul_state"></div>
              </div>
            </div>
          </div>

          <div class="popup-actions">
             <button onclick="startCableDrawing(${cust.id}, ${lat}, ${lng}, ${cust.odp_id})" class="btn btn-sm btn-p"><i class="bi bi-pencil-fill me-1"></i>Gambar Jalur</button>
             <a href="/admin/customers?search=${encodeURIComponent(cust.name || '')}" class="btn btn-sm btn-g"><i class="bi bi-eye me-1"></i>Detail</a>
             ${cust.phone ? `<a href="${waLink}" target="_blank" class="btn btn-sm btn-wa"><i class="bi bi-whatsapp"></i> Chat</a>` : ''}
          </div>
        </div>
      `);

      marker.on('popupopen', () => { syncAdminCustomerOltPresentation(cust); startCustomerTrafficPopup(cust.id); });
      marker.on('popupclose', () => stopCustomerTrafficPopup(cust.id));

      customerMap[cust.id] = {
        marker,
        data: cust,
        polyline
      };
    }
  });


  // 3. Render backbone topology devices
  const topologyMap = { router: {}, olt: {}, odc: {} };
  const topologyLayer = L.layerGroup().addTo(map);
  const topologyLines = [];

  function makeTopologyIcon(type, name) {
    const cfg = {
      router: { bg: '#7c3aed', icon: 'bi-router-fill', prefix: 'ROUTER · ' },
      olt: { bg: '#2563eb', icon: 'bi-hdd-rack-fill', prefix: 'OLT · ' },
      odc: { bg: '#0891b2', icon: 'bi-boxes', prefix: 'ODC · ' }
    }[type] || { bg: '#475569', icon: 'bi-hdd-fill', prefix: '' };
    return L.divIcon({
      className: 'custom-onu-icon',
      html: '<div style="display:flex;flex-direction:column;align-items:center;">' +
        '<div class="topology-device-icon" style="background:' + cfg.bg + '"><i class="bi ' + cfg.icon + '"></i></div>' +
        '<div class="topology-device-label">' + escapeHtml(cfg.prefix + String(name || '')) + '</div>' +
        '</div>',
      iconSize: [170, 55],
      iconAnchor: [85, 15],
      popupAnchor: [0, -10]
    });
  }

  odcs.forEach(d => {
    const lat = Number(d.lat), lng = Number(d.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng) || lat === 0 || lng === 0) return;
    const marker = L.marker([lat, lng], { icon: makeTopologyIcon('odc', d.name || ('ODC #' + d.id)) }).addTo(topologyLayer);
    const odcOltId = d.olt_id ? Number(d.olt_id) : (olts.length === 1 ? Number(olts[0].id) : null);
    const cableButton = odcOltId ? '<button type="button" class="btn btn-sm btn-outline-primary" onclick="openBackboneCableEditor(\'odc-olt\',' + Number(d.id) + ',' + odcOltId + ')"><i class="bi bi-bezier2"></i> Edit Jalur ODC–OLT</button>' : '';
    marker.bindPopup('<div class="topology-popup"><h6><i class="bi bi-boxes" style="color:#0891b2"></i> ' + escapeHtml(d.name || ('ODC #' + d.id)) + '</h6><div class="tp-meta">Kode: <strong>' + escapeHtml(d.code || '-') + '</strong></div><div class="tp-meta">OLT: <strong>' + escapeHtml(d.olt_name || '-') + '</strong></div><div class="tp-meta">Lokasi: ' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '</div><div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap"><button type="button" class="btn btn-sm btn-p" onclick="editOdc(' + Number(d.id) + ')"><i class="bi bi-pencil"></i> Edit ODC</button>' + cableButton + '</div></div>');
    topologyMap.odc[d.id] = { marker: marker, coord: [lat, lng], data: d };
  });

  routers.forEach(r => {
    if (!Number.isFinite(Number(r.lat)) || !Number.isFinite(Number(r.lng))) return;
    const marker = L.marker([Number(r.lat), Number(r.lng)], { icon: makeTopologyIcon('router', r.name) }).addTo(topologyLayer);
    marker.bindPopup('<div class="topology-popup"><h6><i class="bi bi-hdd-network-fill" style="color:#7c3aed"></i> ' + escapeHtml(r.name) + '</h6><div class="tp-meta">MikroTik / Router</div><div class="tp-meta">IP: <strong>' + escapeHtml(r.host || '-') + '</strong></div><div class="tp-meta">Status: <strong>' + (r.is_active ? 'Aktif' : 'Nonaktif') + '</strong></div>' + (r.virtual_position ? '<div class="tp-meta" style="color:#b45309">Posisi peta otomatis</div>' : '') + '<div style="margin-top:10px"><button type="button" class="btn btn-sm btn-p" onclick="editTopologyRouterLocation(' + r.id + ')"><i class="bi bi-geo-alt"></i> Edit Titik Lokasi</button></div></div>');
    topologyMap.router[r.id] = { marker: marker, coord: [Number(r.lat), Number(r.lng)], data: r };
  });

  olts.forEach(o => {
    if (!Number.isFinite(Number(o.lat)) || !Number.isFinite(Number(o.lng))) return;
    const marker = L.marker([Number(o.lat), Number(o.lng)], { icon: makeTopologyIcon('olt', o.name) }).addTo(topologyLayer);
    marker.bindPopup('<div class="topology-popup"><h6><i class="bi bi-diagram-3-fill" style="color:#2563eb"></i> ' + escapeHtml(o.name) + '</h6><div class="tp-meta">OLT ' + escapeHtml(o.brand || '') + '</div><div class="tp-meta">IP: <strong>' + escapeHtml(o.host || '-') + '</strong></div><div class="tp-meta">Port PON fisik: <strong>' + (Number(o.pon_port_count) > 0 ? Number(o.pon_port_count) + ' port' : 'Belum diatur') + '</strong></div><div class="tp-meta">Status: <strong>' + (o.is_active ? 'Aktif' : 'Nonaktif') + '</strong></div>' + (o.virtual_position ? '<div class="tp-meta" style="color:#b45309">Posisi peta otomatis dari ODP</div>' : '') + '<div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap"><button type="button" class="btn btn-sm btn-p" onclick="editTopologyOltLocation(' + o.id + ')"><i class="bi bi-geo-alt"></i> Edit Titik Lokasi</button>' + (routers.length === 1 ? '<button type="button" class="btn btn-sm btn-outline-primary" onclick="openBackboneCableEditor(\'olt-router\',' + o.id + ',' + routers[0].id + ')"><i class="bi bi-bezier2"></i> Edit Jalur ke MikroTik</button>' : '') + '</div></div>');
    topologyMap.olt[o.id] = { marker: marker, coord: [Number(o.lat), Number(o.lng)], data: o };
  });

  function topologyCoord(link) {
    if (link.source_type === 'router' && topologyMap.router[link.source_id]) return topologyMap.router[link.source_id].coord;
    if (link.source_type === 'olt' && topologyMap.olt[link.source_id]) return topologyMap.olt[link.source_id].coord;
    if (link.source_type === 'odc' && topologyMap.odc[link.source_id]) return topologyMap.odc[link.source_id].coord;
    if (link.source_type === 'odp' && odpMap[link.source_id]) return odpMap[link.source_id].coord;
    if (link.source_type === 'customer' && customerMap[link.source_id] && customerMap[link.source_id].data) {
      const c = customerMap[link.source_id].data;
      if (c.lat && c.lng) return [Number(c.lat), Number(c.lng)];
    }
    return null;
  }

  function drawTopologyLinks() {
    topologyLines.forEach(line => map.removeLayer(line));
    topologyLines.length = 0;
    topologyLinks.forEach(link => {
      // Customer-to-ODP is already rendered with the saved cable_path above.
      // Skip this second straight overlay so the drawn path and its animation stay accurate.
      if (link.segment_type === 'odp-customer') return;
      const a = topologyCoord(link.source_type ? link : { source_type: link.source_type, source_id: link.source_id });
      const b = (link.target_type === 'router' && topologyMap.router[link.target_id]) ? topologyMap.router[link.target_id].coord :
        (link.target_type === 'olt' && topologyMap.olt[link.target_id]) ? topologyMap.olt[link.target_id].coord :
        (link.target_type === 'odc' && topologyMap.odc[link.target_id]) ? topologyMap.odc[link.target_id].coord :
        (link.target_type === 'odp' && odpMap[link.target_id]) ? odpMap[link.target_id].coord :
        (link.target_type === 'customer' && customerMap[link.target_id] && customerMap[link.target_id].data && customerMap[link.target_id].data.lat && customerMap[link.target_id].data.lng) ? [Number(customerMap[link.target_id].data.lat), Number(customerMap[link.target_id].data.lng)] : null;
      if (!a || !b) return;
      const isCustomer = link.segment_type === 'odp-customer' || link.target_type === 'customer';
      const isOdpOdc = link.segment_type === 'odp-odc';
      const isOdcOlt = link.segment_type === 'odc-olt';
      const isOltRouter = link.segment_type === 'olt-router';
      const manualPath = Array.isArray(link.manual_path) && link.manual_path.length >= 2 ? link.manual_path.map(p => [Number(p[0]), Number(p[1])]) : null;
      const points = manualPath || [a, b];
      const baseLineColor = isCustomer ? '#2563eb' : (isOdpOdc ? '#f59e0b' : (isOdcOlt ? '#06b6d4' : '#7c3aed'));
      const lineColor = link.status === 'inactive' ? '#ef4444' : baseLineColor;
      const line = L.polyline(points, {
        color: lineColor,
        weight: isCustomer ? 2 : 5,
        opacity: isCustomer ? 0.55 : 0.9,
        dashArray: link.status === 'inactive' ? '8,8' : '14,8',
        className: 'topology-link' + (link.status === 'inactive' ? '' : ' topology-link-flow'),
        bubblingMouseEvents: false
      }).addTo(map);
      const statusLabel = link.status === 'active' ? 'Normal (status manual)' : (link.status === 'inactive' ? 'PUTUS / TIDAK AKTIF (status manual)' : 'BELUM DICEK FISIK');
      const segmentLabel = isCustomer ? 'Pelanggan → ODP' : (isOdpOdc ? 'ODP → ODC' : (isOdcOlt ? 'ODC → OLT' : 'OLT → MikroTik'));
      const baseTooltip = segmentLabel + ' • ' + statusLabel + (isCustomer ? '' : ' • Klik untuk edit jalur');
      link._leafletLine = line;
      link._baseColor = baseLineColor;
      link._manualInactive = link.status === 'inactive';
      link._baseTooltip = baseTooltip;
      line.bindTooltip(baseTooltip, { sticky: true });
      if (!isCustomer && (isOdpOdc || isOdcOlt || isOltRouter)) {
        // Jalur backbone dibuat langsung bisa di-tap, sama mudahnya seperti edit jalur Pelanggan → ODP.
        line.bringToFront();
        line.on('click', function(e) {
          L.DomEvent.stopPropagation(e);
          openBackboneCableEditor(link.segment_type, Number(link.source_id), Number(link.target_id));
        });
        line.bindPopup('<div style="min-width:220px"><strong>' + segmentLabel + '</strong><div style="margin-top:5px;color:' + lineColor + ';font-weight:800;">' + statusLabel + '</div><div style="font-size:11px;color:#64748b;margin-top:4px;">Tap garis kabel untuk langsung mengedit jalurnya.</div><div style="margin-top:9px"><button type="button" class="btn btn-sm btn-p" onclick="openBackboneCableEditor(' + JSON.stringify(link.segment_type) + ',' + Number(link.source_id) + ',' + Number(link.target_id) + ')"><i class="bi bi-pencil-fill"></i> Edit Jalur Kabel</button></div></div>');
      }
      topologyLines.push(line);
    });
  }

  drawTopologyLinks();

  let topologyStatusRefreshInFlight = false;
  async function refreshTopologyLiveStatus() {
    if (topologyStatusRefreshInFlight) return;
    topologyStatusRefreshInFlight = true;
    const statusLabel = document.getElementById('topologyLiveStatus');
    try {
      const response = await fetch('/admin/api/map/link-status', { cache: 'no-store' });
      const payload = await response.json();
      if (!response.ok || !payload || !payload.ok) throw new Error('status tidak tersedia');

      const statusBySerial = new Map((Array.isArray(payload.olt_statuses) ? payload.olt_statuses : [])
        .map(row => [String(row.serial_key || String(row.serial_number || '').replace(/[^A-Z0-9]/gi, '')).toUpperCase(), row]));
      const inventoryChecked = Boolean(payload.olt_status_checked_at);
      Object.values(customerMap).forEach(entry => {
        if (!entry || !entry.data) return;
        const cust = entry.data;
        const sn = String(cust.onu_sn || '').trim();
        const key = sn.replace(/[^A-Z0-9]/gi, '').toUpperCase();
        const row = key ? statusBySerial.get(key) : null;
        if (row) {
          cust.onu_olt_status = String(row.status || 'Unknown').toLowerCase();
          cust.onu_olt_status_label = row.status === 'Online' ? 'ONLINE di OLT' : (row.status === 'Offline' ? 'OFFLINE di OLT' : 'Status OLT belum pasti');
          cust.onu_olt_reason = row.status === 'Offline'
            ? (String(row.offline_reason || '').trim() || 'OLT tidak mengirim penyebab spesifik. Periksa alarm LOS/RX optik dan daya ONT.')
            : '';
          cust.onu_olt_checked_at = row.checked_at || '';
          cust.onu_olt_pon_id = row.pon_id == null ? null : Number(row.pon_id);
          cust.onu_olt_onu_id = row.onu_id == null ? null : Number(row.onu_id);
          cust.onu_olt_name = row.olt_name || '';
          cust.onu_olt_rx = String(row.rx != null ? row.rx : (cust.onu_olt_rx || ''));
          cust.onu_olt_tx = String(row.tx != null ? row.tx : (cust.onu_olt_tx || ''));
          cust.onu_olt_optical_checked_at = String(row.optical_checked_at || cust.onu_olt_optical_checked_at || '');
        } else {
          cust.onu_olt_status = 'unknown';
          cust.onu_olt_status_label = cust.onu_sn_match_status === 'ambiguous'
            ? 'SN belum pasti'
            : (sn ? (inventoryChecked ? 'SN tidak ditemukan di inventaris OLT' : 'Menunggu pembacaan status OLT') : 'SN belum tersedia');
          cust.onu_olt_reason = cust.onu_sn_match_status === 'ambiguous'
            ? 'Username PPPoE cocok ke lebih dari satu serial ACS; perlu verifikasi SN.'
            : (sn && inventoryChecked ? 'SN tidak ada pada hasil inventaris OLT terakhir. Ini belum membuktikan ONT mati.' : '');
          cust.onu_olt_pon_id = null;
          cust.onu_olt_onu_id = null;
          cust.onu_olt_name = '';
        }
        syncAdminCustomerOltPresentation(cust);
      });

      Object.entries(payload.customers || {}).forEach(([customerId, item]) => {
        const entry = customerMap[customerId];
        if (!entry) return;
        const state = item && ['online','offline','unknown','isolated'].includes(item.state) ? item.state : 'unknown';
        entry.livePppoeState = state;
        entry.data.pppoe_state = item && ['online','offline','unknown'].includes(item.pppoeState) ? item.pppoeState : 'unknown';
        syncAdminCustomerOltPresentation(entry.data);
        if (state === 'isolated') {
          if (entry.polyline) { map.removeLayer(entry.polyline); entry.polyline = null; }
          return;
        }
        if (!entry.polyline) entry.polyline = ensureCustomerPolyline(entry.data);
        if (!entry.polyline) return;
        const color = state === 'offline' ? '#ef4444' : (state === 'online' ? '#2563eb' : '#f59e0b');
        const description = state === 'offline' ? 'PPPoE OFFLINE — jalur pelanggan ditandai merah' : (state === 'online' ? 'PPPoE ONLINE' : 'Status PPPoE tidak diketahui; MikroTik mungkin tidak terjangkau atau akun belum dipetakan');
        entry.polyline.setStyle({ color, dashArray: state === 'offline' ? '8,6' : '10,10', opacity: 0.95 });
        if (entry.polyline.getTooltip()) entry.polyline.setTooltipContent('Pelanggan → ODP • ' + description);
      });

      if (statusLabel) statusLabel.textContent = 'Status PPPoE diperiksa pukul ' + new Date(payload.checkedAt || Date.now()).toLocaleTimeString('id-ID') + ' • diperbarui otomatis tiap 20 detik';

      topologyLinks.forEach(link => {
        const line = link._leafletLine;
        if (!line) return;
        if (link.segment_type !== 'odp-odc') {
          if (link._manualInactive) line.setStyle({ color: '#ef4444', dashArray: '8,8' });
          else line.setStyle({ color: link._baseColor, dashArray: '14,8' });
          if (line.getTooltip()) line.setTooltipContent(link._baseTooltip);
          return;
        }
        const summary = (payload.odps || {})[String(link.source_id)];
        const hasOnlineCustomer = summary && Number(summary.onlineCount) > 0;
        const allMappedConfirmedOffline = summary && Number(summary.offlineCount) > 0 && Number(summary.onlineCount) === 0 && Number(summary.unknownCount) === 0;
        if (hasOnlineCustomer) {
          line.setStyle({ color: link._baseColor, dashArray: '14,8', opacity: 0.9 });
          if (line.getTooltip()) line.setTooltipContent('ODP → ODC • AMAN: ada pelanggan masih ONLINE; jalur ini tidak ditandai merah.');
        } else if (link._manualInactive) {
          line.setStyle({ color: '#ef4444', dashArray: '8,8' });
          if (line.getTooltip()) line.setTooltipContent(link._baseTooltip + ' • belum ada pelanggan online pada ODP ini');
        } else if (allMappedConfirmedOffline) {
          line.setStyle({ color: '#ef4444', dashArray: '8,6', opacity: 1 });
          if (line.getTooltip()) line.setTooltipContent('ODP → ODC • MERAH: semua pelanggan non-isolir yang terpetakan terkonfirmasi offline. Alarm jaringan, bukan bukti pasti kabel FO putus.');
        } else {
          line.setStyle({ color: link._baseColor, dashArray: '14,8', opacity: 0.9 });
          let note = 'status PPPoE belum lengkap / belum terverifikasi';
          if (summary && Number(summary.totalCount) > 0 && Number(summary.unknownCount) === 0 && Number(summary.offlineCount) === 0) note = 'tidak ada pelanggan non-isolir yang terkonfirmasi offline; kabel fisik belum dipantau';
          if (line.getTooltip()) line.setTooltipContent('ODP → ODC • ' + note);
        }
      });
      if (statusLabel) statusLabel.textContent = 'Status PPPoE diperiksa ' + new Date(payload.checkedAt || Date.now()).toLocaleTimeString('id-ID') + ' • pembaruan tiap 20 detik';
    } catch (_) {
      if (statusLabel) statusLabel.textContent = 'Status PPPoE belum dapat diperiksa; garis dipertahankan dan tidak dianggap offline.';
    } finally {
      topologyStatusRefreshInFlight = false;
    }
  }
  refreshTopologyLiveStatus();
  setInterval(refreshTopologyLiveStatus, 20000);

  // ─── SEARCH & AUTOCOMPLETE LOGIC ──────────────────────────────────────────
  const searchInput = document.getElementById('mapGlobalSearch');
  const searchDropdown = document.getElementById('mapSearchDropdown');
  const resultsList = document.getElementById('msResultsList');
  const resultsCount = document.getElementById('msHeaderCount');
  const clearBtn = document.getElementById('mapSearchClearBtn');
  let selectedSearchIndex = -1;
  let currentSearchResults = [];

  function highlightMatch(text, query) {
    if (!text) return '';
    if (!query) return escapeHtml(text);
    const escaped = escapeHtml(text);
    const qEsc = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${qEsc})`, 'gi');
    return escaped.replace(regex, '<mark>$1</mark>');
  }

  function doMapSearch(query) {
    const q = (query || '').trim().toLowerCase();
    if (!q) {
      searchDropdown.classList.remove('active');
      clearBtn.style.display = 'none';
      currentSearchResults = [];
      selectedSearchIndex = -1;
      return;
    }

    clearBtn.style.display = 'block';

    const matchedCustomers = customers.filter(c => {
      return (
        String(c.name || '').toLowerCase().includes(q) ||
        String(c.pppoe_username || '').toLowerCase().includes(q) ||
        String(c.phone || '').toLowerCase().includes(q) ||
        String(c.genieacs_tag || '').toLowerCase().includes(q) ||
        String(c.onu_sn || '').toLowerCase().includes(q) ||
        String(c.address || '').toLowerCase().includes(q) ||
        String(c.area || '').toLowerCase().includes(q) ||
        String(c.package_name || '').toLowerCase().includes(q) ||
        String(c.odp_name || '').toLowerCase().includes(q)
      );
    });

    const matchedOdps = odps.filter(o => {
      return (
        String(o.name || '').toLowerCase().includes(q) ||
        String(o.description || '').toLowerCase().includes(q)
      );
    });

    const matchedOdcs = odcs.filter(d => String(d.name || '').toLowerCase().includes(q) || String(d.code || '').toLowerCase().includes(q) || String(d.olt_name || '').toLowerCase().includes(q) || String(d.description || '').toLowerCase().includes(q));

    const matchedRouters = routers.filter(r => {
      return (
        String(r.name || '').toLowerCase().includes(q) ||
        String(r.host || '').toLowerCase().includes(q) ||
        String(r.description || '').toLowerCase().includes(q)
      );
    });

    const matchedOlts = olts.filter(o => {
      return (
        String(o.name || '').toLowerCase().includes(q) ||
        String(o.host || '').toLowerCase().includes(q) ||
        String(o.brand || '').toLowerCase().includes(q)
      );
    });

    currentSearchResults = [
      ...matchedCustomers.map(c => ({ type: 'customer', data: c })),
      ...matchedOdps.map(o => ({ type: 'odp', data: o })),
      ...matchedOdcs.map(d => ({ type: 'odc', data: d })),
      ...matchedRouters.map(r => ({ type: 'router', data: r })),
      ...matchedOlts.map(o => ({ type: 'olt', data: o }))
    ];

    selectedSearchIndex = -1;
    resultsCount.textContent = `${currentSearchResults.length} Ditemukan`;

    if (currentSearchResults.length === 0) {
      resultsList.innerHTML = `
        <div class="ms-empty">
          <i class="bi bi-search" style="font-size: 24px; color: #cbd5e1; display: block; margin-bottom: 6px;"></i>
          Tidak ditemukan data untuk "<strong>${escapeHtml(query)}</strong>"
        </div>
      `;
    } else {
      let html = '';
      currentSearchResults.slice(0, 30).forEach((item, index) => {
        if (item.type === 'customer') {
          const c = item.data;
          const isActive = c.status === 'active';
          const hasGps = Boolean(c.lat && c.lng);
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon ${isActive ? 'active' : 'suspended'}">
                <i class="bi bi-router-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(c.name, query)}</span>
                  ${!hasGps ? '<span style="color:#ef4444; font-size:10px; font-weight:700;"><i class="bi bi-exclamation-triangle"></i> Tanpa GPS</span>' : ''}
                </div>
                <div class="ms-item-meta">
                  ${c.pppoe_username ? `<span>PPPoE: ${highlightMatch(c.pppoe_username, query)}</span> • ` : ''}
                  ${c.phone ? `<span>HP: ${highlightMatch(c.phone, query)}</span> • ` : ''}
                  ${c.odp_name ? `<span>ODP: ${highlightMatch(c.odp_name, query)}</span> • ` : ''}
                  <span>${escapeHtml(c.address || c.package_name || '-')}</span>
                </div>
              </div>
              <span class="ms-item-badge ${isActive ? 'ms-badge-active' : 'ms-badge-suspended'}">
                ${isActive ? 'Aktif' : 'Isolir'}
              </span>
            </div>
          `;
