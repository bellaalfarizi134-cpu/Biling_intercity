  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // PWA Prompt Handler
    let deferredPwaPrompt = null;

    function openPwaInstallPopup() {
    const el = document.getElementById('pwaDownloadModal');
    if (el && window.bootstrap) bootstrap.Modal.getOrCreateInstance(el).show();
  }

  window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;

      // Show floating banner if not dismissed before
      if (!localStorage.getItem('pwa_banner_dismissed')) {
        const banner = document.getElementById('pwa-install-banner');
        if (banner) banner.style.display = 'block';
      }

      // Highlight install buttons
      const navBtn = document.getElementById('btn-install-pwa-nav');
      const heroBtn = document.getElementById('btn-install-pwa-hero');
      if (navBtn) navBtn.classList.add('shadow-lg');
      if (heroBtn) heroBtn.classList.add('shadow-lg');
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
          }
          deferredPwaPrompt = null;
        });
      } else {
        const modalEl = document.getElementById('pwaInstallModal');
        if (modalEl) {
          const bsModal = new bootstrap.Modal(modalEl);
          bsModal.show();
        }
      }
    }

    function triggerPwaInstallDirect() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
            const modalEl = document.getElementById('pwaInstallModal');
            if (modalEl) {
              const instance = bootstrap.Modal.getInstance(modalEl);
              if (instance) instance.hide();
            }
          }
          deferredPwaPrompt = null;
        });
      }
    }

    function dismissPwaBanner() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'none';
      localStorage.setItem('pwa_banner_dismissed', 'true');
    }

    window.addEventListener('appinstalled', () => {
      dismissPwaBanner();
      deferredPwaPrompt = null;
    });

    // Defer service worker registration
    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      }, 1500);
    }

    // Auto-focus input on page load if user is near top
    window.addEventListener('load', () => {
      if (window.scrollY < 400) {
        const phoneInput = document.getElementById('phone');
        if (phoneInput && !('ontouchstart' in window)) {
          phoneInput.focus();
        }
      }
    });

    // Highlight active nav item on scroll
    const sections = document.querySelectorAll('section[id], header[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop - 100;
        if (pageYOffset >= sectionTop) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });

    // Detail paket: tampilkan informasi lengkap sebelum pelanggan melanjutkan pendaftaran.
    document.querySelectorAll('.pkg-select-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.name || 'Paket Layanan';
        const speed = btn.dataset.speed || 'High-Speed';
        const price = btn.dataset.price || 'Rp 0';
        const description = btn.dataset.description || '';
        const url = btn.dataset.url || '/customer/register';
        const isFull = btn.dataset.full === '1';
        const title = document.getElementById('packageDetailTitle');
        const speedEl = document.getElementById('packageDetailSpeed');
        const priceEl = document.getElementById('packageDetailPrice');
        const descEl = document.getElementById('packageDetailDescription');
        const continueEl = document.getElementById('packageDetailContinue');
        if (title) title.textContent = name;
        if (speedEl) speedEl.textContent = speed;
        if (priceEl) priceEl.textContent = price;
        const fullAlert = document.getElementById('packageFullAlert');
        const backBtn = document.getElementById('packageBackButton');
        const continueText = continueEl ? continueEl.querySelector('span') : null;
        if (continueEl) { continueEl.href = url; continueEl.style.display = isFull ? 'none' : 'block'; }
        if (backBtn) backBtn.style.display = isFull ? 'block' : 'none';
        if (fullAlert) fullAlert.classList.toggle('d-none', !isFull);
        if (continueText) continueText.textContent = 'Lanjut Pilih & Daftar Paket';
        if (descEl) {
          const span = descEl.querySelector('span');
          if (description) { descEl.style.display = 'flex'; if (span) span.textContent = description; }
          else { descEl.style.display = 'none'; }
        }
      });
    });

  </script>
</body>

