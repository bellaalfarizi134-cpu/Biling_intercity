        resultBox.textContent = 'Pilih OLT HSGQ terlebih dahulu.';
        return;
      }
      button.disabled = true;
      submitButton.disabled = true;
      ponInput.value = '';
      idInput.value = '';
      const manuallyEnteredSn = String(snInput.value || '').trim().toUpperCase();
      snInput.dataset.scanSelected = '0';
