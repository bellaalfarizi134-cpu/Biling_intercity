<%- include('partials/header') %>
<script>document.body.classList.add('tech-dashboard');</script>

<a href="/tech/guide" class="isp-guide-top" aria-label="Buka Panduan"><i class="bi bi-journal-text"></i><span>Panduan</span></a>
<button type="button" class="isp-tech-identity" aria-label="Buka profil teknisi" data-bs-toggle="modal" data-bs-target="#techProfileModal">
  <span class="isp-tech-avatar"><%= String((typeof techProfile !== 'undefined' && techProfile.name) || techName || 'T').trim().charAt(0).toUpperCase() %></span>
  <span class="isp-tech-details"><strong><%= (typeof techProfile !== 'undefined' && techProfile.name) || techName || 'Teknisi' %></strong><small>ID Teknisi #<%= (typeof techProfile !== 'undefined' && techProfile.id) || '' %></small></span>
  <span class="isp-tech-active"><i></i> Aktif</span>
</button>

<div class="modal fade" id="techProfileModal" tabindex="-1" aria-labelledby="techProfileTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content tech-profile-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="techProfileTitle"><i class="bi bi-person-badge me-2"></i>Profil Teknisi</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body">
        <div class="tech-profile-hero"><span class="isp-tech-avatar"><%= String((typeof techProfile !== 'undefined' && techProfile.name) || techName || 'T').trim().charAt(0).toUpperCase() %></span><strong><%= (typeof techProfile !== 'undefined' && techProfile.name) || techName || 'Teknisi' %></strong><small><%= (typeof techProfile !== 'undefined' && techProfile.username) || '-' %></small></div>
        <div class="tech-profile-row"><span>ID Teknisi</span><strong><%= (typeof techProfile !== 'undefined' && techProfile.id) || '-' %></strong></div>
        <div class="tech-profile-row"><span>Nama lengkap</span><strong><%= (typeof techProfile !== 'undefined' && techProfile.name) || techName || '-' %></strong></div>
        <div class="tech-profile-row"><span>Username</span><strong><%= (typeof techProfile !== 'undefined' && techProfile.username) || '-' %></strong></div>
        <div class="tech-profile-row"><span>Nomor telepon</span><strong><%= (typeof techProfile !== 'undefined' && techProfile.phone) || '-' %></strong></div>
        <div class="tech-profile-row"><span>Wilayah kerja</span><strong><%= (typeof techProfile !== 'undefined' && techProfile.area) || '-' %></strong></div>
        <div class="tech-profile-row"><span>Status akun</span><strong><%= (typeof techProfile !== 'undefined' && Number(techProfile.is_active) === 1) ? 'Aktif' : 'Tidak aktif / belum tersedia' %></strong></div>
        <div class="tech-profile-row"><span>Terdaftar sejak</span><strong><%= (typeof techProfile !== 'undefined' && techProfile.created_at) || '-' %></strong></div>
      </div>
      <div class="modal-footer"><a href="/tech/logout" class="btn btn-danger w-100" onclick="return confirm('Keluar dari akun teknisi?')"><i class="bi bi-box-arrow-right me-2"></i>Keluar</a></div>
    </div>
  </div>
</div>

<section class="isp-tabs" aria-label="Kategori pekerjaan">
  <a href="/tech/binding-only" class="isp-tab"><i class="bi bi-router-fill"></i><span>Binding</span></a>
  <a href="/tech/provisioning" class="isp-tab"><i class="bi bi-hdd-network-fill"></i><span>Antrean Binding ONT</span><% if (Number(provisioningCount || 0) > 0) { %><span class="badge text-bg-light text-primary"><%= provisioningCount %></span><% } %></a>
  <a href="/tech/pool" class="isp-tab"><i class="bi bi-clipboard2-check"></i><span>Tiket</span></a>
</section>

<% if (Array.isArray(tickets) && tickets.length > 0) { %>
<section class="isp-tasks-panel" aria-labelledby="tasksInProgressTitle">
  <div class="isp-tasks-heading">
    <div>
      <h3 id="tasksInProgressTitle"><i class="bi bi-clipboard2-check me-2"></i>Tugas Aktif</h3>
      <p>Tiket yang Anda ambil akan tampil di halaman ini.</p>
    </div>
    <div class="isp-tasks-heading-actions">
      <span class="isp-tasks-count"><%= Array.isArray(tickets) ? tickets.length : 0 %></span>
      <button type="button" class="isp-tasks-dismiss" id="ispTasksDismiss" aria-expanded="true" aria-controls="ispTasksBody" title="Sembunyikan panel tugas">×</button>
    </div>
  </div>
  <div id="ispTasksBody">
  <% if (!Array.isArray(tickets) || tickets.length === 0) { %>
    <div class="isp-tasks-empty"><i class="bi bi-inbox"></i><strong>Belum ada tugas aktif</strong><span>Tiket yang Anda ambil akan tampil di sini.</span><a href="/tech/pool" class="btn btn-primary btn-sm mt-2">Lihat Tiket</a></div>
  <% } else { %>
    <div class="isp-task-list">
      <% tickets.forEach(ticket => { %>
        <article class="isp-task-card">
          <div class="isp-task-topline">
            <span class="isp-task-status <%= ticket.status === 'in_progress' ? 'working' : 'other' %>"><i class="bi bi-tools me-1"></i><%= ticket.status === 'in_progress' ? 'Sedang Dikerjakan' : ticket.status %></span>
            <span class="isp-task-time"><i class="bi bi-clock me-1"></i><%= ticket.taken_at ? formatDateLocal(ticket.taken_at) + ' ' + formatTimeLocal(ticket.taken_at) : 'Waktu pengambilan belum tercatat' %></span>
          </div>
          <h4><%= ticket.subject || 'Tugas teknisi' %></h4>
          <p class="isp-task-customer"><i class="bi bi-person-fill me-1"></i><%= ticket.customer_name || 'Pelanggan' %></p>
          <p class="isp-task-address"><i class="bi bi-geo-alt-fill me-1"></i><%= ticket.customer_address || 'Alamat tidak tersedia' %></p>
          <p class="isp-task-message"><%= ticket.message || '' %></p>
          <div class="isp-task-footer"><span><i class="bi bi-person-check me-1"></i><%= ticket.technician_name || techName || 'Teknisi' %></span>
            <% if (ticket.status === 'in_progress') { %>
              <form method="POST" action="/tech/tickets/<%= ticket.id %>/close" class="isp-task-close-form" onsubmit="return confirm('Tandai tugas ini selesai?');">
                <button type="submit" class="isp-task-close-btn" aria-label="Tutup tugas">Tutup</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
  </div>
</section>
<% } %>

<style>
  body.tech-dashboard, body.tech-dashboard html { background:#f4f7fc; color:#172b4d; }
  body.tech-dashboard { padding-top:env(safe-area-inset-top); padding-bottom:calc(78px + env(safe-area-inset-bottom)); background-color:#f4f7fc; background-image:linear-gradient(rgba(244,247,252,.78),rgba(244,247,252,.78)),url('https://png.pngtree.com/png-vector/20240320/ourmid/pngtree-coding-clipart-guy-in-glasses-computer-tech-cartoon-vector-illustration-png-image_11957889.png'); background-repeat:no-repeat,no-repeat; background-position:center center,center center; background-size:100% 100%,min(88vw,420px) auto; background-attachment:fixed,fixed; color:#172b4d; }
  body.tech-dashboard .isp-guide-top { position:absolute; top:calc(env(safe-area-inset-top) + 10px); right:16px; z-index:1050; display:inline-flex; align-items:center; gap:6px; padding:8px 11px; border:1px solid #d8e5f8; border-radius:11px; background:#fff; color:#1554ad; text-decoration:none; font-size:12px; font-weight:800; box-shadow:0 3px 10px rgba(25,57,98,.07); }
  body.tech-dashboard .isp-guide-top i { font-size:16px; }
